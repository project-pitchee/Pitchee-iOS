    "recording.error.realtimePitchUnavailable" : {
      "comment" : "Non-fatal recording-phase warning: realtime F0 failed but audio is still captured; delivered through the shared errorMessage channel.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "طبقة الصوت المباشرة غير متاحة مؤقتًا. سيستمر التسجيل وستحصل على تحليل كامل عند الإيقاف."
