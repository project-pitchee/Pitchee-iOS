    "analysis.suggestions.shortRecording.description": {
      "comment": "Longer body text in the suggestion sheet; explains how to record differently next time.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حاول التحدث بجمل طبيعية بشكل متواصل لمدة 10 ثوانٍ أو أكثر. التسجيل الأكمل يعطي تقديرات أكثر استقرارًا لطبقة الصوت والطبيعية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zkuste souvisle mluvit přirozené věty 10 sekund nebo déle. Ucelenější nahrávka přináší stabilnější odhady výšky hlasu i přirozenosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prøv at sige naturlige sætninger sammenhængende i 10 sekunder eller mere. En mere komplet optagelse giver mere stabile estimater af tonehøjde og naturlighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprich mindestens 10 Sekunden lang zusammenhängende, natürliche Sätze. Eine vollständigere Aufnahme liefert stabilere Werte für Tonhöhe und Natürlichkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δοκιμάστε να μιλάτε συνεχόμενα με φυσικές προτάσεις για 10 δευτερόλεπτα ή περισσότερο. Μια πιο ολοκληρωμένη ηχογράφηση δίνει πιο σταθερές εκτιμήσεις ύψους και φυσικότητας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try speaking natural sentences continuously for 10 seconds or more. A more complete recording gives more stable pitch and naturalness estimates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Intenta decir frases naturales de forma continua durante 10 segundos o más. Una grabación más completa da estimaciones de tono y naturalidad más estables."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yritä puhua luonnollisia lauseita yhtäjaksoisesti vähintään 10 sekuntia. Kattavampi tallennus antaa vakaammat sävelkorkeuden ja luonnollisuuden arviot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essayez de dire des phrases naturelles en continu pendant 10 secondes ou plus. Un enregistrement plus complet donne des estimations de hauteur et de naturel plus stables."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "נסו לדבר ברצף משפטים טבעיים במשך 10 שניות או יותר. הקלטה מלאה יותר מאפשרת הערכה יציבה יותר של טון וטבעיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 सेकंड या ज़्यादा देर तक लगातार स्वाभाविक वाक्य बोलें। पूरी रिकॉर्डिंग से पिच और स्वाभाविकता का अनुमान ज़्यादा स्थिर मिलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokušaj neprekinuto govoriti prirodne rečenice 10 sekundi ili dulje. Potpunija snimka daje stabilnije procjene visine i prirodnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Próbálj legalább 10 másodpercig egyfolytában természetes mondatokat mondani. A teljesebb felvétel stabilabb hangmagasság- és természetességbecslést ad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coba ucapkan kalimat alami secara terus-menerus selama 10 detik atau lebih. Rekaman yang lebih utuh menghasilkan perkiraan nada dan kealamian yang lebih stabil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prova a dire frasi naturali di seguito per 10 secondi o più. Una registrazione più completa rende le stime di tono e naturalezza più stabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10秒以上の自然な文を続けて話してみましょう。録音が長いほど、音高と自然度の推定が安定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자연스러운 문장을 10초 이상 이어서 말해 보세요. 녹음이 더 온전할수록 음높이와 자연스러움 추정이 안정돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuba sebut ayat semula jadi secara berterusan selama 10 saat atau lebih. Rakaman yang lebih lengkap memberikan anggaran pic dan kewajaran yang lebih stabil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Probeer minstens 10 seconden doorlopend natuurlijke zinnen te spreken. Een volledigere opname geeft stabielere schattingen van toonhoogte en natuurlijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spróbuj mówić naturalnymi zdaniami bez przerwy przez co najmniej 10 sekund. Pełniejsze nagranie daje stabilniejsze oszacowanie wysokości głosu i naturalności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tente falar frases naturais sem parar por 10 segundos ou mais. Uma gravação mais completa deixa as estimativas de altura e naturalidade mais estáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Постарайтесь непрерывно говорить естественными фразами 10 секунд или дольше. Чем полнее запись, тем стабильнее оценка высоты тона и естественности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Försök prata naturliga meningar sammanhängande i 10 sekunder eller mer. En mer komplett inspelning ger stabilare skattningar av tonhöjd och naturlighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลองพูดประโยคธรรมชาติต่อเนื่องกัน 10 วินาทีขึ้นไป การบันทึกที่ครบถ้วนขึ้นจะช่วยให้ค่าประมาณระดับเสียงและความเป็นธรรมชาตินิ่งขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "10 saniyeden uzun doğal cümlelerle kesintisiz konuşmayı dene. Kayıt daha eksiksiz oldukça perde ve doğallık tahminleri daha tutarlı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спробуйте безперервно вимовляти природні речення 10 секунд або довше. Повніший запис дає стабільніші оцінки висоти тону й природності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy thử nói liên tục những câu tự nhiên trong 10 giây trở lên. Bản ghi đầy đủ hơn sẽ cho kết quả ước lượng cao độ và độ tự nhiên ổn định hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试着连续说 10 秒以上的自然句子。录音更完整，音高和自然度的估计会更稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "試著連續說 10 秒以上的自然句子。錄音更完整，音高和自然度的估計會更穩定。"
          }
        }
      }
    },
    "analysis.suggestions.shortRecording.subtitle": {
      "comment": "One-line reason under the title. 'Effective speech' is the voiced-audio duration measured by voice activity detection.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أقل من 5 ثوانٍ من الكلام الفعلي؛ مزيد من البيانات الصوتية يجعل النتيجة أكثر استقرارًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Méně než 5 sekund efektivní řeči; více hlasových dat znamená stabilnější výsledek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Under 5 sekunder med tale; flere stemmedata gør resultatet mere stabilt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weniger als 5 Sekunden erkannte Sprache; mehr Stimmdaten machen das Ergebnis stabiler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Λιγότερα από 5 δευτερόλεπτα ομιλίας· περισσότερα δεδομένα φωνής κάνουν το αποτέλεσμα πιο σταθερό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 5 seconds of effective speech; more voice data makes the result more stable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos de 5 segundos de voz detectada; más datos de voz harán que el resultado sea más estable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle 5 sekuntia havaittua puhetta – enemmän puhenäytettä tekee tuloksesta vakaamman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moins de 5 secondes de parole détectée ; davantage de voix rendrait le résultat plus stable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פחות מ-5 שניות של דיבור מזוהה; עוד נתוני קול ייצבו את התוצאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बोलने की अवधि 5 सेकंड से कम रही; ज़्यादा आवाज़ डेटा से नतीजा ज़्यादा स्थिर होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Manje od 5 sekundi govora; više podataka o glasu daje stabilniji rezultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kevesebb mint 5 másodperc tényleges beszéd; több hanganyagtól stabilabb lesz az eredmény."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ucapan terdeteksi kurang dari 5 detik; lebih banyak data suara membuat hasil lebih stabil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Meno di 5 secondi di voce rilevata: più dati vocali rendono il risultato più stabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効な音声が5秒未満です。声のデータが多いほど結果が安定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "유효 발화가 5초 미만이에요. 음성 정보가 많을수록 결과가 안정돼요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurang daripada 5 saat pertuturan berkesan; lebih banyak data suara menjadikan hasil lebih stabil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minder dan 5 seconden gedetecteerde spraak; meer steminformatie maakt het resultaat stabieler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mniej niż 5 sekund mowy — więcej danych o głosie daje stabilniejszy wynik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menos de 5 segundos de fala detectada; mais dados de voz deixam o resultado mais estável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Полезной речи меньше 5 секунд — больше голосовых данных сделает результат стабильнее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mindre än 5 sekunder talad tid; mer röst ger ett stabilare resultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจพบเสียงพูดไม่ถึง 5 วินาที ยิ่งมีข้อมูลเสียงมาก ผลลัพธ์จะยิ่งนิ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konuşma süresi 5 saniyenin altında; daha fazla ses verisi sonucu daha tutarlı kılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Менш ніж 5 секунд мовлення; більше даних про голос зробить результат стабільнішим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thời lượng nói chưa đầy 5 giây; thêm dữ liệu giọng nói sẽ giúp kết quả ổn định hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效语音不足 5 秒，更多声音信息会让结果更稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有效語音不足 5 秒，更多聲音資訊會讓結果更穩定。"
          }
        }
      }
    },
