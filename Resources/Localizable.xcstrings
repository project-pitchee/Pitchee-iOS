    "settings.theme.description" : {
      "comment" : "Theme color settings copy.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتبع المظهر افتراضيًا اتجاه صوتك: الأزرق للصوت الذكوري والوردي للصوت الأنثوي. يمكنك اختيار لون آخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Motiv ve výchozím nastavení sleduje směr vašeho hlasu: modrá pro mužský a růžová pro ženský. Můžete zvolit jinou barvu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Temaet følger som standard din stemmeretning: blå for maskulin og pink for feminin. Du kan vælge en anden farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Thema folgt standardmäßig deiner Stimmrichtung: Blau für maskulin und Pink für feminin. Du kannst eine andere Farbe wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Από προεπιλογή, το θέμα ακολουθεί την κατεύθυνση της φωνής σας: μπλε για ανδρική και ροζ για γυναικεία. Μπορείτε να επιλέξετε άλλο χρώμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, the theme follows your voice direction: blue for masculine and pink for feminine. You can choose another color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De forma predeterminada, el tema sigue la dirección de tu voz: azul para masculina y rosa para femenina. Puedes elegir otro color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teema seuraa oletuksena äänisuuntaasi: sininen maskuliiniselle ja vaaleanpunainen feminiiniselle. Voit valita muun värin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Par défaut, le thème suit la direction de votre voix : bleu pour une voix masculine et rose pour une voix féminine. Vous pouvez choisir une autre couleur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כברירת מחדל, ערכת הנושא עוקבת אחר כיוון הקול שלך: כחול לקול גברי וורוד לקול נשי. אפשר לבחור צבע אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिफ़ॉल्ट रूप से थीम आपकी आवाज़ की दिशा का पालन करती है: पुरुष आवाज़ के लिए नीला और महिला आवाज़ के लिए गुलाबी। आप कोई और रंग चुन सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tema prema zadanim postavkama prati smjer vašeg glasa: plava za muški i ružičasta za ženski. Možete odabrati drugu boju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A téma alapértelmezés szerint a hang irányát követi: kék a férfi, rózsaszín a női irányhoz. Másik színt is választhatsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secara default, tema mengikuti arah suara Anda: biru untuk maskulin dan merah muda untuk feminin. Anda dapat memilih warna lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per impostazione predefinita, il tema segue la direzione della voce: blu per maschile e rosa per femminile. Puoi scegliere un altro colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "デフォルトではテーマが音声の方向に合わせて変わります。男性向けは青、女性向けはピンクです。別の色も選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기본적으로 테마는 음성 방향을 따릅니다. 남성 방향은 파란색, 여성 방향은 분홍색입니다. 다른 색상도 선택할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Secara lalai, tema mengikut arah suara anda: biru untuk maskulin dan merah jambu untuk feminin. Anda boleh memilih warna lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Standaard volgt het thema je stemrichting: blauw voor mannelijk en roze voor vrouwelijk. Je kunt een andere kleur kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Domyślnie motyw podąża za kierunkiem głosu: niebieski dla męskiego i różowy dla żeńskiego. Możesz wybrać inny kolor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Por padrão, o tema segue a direção da sua voz: azul para masculina e rosa para feminina. Você pode escolher outra cor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "По умолчанию тема следует направлению вашего голоса: синий для мужского и розовый для женского. Можно выбрать другой цвет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Som standard följer temat din röstinriktning: blått för maskulin och rosa för feminin. Du kan välja en annan färg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ธีมจะใช้ทิศทางเสียงของคุณเป็นค่าเริ่มต้น: สีน้ำเงินสำหรับเสียงผู้ชายและสีชมพูสำหรับเสียงผู้หญิง คุณเลือกสีอื่นได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tema varsayılan olarak ses yönünü takip eder: erkek yönü için mavi, kadın yönü için pembe. Başka bir renk seçebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Типово тема відповідає напрямку голосу: синій для чоловічого та рожевий для жіночого. Можна вибрати інший колір."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Theo mặc định, chủ đề theo hướng giọng nói của bạn: xanh dương cho giọng nam và hồng cho giọng nữ. Bạn có thể chọn màu khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认主题色会跟随声音方向：男性向为蓝色，女性向为粉色。你也可以选择其他颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主題色預設會跟隨聲音方向：男性向為藍色，女性向為粉紅色。你也可以選擇其他顏色。"
          }
        }
      }
    },
