    "export.chart.result.caption": {
      "comment": "Explains how to read the result chart embedded in the report.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يشير حجم الدائرة إلى نسبة المرجع في الميل الصوتي؛ ويعرض المقياس الأيسر متوسط طبقة الصوت ونطاقها الأساسي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velikost kruhu odpovídá podílu v referenci hlasové tendence; levá stupnice ukazuje průměrnou výšku hlasu a základní výškový rozsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cirklens størrelse viser andelen i stemmetendens-referencen; skalaen til venstre viser gennemsnitlig tonehøjde og kerneområdet for tonehøjde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kreisgröße zeigt den Referenzanteil der Stimmtendenz; die linke Skala zeigt mittlere Tonhöhe und Kern-Tonhöhenbereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το μέγεθος του κύκλου δείχνει το ποσοστό αναφοράς της τάσης φωνής· η αριστερή κλίμακα δείχνει το μέσο ύψος και το κύριο εύρος ύψους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle size shows the reference share of voice tendency; the left scale shows mean pitch and core pitch range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tamaño del círculo muestra la proporción de la referencia de tendencia vocal; la escala izquierda muestra el tono promedio y el rango tonal central."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ympyrän koko kertoo, miten näyte jakautuu äänen suuntauksen viitealueille; vasen asteikko näyttää keskimääräisen sävelkorkeuden ja keskeisen sävelkorkeusalueen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La taille des cercles indique la part de référence de la tendance vocale ; l’échelle de gauche montre la hauteur moyenne et la plage de hauteur centrale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "גודל העיגול מציג את חלק הייחוס של נטיית הקול; הציר השמאלי מציג טון ממוצע וטווח טון מרכזי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "गोले का आकार आवाज़ की प्रवृत्ति में संदर्भ का हिस्सा दिखाता है; बाईं ओर का पैमाना औसत पिच और मुख्य पिच दायरा दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veličina kruga prikazuje udio u referenci sklonosti glasa; lijeva skala prikazuje prosječnu visinu i središnji raspon visine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A kör mérete a hangtendencia referencia-arányát mutatja; a bal oldali skála az átlagos hangmagasságot és a középső hangterjedelmet ábrázolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukuran lingkaran menunjukkan proporsi acuan kecenderungan suara; skala di kiri menunjukkan nada rata-rata dan rentang nada inti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La dimensione dei cerchi mostra la quota di riferimento della tendenza vocale; la scala a sinistra mostra tono medio e intervallo tonale centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "円の大きさは声の傾向の目安の割合を、左側の目盛りは平均音高と中心的な音域を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "원 크기는 음성 성향 참고 비율을 나타내고, 왼쪽 눈금은 평균 음높이와 핵심 음역을 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saiz bulatan menunjukkan bahagian rujukan kecenderungan suara; skala kiri menunjukkan purata pic dan julat pic teras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De grootte van de cirkel toont het aandeel in de stemneigingsreferentie; de linkerschaal toont de gemiddelde toonhoogte en het kernbereik van de toonhoogte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozmiar koła pokazuje udział w tendencji głosu; lewa skala pokazuje średnią wysokość i podstawowy zakres wysokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O tamanho do círculo mostra a proporção de referência da tendência vocal; a escala à esquerda mostra a altura média e a faixa de altura central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Размер круга показывает долю по направленности голоса; шкала слева показывает среднюю высоту тона и основной диапазон тона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cirkelns storlek visar andelen i rösttendensreferensen; skalan till vänster visar medeltonhöjd och kärnintervall."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ขนาดวงกลมแสดงสัดส่วนข้อมูลอ้างอิงของแนวโน้มเสียง สเกลด้านซ้ายแสดงระดับเสียงเฉลี่ยและช่วงเสียงหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dairelerin boyutu ses eğilimi referansındaki payı gösterir; soldaki ölçek ortalama perdeyi ve ana perde aralığını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розмір круга показує частку за орієнтиром схильності голосу; ліва шкала — середню висоту тону й основний діапазон тону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kích thước vòng tròn thể hiện tỉ lệ tham chiếu của xu hướng giọng nói; thang bên trái hiển thị cao độ trung bình và dải cao độ cốt lõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆形大小表示声音倾向参考占比；左侧刻度显示平均音高与核心音域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "圓形大小表示聲音傾向參考佔比；左側刻度顯示平均音高與核心音域。"
          }
        }
      }
    },
