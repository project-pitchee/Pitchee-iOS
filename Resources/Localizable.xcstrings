    "export.error.imageGenerationFailed": {
      "comment": "Shown when ImageRenderer or PNG encoding fails; displayed under export.error.saveFailed.title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر إنشاء الصورة. حاول مجددًا لاحقًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
