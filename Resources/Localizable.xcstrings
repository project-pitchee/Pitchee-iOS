    "analysis.error.noSpeechDetected": {
      "comment": "Analysis phase: PITCHEE_ERROR_NO_SPEECH.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُكتشف أي كلام. سجّل مقطعًا أوضح يتضمن كلامًا متواصلًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nebyla rozpoznána řeč. Nahrajte prosím zřetelnější nahrávku se souvislým projevem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der blev ikke registreret tale. Optag et tydeligere klip med sammenhængende tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wurde keine Sprache erkannt. Nimm eine klarere Aufnahme mit zusammenhängendem Sprechen auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ανιχνεύθηκε ομιλία. Ηχογραφήστε ένα πιο καθαρό δείγμα με συνεχή ομιλία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech was detected. Please record a clearer clip with continuous speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se detectó voz. Graba un audio más claro y con habla continua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puhetta ei havaittu. Nauhoita selkeämpi äänite, jossa puhut yhtäjaksoisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune voix n’a été détectée. Enregistrez un extrait plus clair, avec une parole continue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא זוהה דיבור. הקליטו קטע ברור יותר עם דיבור רציף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई आवाज़ नहीं मिली। कृपया लगातार बोलते हुए एक साफ़ क्लिप रिकॉर्ड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije otkriven govor. Snimi jasniji isječak s neprekinutim govorom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem sikerült beszédet észlelni. Vegyél fel tisztább hangot folyamatos beszéddel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada suara yang terdeteksi. Rekam audio yang lebih jelas dan berisi ucapan yang mengalir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stata rilevata voce. Registra un audio più chiaro con parlato continuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "人声を検出できませんでした。よりクリアで、連続した話し声が入った音声を録音してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "목소리가 감지되지 않았어요. 더 또렷하게 이어서 말한 오디오를 녹음해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada pertuturan dikesan. Sila rakam klip yang lebih jelas dengan pertuturan berterusan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Er is geen spraak gedetecteerd. Neem een duidelijker fragment op met doorlopende spraak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie wykryto mowy. Nagraj wyraźniejszy fragment z ciągłą mową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma fala foi detectada. Grave um áudio mais nítido, com fala contínua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Речь не обнаружена. Запишите более чёткий фрагмент с непрерывной речью."
          }
        },
        "sv": {
