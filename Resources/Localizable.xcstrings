        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svaki dan predstavlja snimka s najvišom ukupnom ocjenom; kod jednakih ocjena odabire se kasnija snimka. Grafikoni i statistike koriste valjane vrijednosti iz tih snimki."
