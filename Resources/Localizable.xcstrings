    "scoring.rules.continuous.condition": {
      "comment": "Machine-derived condition string for the default rule; terse, like a rule-engine output.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم تنطبق أي قاعدة سقف أو تعزيز أخرى"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neodpovídá žádné jiné pravidlo pro omezení ani navýšení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen andre loft- eller forhøjelsesregler udløst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keine andere Obergrenzen- oder Bonusregel ausgelöst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ίσχυσε άλλος κανόνας ορίου ή προσαύξησης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other cap or boost rule matched"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se activó ninguna otra regla de límite o impulso"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mikään muu rajaava tai nostava sääntö ei lauennut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune autre règle de plafond ou de bonus déclenchée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא הופעל כלל תקרה או בונוס אחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई और सीमा या बढ़त नियम लागू नहीं हुआ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nije pokrenuto ni jedno pravilo ograničenja ni povećanja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Más korlátozó vagy növelő szabály nem lépett érvénybe"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada aturan batas atas atau bonus lain yang cocok"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun'altra regola di tetto o incremento attivata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他の上限・加点ルールに該当なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 제한 또는 상향 규칙 없음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada peraturan had atau tambahan lain dipadankan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geen andere plafond- of verhogingsregel toegepast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie dopasowano innej reguły ograniczającej ani podbijającej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhuma outra regra de teto ou bônus foi acionada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другие правила ограничения или повышения не сработали"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen annan regel för tak eller lyft matchade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่ตรงกับกฎเพดานคะแนนหรือกฎเพิ่มคะแนนข้ออื่น"
