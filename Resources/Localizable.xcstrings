        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prirodnost je ovaj put dobra; zadrži opušten i povezan govor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A természetesség ezúttal jól sikerült; maradj laza, és tartsd folyamatosan a beszédet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kealamian kali ini bagus; tetap rileks dan jaga penyampaian tetap mengalir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa volta la naturalezza è buona: resta rilassato e mantieni un parlato scorrevole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回は自然度が良好です。リラックスして、滑らかにつながる話し方を続けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 자연스러움은 좋았어요. 편안하게 이어지는 말투를 유지해 보세요"
