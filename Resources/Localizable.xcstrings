          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się odczytać pełnych danych analizy. Wróć do podsumowania wskaźników lub zrób nowe nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
