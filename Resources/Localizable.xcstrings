        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この録音をもとに、次に練習したいことをまとめました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 녹음을 바탕으로 다음에 이렇게 연습해 보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berdasarkan rakaman ini, inilah yang perlu dilatih seterusnya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op basis van deze opname: dit kun je hierna oefenen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na podstawie tego nagrania — co warto ćwiczyć dalej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com base nesta gravação, veja o que treinar agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вот что стоит потренировать дальше по этой записи"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utifrån den här inspelningen är det här du kan öva på härnäst"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จากการบันทึกเสียงครั้งนี้ นี่คือสิ่งที่ควรฝึกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kayda göre sıradaki alıştırman için öneriler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ось що варто потренувати далі за цим записом"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dựa trên bản ghi này, đây là những gì bạn nên luyện tiếp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据这次录音，下一步可以这样练习"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "根據這次錄音，下一步可以這樣練習"
          }
        }
      }
    },
