    "practice.recording.instructions" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حافظ على المسافة نفسها من الميكروفون. اقرأ المقطع كاملًا براحة، واترك وقفة صامتة قصيرة قبل الكلام وبعده، ثم توقف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Udržujte stejnou vzdálenost od mikrofonu. Pohodlně přečtěte celý text, před řečí a po ní nechte krátkou tichou pauzu a potom nahrávání zastavte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hold samme afstand til mikrofonen. Læs hele teksten på en behagelig måde med en kort stille pause før og efter, du taler, og stop derefter optagelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte denselben Mikrofonabstand. Lies den gesamten Text entspannt mit einer kurzen stillen Pause vor und nach dem Sprechen und stoppe dann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Κρατήστε την ίδια απόσταση από το μικρόφωνο. Διαβάστε άνετα ολόκληρο το κείμενο, αφήνοντας μια σύντομη ήσυχη παύση πριν και μετά την ομιλία, και σταματήστε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the same microphone distance. Read the full passage comfortably, leaving a short quiet pause before and after speaking, then stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén la misma distancia al micrófono. Lee todo el texto con comodidad, dejando una breve pausa silenciosa antes y después de hablar, y luego detén la grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidä sama etäisyys mikrofoniin. Lue koko teksti mukavasti ja jätä lyhyt hiljainen tauko ennen puhetta ja sen jälkeen. Pysäytä sitten tallennus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gardez la même distance du microphone. Lisez tout le passage confortablement, avec une courte pause silencieuse avant et après la parole, puis arrêtez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "שמרו על אותו מרחק מהמיקרופון. קראו את כל הקטע בנוחות, השאירו הפסקה שקטה קצרה לפני הדיבור ואחריו, ואז עצרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "माइक्रोफ़ोन से समान दूरी रखें। पूरा अंश सहजता से पढ़ें, बोलने से पहले और बाद में थोड़ी देर शांत रहें, फिर रोकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zadrži istu udaljenost od mikrofona. Ugodno pročitaj cijeli tekst, ostavi kratku tihu stanku prije i poslije govora, a zatim zaustavi snimanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tartsd ugyanazt a mikrofontávolságot. Olvasd fel kényelmesen a teljes szöveget, előtte és utána hagyj rövid csendet, majd állítsd le a felvételt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pertahankan jarak mikrofon yang sama. Baca seluruh teks dengan nyaman, beri jeda hening singkat sebelum dan sesudah berbicara, lalu berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantieni la stessa distanza dal microfono. Leggi l'intero brano senza sforzo, lasciando una breve pausa silenziosa prima e dopo aver parlato, poi interrompi la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "マイクとの距離を一定に保ってください。話す前後に短い無音の間を取り、文章全体を楽な声で読んでから停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "마이크와의 거리를 일정하게 유지해 주세요. 말하기 전후에 짧은 무음 구간을 두고 전체 글을 편안하게 읽은 다음 중지해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kekalkan jarak mikrofon yang sama. Baca seluruh petikan dengan selesa, biarkan jeda senyap yang singkat sebelum dan selepas bercakap, kemudian berhenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd dezelfde afstand tot de microfoon aan. Lees de hele tekst op een comfortabele manier, laat voor en na het spreken een korte stille pauze vallen en stop dan de opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zachowaj tę samą odległość od mikrofonu. Przeczytaj swobodnie cały tekst, pozostawiając krótką cichą przerwę przed mówieniem i po nim, a następnie zatrzymaj nagranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha a mesma distância do microfone. Leia o texto inteiro com conforto, deixando uma breve pausa silenciosa antes e depois de falar, e então pare a gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сохраняйте одинаковое расстояние до микрофона. Прочитайте весь текст комфортным голосом, оставив короткую тихую паузу до и после речи, затем остановите запись."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Håll samma avstånd till mikrofonen. Läs hela texten på ett bekvämt sätt med en kort tyst paus före och efter talet och stoppa sedan inspelningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "รักษาระยะไมโครโฟนให้เท่าเดิม อ่านทั้งบทอย่างสบาย เว้นช่วงเงียบสั้น ๆ ก่อนและหลังพูด แล้วหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mikrofona aynı mesafeyi koru. Metnin tamamını rahatça oku, konuşmadan önce ve sonra kısa bir sessiz ara bırak, sonra durdur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зберігайте однакову відстань до мікрофона. Прочитайте весь текст комфортним голосом, залишивши коротку тиху паузу перед мовленням і після нього, а потім зупиніть запис."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ nguyên khoảng cách tới micrô. Đọc toàn bộ đoạn văn thoải mái, để một khoảng lặng ngắn trước và sau khi nói, rồi dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持相同距离，舒适地读完全文；开始和结束时各留一小段安静，再点停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持相同的麥克風距離。舒適地讀完整段文字，在說話前後各留一小段安靜停頓，然後停止錄音。"
          }
        }
      }
    },
    "practice.recording.interrupted" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "توقف التسجيل بعد مقاطعة أو تغيير مسار الصوت أو مغادرة المقدمة. مُسح التسجيل غير المكتمل. حافظ على المسافة نفسها واقرأ المقطع مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrávání se zastavilo po přerušení, změně zvukové trasy nebo opuštění popředí. Nedokončená nahrávka byla vymazána. Zachovejte stejnou vzdálenost a přečtěte text znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optagelsen stoppede efter en afbrydelse, ændring af lydruten eller fordi appen forlod forgrunden. Den ufuldstændige optagelse blev ryddet. Hold samme afstand, og læs teksten igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahme wurde nach einer Unterbrechung, einem Wechsel des Audiowegs oder dem Verlassen des Vordergrunds gestoppt. Die unvollständige Aufnahme wurde gelöscht. Halte denselben Abstand und lies den Text erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η εγγραφή σταμάτησε μετά από διακοπή, αλλαγή διαδρομής ήχου ή έξοδο από το προσκήνιο. Η ημιτελής λήψη διαγράφηκε. Κρατήστε την ίδια απόσταση και διαβάστε το κείμενο ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording stopped after an interruption, audio route change, or leaving the foreground. The incomplete take was cleared. Keep the same distance and read the passage again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La grabación se detuvo por una interrupción, un cambio de ruta de audio o al salir de primer plano. La toma incompleta se borró. Mantén la misma distancia y vuelve a leer el texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennus pysähtyi keskeytyksen, äänireitin muutoksen tai etualalta poistumisen vuoksi. Keskeneräinen otto tyhjennettiin. Pidä sama etäisyys ja lue teksti uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’enregistrement s’est arrêté après une interruption, un changement de routage audio ou un passage en arrière-plan. La prise incomplète a été effacée. Gardez la même distance et relisez le passage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ההקלטה נעצרה עקב הפרעה, שינוי בנתיב השמע או יציאה מהחזית. ההקלטה החלקית נמחקה. שמרו על אותו מרחק וקראו את הקטע שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बाधा, ऑडियो रूट बदलने या ऐप सामने से हटने के बाद रिकॉर्डिंग रुक गई। अधूरी रिकॉर्डिंग मिटा दी गई है। समान दूरी रखें और अंश फिर पढ़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snimanje je zaustavljeno nakon prekida, promjene zvučnog puta ili izlaska iz prvog plana. Nedovršena snimka je izbrisana. Zadrži istu udaljenost i ponovno pročitaj tekst."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A felvétel megszakítás, hangútvonal-változás vagy az előtér elhagyása miatt leállt. A hiányos felvétel törlődött. Tartsd ugyanazt a távolságot, és olvasd fel újra a szöveget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perekaman berhenti setelah interupsi, perubahan jalur audio, atau aplikasi meninggalkan latar depan. Rekaman yang belum lengkap telah dihapus. Pertahankan jarak yang sama dan baca teks lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La registrazione si è fermata dopo un'interruzione, un cambio del percorso audio o l'uscita dal primo piano. La registrazione incompleta è stata cancellata. Mantieni la stessa distanza e leggi di nuovo il brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "割り込み、音声出力先・入力元の変更、またはアプリが前面でなくなったため、録音を停止しました。未完了の音声は消去されました。同じ距離を保ち、もう一度文章を読んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "중단, 오디오 경로 변경 또는 앱이 화면에서 벗어나 녹음이 멈췄어요. 미완성 녹음은 지워졌어요. 같은 거리를 유지하고 글을 다시 읽어 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rakaman terhenti selepas gangguan, perubahan laluan audio, atau aplikasi meninggalkan latar depan. Rakaman yang tidak lengkap telah dipadam. Kekalkan jarak yang sama dan baca petikan semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De opname is gestopt na een onderbreking, een wijziging van de audioroute of het verlaten van de voorgrond. De onvolledige opname is gewist. Houd dezelfde afstand aan en lees de tekst opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nagrywanie zatrzymało się po przerwaniu, zmianie trasy audio lub opuszczeniu pierwszego planu. Niepełne nagranie zostało usunięte. Zachowaj tę samą odległość i ponownie przeczytaj tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gravação parou após uma interrupção, mudança de rota de áudio ou saída do primeiro plano. A tomada incompleta foi limpa. Mantenha a mesma distância e leia o texto novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запись остановлена из-за прерывания, смены аудиомаршрута или ухода приложения с переднего плана. Незавершённая запись удалена. Сохраняйте то же расстояние и прочитайте текст снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inspelningen stoppades efter ett avbrott, en ändring av ljudvägen eller när appen lämnade förgrunden. Den ofullständiga inspelningen rensades. Håll samma avstånd och läs texten igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การบันทึกหยุดหลังมีการขัดจังหวะ เปลี่ยนเส้นทางเสียง หรือออกจากเบื้องหน้า เสียงที่ไม่สมบูรณ์ถูกล้างแล้ว รักษาระยะเดิมและอ่านบทอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir kesinti, ses yolu değişikliği veya uygulamanın ön plandan ayrılması nedeniyle kayıt durdu. Tamamlanmamış kayıt temizlendi. Aynı mesafeyi koru ve metni yeniden oku."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Запис зупинено через переривання, зміну аудіомаршруту або вихід застосунку з переднього плану. Незавершений запис видалено. Зберігайте ту саму відстань і прочитайте текст знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ghi âm đã dừng do gián đoạn, thay đổi tuyến âm thanh hoặc rời tiền cảnh. Bản ghi chưa hoàn chỉnh đã được xóa. Giữ nguyên khoảng cách và đọc lại đoạn văn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音因中断、音频设备变化或离开前台而停止，这段未完成的音频已清理。请保持相同距离，重新读完短句。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音因中斷、音訊路徑變更或離開前景而停止。不完整的錄音已清除。請保持相同距離，再讀一次這段文字。"
          }
        }
