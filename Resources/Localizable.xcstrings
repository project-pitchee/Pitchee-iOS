    "insights.metric.compositeScore.description" : {
      "comment" : "Plain-language description of the composite score without making clinical claims.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تلخص النتيجة الإجمالية التحليل العام على مقياس 0–100. تابع الأنماط عبر عدة تسجيلات؛ فالنتيجة الواحدة لا تعكس جميع صفات الصوت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Celkové skóre shrnuje analýzu na stupnici 0–100. Sledujte změny v několika nahrávkách; jedno skóre nezachycuje všechny vlastnosti hlasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den samlede score opsummerer analysen på en skala fra 0 til 100. Se efter mønstre på tværs af optagelser; én score beskriver ikke alle en stemmes egenskaber."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Gesamtbewertung fasst die Analyse auf einer Skala von 0 bis 100 zusammen. Achte auf Entwicklungen über mehrere Aufnahmen hinweg; eine einzelne Bewertung erfasst nicht alle Eigenschaften einer Stimme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η συνολική βαθμολογία συνοψίζει την ανάλυση σε κλίμακα 0–100. Αναζητήστε τάσεις σε πολλές εγγραφές· μία βαθμολογία δεν αποτυπώνει όλες τις ιδιότητες μιας φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The composite score summarizes the overall analysis on a 0–100 scale. Look for patterns across recordings; one score does not capture every quality of a voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El puntaje general resume el análisis en una escala de 0–100. Observa los patrones entre grabaciones; un solo puntaje no refleja todas las cualidades de una voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokonaispisteet tiivistävät analyysin asteikolla 0–100. Tarkastele useiden tallenteiden välisiä suuntauksia: yksi pistemäärä ei kuvaa äänen kaikkia ominaisuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le score global résume l’analyse sur une échelle de 0 à 100. Observez les tendances entre plusieurs enregistrements : un seul score ne représente pas toutes les qualités d’une voix."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הציון הכולל מסכם את תוצאות הניתוח בסולם 0–100. חפשו דפוסים לאורך כמה הקלטות; ציון יחיד אינו משקף את כל איכויות הקול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुल स्कोर, विश्लेषण के समग्र परिणाम को 0–100 के पैमाने पर दिखाता है। कई रिकॉर्डिंग में रुझान देखें; एक स्कोर आवाज़ की हर विशेषता नहीं बताता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukupna ocjena sažima analizu na ljestvici 0–100. Prati promjene kroz više snimki; jedna ocjena ne opisuje sve osobine glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az összpontszám 0–100 közötti skálán foglalja össze az elemzést. Figyeld több felvétel mintázatait: egyetlen pontszám nem írja le a hang minden tulajdonságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor keseluruhan merangkum hasil analisis pada skala 0–100. Amati pola dari beberapa rekaman; satu skor tidak mencakup semua kualitas suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il punteggio complessivo riassume l'analisi su una scala da 0 a 100. Osserva l'andamento tra più registrazioni: un solo punteggio non rappresenta tutte le qualità di una voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "総合スコアは分析全体の結果を0～100で表します。複数の録音で変化を確認しましょう。1回のスコアだけで声のすべての特徴を表すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "종합 점수는 전체 분석 결과를 0~100으로 요약해요. 여러 녹음에서 나타나는 변화를 살펴보세요. 한 번의 점수로 목소리의 모든 특징을 알 수는 없어요."
