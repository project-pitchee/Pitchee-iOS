    "analysis.error.analysisFailed %lld": {
      "comment": "Shown when analysis fails for any reason not covered by a more specific message. %1$lld is an internal status code — keep it in the sentence.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
