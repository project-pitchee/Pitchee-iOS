    "scoreStudy.settings.clear.note" : {
      "comment" : "Optional local comparison of scoring rules against the person's self-rated practice goal. This is not gender identity or a claim of model accuracy. Nothing is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يُبقي مسح هذه الدراسة أو إيقافها حدود الفترة الحالية. ولا يزيد الدعوات أو يغيّر التشخيصات الأساسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vymazání nebo vypnutí studie zachová limity aktuálního období. Nepřidává další výzvy ani nemění základní diagnostiku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis du rydder eller slår undersøgelsen fra, bevares grænserne for den aktuelle periode. Det tilføjer ikke invitationer og ændrer ikke den grundlæggende diagnostik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löschen oder Deaktivieren behält die Grenzen des laufenden Zeitraums bei. Es fügt keine Einladungen hinzu und verändert die grundlegende Diagnose nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η εκκαθάριση ή απενεργοποίηση της μελέτης διατηρεί τα όρια της τρέχουσας περιόδου. Δεν προσθέτει προσκλήσεις και δεν αλλάζει τα βασικά διαγνωστικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearing or turning off this study preserves its current period limits. It does not add invitations or change basic diagnostics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Borrar o desactivar este estudio conserva los límites del período actual. No añade invitaciones ni cambia los diagnósticos básicos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutkimuksen tyhjentäminen tai poistaminen käytöstä säilyttää nykyisen jakson rajat. Se ei lisää kutsuja eikä muuta perusdiagnostiikkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Effacer ou désactiver l’étude conserve les limites de la période en cours. Cela n’ajoute aucune invitation et ne modifie pas les diagnostics de base."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ניקוי או כיבוי המחקר משאירים את מגבלות התקופה הנוכחית בתוקף. הם אינם מוסיפים הזמנות או משנים את האבחון הבסיסי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस अध्ययन को मिटाने या बंद करने पर वर्तमान अवधि की सीमाएँ बनी रहती हैं। इससे निमंत्रण नहीं बढ़ते और बुनियादी निदान नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brisanje ili isključivanje istraživanja zadržava ograničenja trenutačnog razdoblja. Ne dodaje pozive niti mijenja osnovnu dijagnostiku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A vizsgálat törlése vagy kikapcsolása megtartja az aktuális időszak korlátait. Nem ad új meghívásokat, és nem módosítja az alapdiagnosztikát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menghapus atau menonaktifkan studi ini tetap mempertahankan batas periode saat ini. Ini tidak menambah undangan atau mengubah diagnostik dasar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cancellare o disattivare questo studio mantiene i limiti del periodo attuale. Non aggiunge inviti e non modifica la diagnostica di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "集計を消去したり比較をオフにしたりしても、現在の期間の回数制限は維持されます。案内回数は増えず、基本診断の設定も変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "요약을 지우거나 비교를 꺼도 현재 기간의 횟수 제한은 유지돼요. 참여 요청 횟수가 늘어나거나 기본 진단 설정이 바뀌지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengosongkan atau mematikan kajian ini mengekalkan had tempoh semasa. Ia tidak menambah jemputan atau mengubah diagnostik asas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je dit onderzoek wist of uitschakelt, blijven de limieten van de huidige periode gelden. Er komen geen uitnodigingen bij en de basisdiagnostiek verandert niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyczyszczenie lub wyłączenie badania zachowuje limity bieżącego okresu. Nie dodaje zaproszeń ani nie zmienia podstawowej diagnostyki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Limpar ou desativar este estudo mantém os limites do período atual. Isso não adiciona convites nem altera os diagnósticos básicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Очистка или отключение исследования сохраняет ограничения текущего периода. Количество приглашений не увеличивается, настройки базовой диагностики не меняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om du rensar eller stänger av studien behålls gränserna för den aktuella perioden. Det lägger inte till inbjudningar och ändrar inte grundläggande diagnostik."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การล้างหรือปิดการศึกษานี้ยังคงข้อจำกัดของรอบปัจจุบันไว้ ไม่เพิ่มคำเชิญหรือเปลี่ยนการวินิจฉัยพื้นฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu çalışmayı temizlemek veya kapatmak, mevcut dönem sınırlarını korur. Davet sayısını artırmaz veya temel tanılamayı değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Очищення або вимкнення дослідження зберігає обмеження поточного періоду. Кількість запрошень не збільшується, а налаштування базової діагностики не змінюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xóa hoặc tắt nghiên cứu vẫn giữ nguyên giới hạn của kỳ hiện tại. Việc này không tăng số lời mời hoặc thay đổi chẩn đoán cơ bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空或关闭后仍保留本周期次数限制；不会增加邀请次数，也不会开启或关闭基础诊断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除或關閉後仍保留本週期的次數限制；不會增加邀請次數，也不會變更基本診斷。"
          }
        }
      }
    },
    "scoreStudy.settings.comparison.description" : {
      "comment" : "Optional local comparison of scoring rules against the person's self-rated practice goal. This is not gender identity or a claim of model accuracy. Nothing is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقارن النتيجة الإجمالية الحالية بالنتيجة المتصلة قبل تطبيق الحدود القصوى والزيادات، لمعرفة أيهما أقرب إلى تقييمك الذاتي. تظل النتائج العادية تستخدم قواعد التقييم الحالية؛ ولا تغيّر الملاحظات النتيجة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnává aktuální celkové skóre se spojitým skóre před použitím omezení a bonusů a zjišťuje, které je bližší vašemu sebehodnocení. Běžné výsledky nadále používají současná pravidla výpočtu; odpověď skóre nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammenligner den aktuelle samlede score med den kontinuerlige score før lofter og forhøjelser for at se, hvilken der ligger tættest på din selvvurdering. Normale resultater bruger fortsat de aktuelle scoreregler; feedback ændrer ikke scoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergleicht die aktuelle Gesamtbewertung mit der kontinuierlichen Bewertung vor Obergrenzen und Zuschlägen: Welche liegt näher an deiner Selbsteinschätzung? Normale Ergebnisse nutzen weiterhin die bisherigen Regeln; Feedback verändert die Bewertung nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγκρίνει την τρέχουσα συνολική βαθμολογία με τη συνεχή βαθμολογία πριν από όρια και προσαυξήσεις, για να φανεί ποια είναι πιο κοντά στην αυτοαξιολόγησή σας. Τα κανονικά αποτελέσματα συνεχίζουν να χρησιμοποιούν τους τρέχοντες κανόνες· η απάντηση δεν αλλάζει τη βαθμολογία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compares the current composite score with the continuous score before caps and boosts, asking which is closer to your self-rating. Normal results continue to use the current scoring rules; feedback does not change the score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara el puntaje general actual con el puntaje continuo anterior a los límites y aumentos para determinar cuál se acerca más a tu autoevaluación. Los resultados normales siguen usando las reglas actuales; tus respuestas no cambian el puntaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertaa nykyisiä kokonaispisteitä jatkuvaan pistemäärään ennen ylärajoja ja korotuksia ja tarkastelee, kumpi on lähempänä itsearviointiasi. Tavalliset tulokset käyttävät edelleen nykyisiä pisteytyssääntöjä. Palaute ei muuta pisteitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compare le score global actuel au score continu avant plafonnement et bonification, pour voir lequel est le plus proche de votre autoévaluation. Les résultats habituels gardent les règles actuelles ; votre avis ne change pas le score."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "משווה את הציון הכולל הנוכחי לציון הרציף שלפני החלת תקרות ותוספות, כדי לבדוק איזה מהם קרוב יותר להערכה העצמית שלכם. התוצאות הרגילות ממשיכות להשתמש בכללי הניקוד הנוכחיים; המשוב אינו משנה את הציון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "वर्तमान कुल स्कोर की तुलना, सीमा और बढ़ोतरी लागू होने से पहले के सतत स्कोर से करके देखता है कि कौन-सा आपके स्व-मूल्यांकन के अधिक करीब है। सामान्य परिणाम वर्तमान स्कोरिंग नियमों का इस्तेमाल करते हैं; प्रतिक्रिया से स्कोर नहीं बदलता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uspoređuje trenutačnu ukupnu ocjenu s kontinuiranom ocjenom prije primjene ograničenja i bonusa kako bi se vidjelo koja je bliža tvojoj samoprocjeni. Uobičajeni rezultati i dalje koriste postojeća pravila ocjenjivanja; odgovor ne mijenja ocjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Összehasonlítja az aktuális összpontszámot a korlátozások és növelések előtti folytonos pontszámmal, hogy melyik áll közelebb az önértékelésedhez. A normál eredmények továbbra is az aktuális pontozási szabályokat használják; a visszajelzés nem módosítja a pontszámot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Membandingkan skor keseluruhan saat ini dengan skor kontinu sebelum pembatasan dan peningkatan, untuk melihat mana yang lebih dekat dengan penilaian diri Anda. Hasil normal tetap menggunakan aturan penilaian saat ini; masukan tidak mengubah skor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confronta il punteggio complessivo attuale con il punteggio continuo prima di limiti e incrementi, per vedere quale è più vicino alla tua autovalutazione. I risultati normali continuano a usare le regole attuali; le risposte non cambiano il punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在の総合スコアと、上限や加点を適用する前の連続値のスコアを比較し、どちらが自己評価に近いかを確認します。通常の結果は引き続き現在の採点ルールを使い、回答によってスコアは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "현재 종합 점수와 상한 및 가산 규칙 적용 전의 연속 점수를 비교해 어느 쪽이 자기 평가에 더 가까운지 확인해요. 일반 결과에는 기존 점수 규칙을 계속 사용하며, 응답은 점수를 바꾸지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Membandingkan skor keseluruhan semasa dengan skor berterusan sebelum had dan peningkatan digunakan, untuk melihat yang mana lebih hampir dengan penilaian kendiri anda. Hasil biasa terus menggunakan peraturan pemarkahan semasa; maklum balas tidak mengubah skor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergelijkt de huidige totaalscore met de continue score vóór begrenzingen en verhogingen om te zien welke dichter bij je zelfbeoordeling ligt. Normale resultaten blijven de huidige scoreregels gebruiken; feedback verandert de score niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównuje bieżący wynik ogólny z wynikiem ciągłym sprzed zastosowania limitów i premii, aby sprawdzić, który jest bliższy twojej samoocenie. Zwykłe wyniki nadal korzystają z obecnych zasad obliczania; odpowiedź nie zmienia wyniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara a pontuação geral atual com a pontuação contínua antes dos limites e aumentos para verificar qual se aproxima mais da sua autoavaliação. Os resultados normais continuam usando as regras atuais; suas respostas não alteram a pontuação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сравнивает текущую общую оценку с непрерывной оценкой до применения ограничений и надбавок, чтобы определить, какая из них ближе к вашей самооценке. Обычные результаты по-прежнему используют текущие правила расчёта; ответ не меняет оценку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jämför den aktuella totalpoängen med den kontinuerliga poängen före tak och höjningar för att se vilken som ligger närmast din självskattning. Vanliga resultat fortsätter att använda nuvarande poängregler; återkoppling ändrar inte poängen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปรียบเทียบคะแนนรวมปัจจุบันกับคะแนนต่อเนื่องก่อนใช้เพดานและการเพิ่มคะแนน เพื่อดูว่าคะแนนใดใกล้กับการประเมินตนเองมากกว่า ผลปกติยังใช้กฎการให้คะแนนปัจจุบัน ความคิดเห็นไม่เปลี่ยนคะแนน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mevcut genel puanı, üst sınırlar ve artışlar uygulanmadan önceki sürekli puanla karşılaştırarak hangisinin öz değerlendirmene daha yakın olduğunu inceler. Normal sonuçlar mevcut puanlama kurallarını kullanmaya devam eder; geri bildirim puanı değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівнює поточну загальну оцінку з неперервною оцінкою до застосування обмежень і надбавок, щоб визначити, яка ближча до вашої самооцінки. Звичайні результати й надалі використовують чинні правила розрахунку; відповідь не змінює оцінку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sánh điểm tổng hợp hiện tại với điểm liên tục trước khi áp dụng giới hạn trần và tăng điểm, để xem điểm nào gần với tự đánh giá của bạn hơn. Kết quả thông thường vẫn dùng quy tắc tính điểm hiện tại; phản hồi không thay đổi điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较现有综合分与应用封顶、提升规则之前的连续分，看哪一种更接近你的当次自评。正常结果仍使用现有评分，自评不会改变分数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較現有綜合評分與套用上限、加分規則之前的連續評分，看哪一種更接近你的當次自評。一般結果仍使用現有評分規則，自評不會改變分數。"
          }
        }
      }
    },
    "scoreStudy.settings.consent.description" : {
      "comment" : "Optional local comparison of scoring rules against the person's self-rated practice goal. This is not gender identity or a claim of model accuracy. Nothing is uploaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد الموافقة على المشاركة، قد تتلقى التسجيلات الجديدة دعوة عشوائية للتقييم الذاتي. تُفصل الملخصات حسب اتجاه التدريب المختار عند بدء التسجيل. تُطلب الملاحظات قبل ظهور النتائج ويمكن تخطيها. يبقى التسجيل المؤقت على هذا الجهاز أثناء الانتظار. عندما يكون التطبيق في المقدمة، يستمر التحليل عادةً بعد 30 ثانية؛ وقد يؤدي تعليق النظام للتطبيق إلى تأخير المعالجة والتنظيف. تحفظ الدراسة أعدادًا ملخصة محليًا فقط، دون سجلات فردية للملاحظات أو روابط بالتسجيلات، ولا ترسل أي بيانات للدراسة. يؤدي إيقافها إلى مسح ملخص الدراسة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po souhlasu s účastí se u nových nahrávek může náhodně objevit výzva k sebehodnocení. Souhrny se dělí podle směru cvičení vybraného na začátku nahrávání. Odpověď se požaduje před zobrazením skóre a lze ji přeskočit. Během čekání zůstává dočasná nahrávka v tomto zařízení. V popředí analýza obvykle pokračuje po 30 sekundách; pozastavení systémem může zpozdit zpracování a odstranění dat. Studie ukládá pouze místní souhrnné počty, bez jednotlivých odpovědí či vazeb na nahrávky, a žádná data studie neodesílá. Vypnutí vymaže souhrn studie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når du tilmelder dig, kan nye optagelser udløse en tilfældig invitation til selvvurdering. Oversigter opdeles efter det øvelsesmål, du vælger, når optagelsen starter. Der spørges om feedback, før scorerne vises, og du kan springe den over. Den midlertidige optagelse bliver på denne enhed, mens du venter. I forgrunden fortsætter analysen normalt efter 30 sekunder; hvis systemet suspenderer appen, kan behandling og oprydning blive forsinket. Undersøgelsen gemmer kun lokale, opsummerede antal uden individuelle feedbackregistreringer eller links til optagelser og sender ingen undersøgelsesdata. Hvis du slår den fra, ryddes undersøgelsens oversigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach deiner Zustimmung können neue Aufnahmen zufällig eine Einladung zur Selbsteinschätzung erhalten. Zusammenfassungen werden nach der beim Aufnahmestart gewählten Übungsrichtung getrennt. Feedback wird vor der Bewertung abgefragt und kann übersprungen werden. Die vorübergehende Aufnahme bleibt während des Wartens auf diesem Gerät. Im Vordergrund wird die Analyse normalerweise nach 30 Sekunden fortgesetzt; eine Systemunterbrechung kann Verarbeitung und Bereinigung verzögern. Die Studie speichert nur lokale zusammengefasste Zählwerte, keine einzelnen Antworten oder Verknüpfungen mit Aufnahmen, und sendet keine Studiendaten. Deaktivieren löscht die Studienzusammenfassung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μετά τη συγκατάθεσή σας, νέες εγγραφές μπορεί να λάβουν τυχαία πρόσκληση αυτοαξιολόγησης. Οι συνόψεις διαχωρίζονται με βάση την κατεύθυνση εξάσκησης που επιλέγεται στην αρχή της εγγραφής. Η απάντηση ζητείται πριν εμφανιστούν οι βαθμολογίες και μπορεί να παραλειφθεί. Η προσωρινή εγγραφή παραμένει σε αυτή τη συσκευή κατά την αναμονή. Στο προσκήνιο, η ανάλυση συνήθως συνεχίζεται μετά από 30 δευτερόλεπτα· η αναστολή από το σύστημα μπορεί να καθυστερήσει την επεξεργασία και την εκκαθάριση. Η μελέτη αποθηκεύει μόνο τοπικά συγκεντρωτικά πλήθη, χωρίς μεμονωμένες απαντήσεις ή συνδέσεις με εγγραφές, και δεν αποστέλλει δεδομένα μελέτης. Η απενεργοποίηση διαγράφει τη σύνοψη της μελέτης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you opt in, new recordings may receive a random self-rating invitation. Summaries are separated by the practice direction chosen when recording starts. Feedback is requested before scores appear and can be skipped. The temporary recording remains on this device while waiting. In the foreground, analysis normally continues after 30 seconds; system suspension may delay processing and cleanup. The study saves local summary counts only, without individual feedback records or links to recordings, and sends no study data. Turning this off clears the study summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al participar, las nuevas grabaciones podrán recibir una invitación aleatoria para autoevaluarte. Los resúmenes se separan según el objetivo de práctica elegido al iniciar la grabación. Las respuestas se solicitan antes de mostrar los puntajes y se pueden omitir. La grabación temporal permanece en este dispositivo durante la espera. En primer plano, el análisis normalmente continúa después de 30 segundos; la suspensión del sistema puede retrasar el procesamiento y la limpieza. El estudio solo guarda recuentos resumidos locales, sin respuestas individuales ni vínculos a grabaciones, y no envía datos del estudio. Al desactivarlo, se borra el resumen del estudio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun suostut osallistumaan, uusiin tallenteisiin voi liittyä satunnainen itsearviointikutsu. Yhteenvedot erotellaan tallennuksen alussa valitun harjoittelutavoitteen mukaan. Palautetta pyydetään ennen pisteiden näyttämistä, ja sen voi ohittaa. Väliaikainen tallenne pysyy tällä laitteella odotuksen ajan. Etualalla analyysi jatkuu yleensä 30 sekunnin kuluttua. Jos järjestelmä keskeyttää sovelluksen toiminnan, käsittely ja tietojen siivous voivat viivästyä. Tutkimus tallentaa vain paikallisia yhteenvetolukumääriä ilman yksittäisiä palautetietueita tai linkkejä tallenteisiin eikä lähetä tutkimustietoja. Käytöstä poistaminen tyhjentää tutkimuksen yhteenvedon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après activation, les nouveaux enregistrements peuvent recevoir une invitation aléatoire à s’autoévaluer. Les récapitulatifs sont séparés selon la direction choisie au début de l’enregistrement. L’avis est demandé avant l’affichage des scores et peut être ignoré. L’enregistrement temporaire reste sur cet appareil pendant l’attente. Au premier plan, l’analyse reprend normalement après 30 secondes ; une suspension du système peut retarder le traitement et le nettoyage. L’étude ne conserve que des compteurs récapitulatifs locaux, sans avis individuels ni liens vers les enregistrements, et n’envoie aucune donnée d’étude. La désactivation efface le récapitulatif."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לאחר שתבחרו להשתתף, הקלטות חדשות עשויות לקבל הזמנה אקראית להערכה עצמית. הסיכומים מופרדים לפי כיוון התרגול שנבחר בתחילת ההקלטה. המשוב מתבקש לפני הצגת הציונים וניתן לדלג עליו. בזמן ההמתנה, ההקלטה הזמנית נשארת במכשיר זה. כשהיישום בחזית, הניתוח בדרך כלל ממשיך לאחר 30 שניות; השעיה בידי המערכת עשויה לעכב את העיבוד ואת הניקוי. המחקר שומר רק ספירות מסכמות מקומיות, ללא רשומות משוב נפרדות או קישורים להקלטות, ואינו שולח שום נתוני מחקר. כיבוי האפשרות מנקה את סיכום המחקר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके भाग लेने की सहमति देने के बाद, नई रिकॉर्डिंग को यादृच्छिक स्व-मूल्यांकन निमंत्रण मिल सकता है। सारांश, रिकॉर्डिंग शुरू करते समय चुनी गई अभ्यास की दिशा के अनुसार अलग रखे जाते हैं। स्कोर दिखने से पहले प्रतिक्रिया माँगी जाती है और इसे छोड़ा जा सकता है। इंतज़ार के दौरान अस्थायी रिकॉर्डिंग इसी डिवाइस पर रहती है। ऐप सामने खुला होने पर विश्लेषण आमतौर पर 30 सेकंड बाद जारी रहता है; सिस्टम द्वारा ऐप निलंबित किए जाने से प्रोसेसिंग और सफ़ाई में देरी हो सकती है। अध्ययन केवल स्थानीय सारांश गिनतियाँ सेव करता है, अलग-अलग प्रतिक्रियाओं के रिकॉर्ड या रिकॉर्डिंग से उनके लिंक नहीं रखता और अध्ययन का कोई डेटा नहीं भेजता। इसे बंद करने से अध्ययन का सारांश मिट जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nakon pristanka na sudjelovanje, nove snimke mogu nasumično dobiti poziv na samoprocjenu. Sažeci se razdvajaju prema smjeru vježbe odabranom na početku snimanja. Odgovor se traži prije prikaza ocjena i može se preskočiti. Privremena snimka tijekom čekanja ostaje na ovom uređaju. U prvom planu analiza se obično nastavlja nakon 30 sekundi; obustava rada od strane sustava može odgoditi obradu i brisanje. Istraživanje sprema samo lokalne zbirne brojeve, bez pojedinačnih odgovora ili poveznica sa snimkama, i ne šalje podatke istraživanja. Isključivanje briše sažetak istraživanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha hozzájárulsz a részvételhez, az új felvételeknél véletlenszerűen önértékelési meghívás jelenhet meg. Az összesítések a felvétel indításakor választott gyakorlási cél szerint különülnek el. A visszajelzést a pontszámok megjelenése előtt kérjük, és kihagyható. Várakozás közben az ideiglenes felvétel ezen az eszközön marad. Az előtérben az elemzés általában 30 másodperc után folytatódik; a rendszer általi felfüggesztés késleltetheti a feldolgozást és a törlést. A vizsgálat csak helyi összesített darabszámokat tárol, egyéni visszajelzések és felvételekre mutató hivatkozások nélkül, és nem küld vizsgálati adatokat. Kikapcsoláskor a vizsgálat összesítése törlődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setelah Anda ikut serta, rekaman baru dapat menerima undangan penilaian diri secara acak. Ringkasan dipisahkan menurut arah latihan yang dipilih saat perekaman dimulai. Masukan diminta sebelum skor muncul dan dapat dilewati. Rekaman sementara tetap berada di perangkat ini selama menunggu. Saat aplikasi di latar depan, analisis biasanya berlanjut setelah 30 detik; penangguhan oleh sistem dapat menunda pemrosesan dan pembersihan. Studi hanya menyimpan hitungan agregat secara lokal, tanpa menyimpan setiap masukan secara terpisah atau mengaitkannya dengan rekaman, dan tidak mengirim data studi apa pun. Menonaktifkan ini akan menghapus ringkasan studi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se scegli di partecipare, le nuove registrazioni potranno ricevere un invito casuale all'autovalutazione. I riepiloghi sono separati in base all'obiettivo di pratica scelto all'inizio della registrazione. Le risposte vengono richieste prima che appaiano i punteggi e possono essere saltate. Durante l'attesa, la registrazione temporanea resta su questo dispositivo. In primo piano, l'analisi normalmente continua dopo 30 secondi; la sospensione del sistema può ritardare l'elaborazione e la rimozione dei dati temporanei. Lo studio salva solo conteggi riepilogativi locali, senza risposte individuali o collegamenti alle registrazioni, e non invia dati dello studio. Disattivandolo si cancella il riepilogo dello studio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "参加すると、新しい録音で自己評価をランダムにお願いすることがあります。集計は録音開始時に選んだ練習方向ごとに分けられます。回答はスコア表示前に求められ、スキップできます。待機中の一時録音はこの端末内に留まります。アプリが前面にある場合、通常は30秒後に分析が再開しますが、システムによる動作の中断で処理や削除が遅れることがあります。この比較では端末内に集計数だけを保存し、個別の回答記録や録音との関連付けは作らず、比較データも送信しません。オフにすると、この比較の集計が消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "참여를 선택하면 새 녹음에서 무작위로 자기 평가를 요청할 수 있어요. 요약은 녹음을 시작할 때 선택한 연습 방향별로 나눠요. 점수가 나타나기 전에 응답을 요청하며 건너뛸 수 있어요. 기다리는 동안 임시 녹음은 이 기기에만 남아요. 앱이 화면에 열려 있으면 보통 30초 후에 분석이 계속되지만, 시스템이 앱 실행을 일시 중단하면 처리와 삭제가 늦어질 수 있어요. 이 비교는 기기 내 요약 횟수만 저장하며, 개별 응답 기록이나 녹음과의 연결은 만들지 않고 비교 데이터를 전송하지 않아요. 끄면 이 비교의 요약이 지워져요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selepas anda bersetuju untuk menyertai, rakaman baharu mungkin menerima jemputan penilaian kendiri secara rawak. Ringkasan diasingkan mengikut arah latihan yang dipilih semasa rakaman bermula. Maklum balas diminta sebelum skor dipaparkan dan boleh dilangkau. Rakaman sementara kekal pada peranti ini semasa menunggu. Semasa aplikasi di latar depan, analisis biasanya diteruskan selepas 30 saat; penggantungan oleh sistem mungkin melambatkan pemprosesan dan pembersihan. Kajian hanya menyimpan kiraan ringkasan setempat, tanpa rekod maklum balas individu atau pautan kepada rakaman, dan tidak menghantar sebarang data kajian. Mematikan ini akan mengosongkan ringkasan kajian."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je deelneemt, kun je bij nieuwe opnamen willekeurig een uitnodiging voor een zelfbeoordeling krijgen. Samenvattingen worden gescheiden op basis van het oefendoel dat je bij het starten van de opname kiest. Feedback wordt gevraagd voordat de scores verschijnen en kan worden overgeslagen. De tijdelijke opname blijft tijdens het wachten op dit apparaat. Op de voorgrond gaat de analyse normaal gesproken na 30 seconden verder; opschorting door het systeem kan de verwerking en het opruimen vertragen. Het onderzoek bewaart alleen lokale samenvattende aantallen, zonder afzonderlijke feedbackgegevens of koppelingen naar opnamen, en verstuurt geen onderzoeksgegevens. Uitschakelen wist de onderzoekssamenvatting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po wyrażeniu zgody na udział przy nowych nagraniach mogą losowo pojawiać się zaproszenia do samooceny. Podsumowania są rozdzielane według kierunku ćwiczenia wybranego przy rozpoczęciu nagrywania. Odpowiedź jest zbierana przed pokazaniem wyników i można ją pominąć. Podczas oczekiwania tymczasowe nagranie pozostaje na tym urządzeniu. Na pierwszym planie analiza zwykle wznawia się po 30 sekundach; zawieszenie aplikacji przez system może opóźnić przetwarzanie i usunięcie danych. Badanie zapisuje tylko lokalne liczniki zbiorcze, bez pojedynczych odpowiedzi i powiązań z nagraniami, i nie wysyła danych badania. Wyłączenie usuwa podsumowanie badania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ao optar por participar, novas gravações poderão receber um convite aleatório para autoavaliação. Os resumos são separados pelo objetivo de prática escolhido no início da gravação. As respostas são solicitadas antes de as pontuações aparecerem e podem ser puladas. A gravação temporária permanece neste dispositivo durante a espera. Em primeiro plano, a análise normalmente continua após 30 segundos; a suspensão do sistema pode atrasar o processamento e a limpeza. O estudo salva apenas contagens resumidas locais, sem respostas individuais nem vínculos com gravações, e não envia dados do estudo. Desativar esta opção limpa o resumo do estudo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После согласия на участие для новых записей могут случайным образом появляться приглашения к самооценке. Сводки разделяются по направлению тренировки, выбранному в начале записи. Ответ запрашивается до показа оценок, его можно пропустить. Во время ожидания временная запись остаётся на этом устройстве. Когда приложение на переднем плане, анализ обычно продолжается через 30 секунд; приостановка работы системой может задержать обработку и удаление данных. Исследование сохраняет на устройстве только сводные счётчики, без отдельных ответов и связей с записями, и не отправляет данные исследования. Отключение очищает сводку исследования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om du väljer att delta kan nya inspelningar slumpmässigt få en inbjudan till självskattning. Sammanfattningar delas upp efter det övningsmål du väljer när inspelningen startar. Återkoppling efterfrågas innan poängen visas och kan hoppas över. Den tillfälliga inspelningen stannar på den här enheten under väntetiden. I förgrunden fortsätter analysen normalt efter 30 sekunder; om systemet pausar appen kan bearbetning och rensning fördröjas. Studien sparar bara lokala sammanfattade antal, utan enskilda återkopplingsposter eller länkar till inspelningar, och skickar inga studiedata. Om du stänger av studien rensas dess sammanfattning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หลังยินยอมเข้าร่วม บันทึกเสียงใหม่อาจได้รับคำเชิญให้ประเมินตนเองแบบสุ่ม สรุปจะแยกตามแนวทางการฝึกที่เลือกเมื่อเริ่มบันทึกเสียง ระบบขอความคิดเห็นก่อนแสดงคะแนนและสามารถข้ามได้ ระหว่างรอ เสียงชั่วคราวจะอยู่ในอุปกรณ์นี้ เมื่อแอปอยู่เบื้องหน้า การวิเคราะห์มักดำเนินต่อหลัง 30 วินาที การที่ระบบพักแอปอาจทำให้การประมวลผลและการล้างข้อมูลล่าช้า การศึกษาบันทึกเฉพาะยอดสรุปในเครื่อง ไม่มีบันทึกความคิดเห็นรายครั้งหรือการเชื่อมโยงกับเสียงที่บันทึก และไม่ส่งข้อมูลการศึกษาใดออกไป การปิดจะล้างสรุปการศึกษา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Katılmayı seçtikten sonra yeni kayıtlar rastgele bir öz değerlendirme daveti alabilir. Özetler, kayıt başladığında seçilen çalışma yönüne göre ayrılır. Geri bildirim puanlar gösterilmeden önce istenir ve atlanabilir. Beklerken geçici kayıt bu cihazda kalır. Uygulama ön plandayken analiz normalde 30 saniye sonra devam eder; sistemin uygulamayı askıya alması işleme ve temizliği geciktirebilir. Çalışma yalnızca yerel özet sayımları saklar; tekil geri bildirim kayıtları veya ses kayıtlarıyla bağlantılar tutmaz ve hiçbir çalışma verisi göndermez. Kapatmak, çalışma özetini temizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після згоди на участь для нових записів можуть випадково з’являтися запрошення до самооцінки. Зведення розділяються за напрямом тренування, вибраним на початку запису. Відповідь запитується до показу оцінок, її можна пропустити. Під час очікування тимчасовий запис залишається на цьому пристрої. Коли застосунок на передньому плані, аналіз зазвичай продовжується через 30 секунд; призупинення роботи системою може затримати обробку й очищення. Дослідження зберігає на пристрої лише зведені лічильники, без окремих відповідей чи зв’язків із записами, і не надсилає дані дослідження. Вимкнення очищає зведення дослідження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sau khi bạn đồng ý tham gia, bản ghi âm mới có thể nhận được lời mời tự đánh giá ngẫu nhiên. Tóm tắt được tách theo hướng luyện tập đã chọn khi bắt đầu ghi âm. Phản hồi được yêu cầu trước khi hiển thị điểm và có thể bỏ qua. Bản ghi âm tạm thời vẫn nằm trên thiết bị này trong lúc chờ. Khi ứng dụng ở tiền cảnh, phân tích thường tiếp tục sau 30 giây; việc hệ thống tạm ngưng ứng dụng có thể làm chậm xử lý và dọn dẹp. Nghiên cứu chỉ lưu số đếm tổng hợp trên thiết bị, không lưu từng phản hồi hay liên kết với bản ghi âm, và không gửi bất kỳ dữ liệu nghiên cứu nào. Tắt tính năng này sẽ xóa tóm tắt nghiên cứu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，对新录音随机邀请一次自评，并按当次练习方向分别汇总。反馈在显示分数前填写，可跳过。等待时临时录音会留在本机；前台通常在 30 秒后继续分析，系统暂停运行可能延迟处理与清理。实验仅在本机保存汇总计数，不建立逐次自评记录或录音关联，也不发送实验资料。关闭会清空本实验汇总。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，新錄音可能隨機收到自評邀請，並依開始錄音時選擇的練習方向分別彙整。回饋在顯示分數前填寫，也可以略過。等待期間，暫存錄音會留在本機；在前景時通常會於 30 秒後繼續分析，系統暫停執行可能延後處理與清除。實驗僅在本機儲存彙整計數，不建立個別自評紀錄或與錄音的關聯，也不傳送實驗資料。關閉會清除本實驗摘要。"
          }
        }
      }
    },
