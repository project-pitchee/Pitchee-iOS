    "analysis.emptyState.noResult.description": {
      "comment": "Instructional fallback that sends the user back to the recording screen to record a new natural-speech sample.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عُد إلى شاشة التسجيل وسجّل مقطعًا آخر من الكلام الطبيعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraťte se k nahrávání a nahrajte další ukázku přirozené řeči."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbage til optagelsen, og optag en ny prøve med naturlig tale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geh zurück zur Aufnahme und nimm eine weitere Probe natürlicher Sprache auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Επιστρέψτε στην εγγραφή και ηχογραφήστε ένα ακόμη δείγμα φυσικής ομιλίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to recording and record another sample of natural speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a Grabación y graba otra muestra de habla natural."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palaa tallennukseen ja nauhoita uusi näyte luonnollista puhetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revenez à l’enregistrement et enregistrez un nouvel échantillon de parole naturelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חזרו להקלטה והקליטו דוגמה נוספת של דיבור טבעי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रेकॉर्डिंग पर वापस जाकर स्वाभाविक बोलचाल का एक और नमूना रिकॉर्ड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrati se na snimanje i snimi novi uzorak prirodnog govora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menj vissza a felvételhez, és rögzíts egy újabb természetes beszédmintát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembali ke layar Rekam dan rekam lagi sampel suara yang alami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Torna alla registrazione e registra un altro campione di parlato naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "録音画面に戻って、自然な話し声をもう一度録ってみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "녹음 화면으로 돌아가 자연스럽게 말한 샘플을 다시 녹음해 보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembali ke skrin rakaman dan rakam satu lagi sampel pertuturan semula jadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ga terug naar Opnemen en neem een nieuw fragment natuurlijke spraak op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wróć do nagrywania i nagraj kolejną próbkę naturalnej mowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volte para a gravação e grave outra amostra de fala natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вернитесь к записи и запишите ещё один образец естественной речи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tillbaka till inspelningen och spela in ett nytt exempel på naturligt tal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กลับไปที่หน้าบันทึกเสียง แล้วอัดเสียงพูดตามธรรมชาติอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kayıt ekranına dönüp yeni bir doğal konuşma örneği kaydet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поверніться до запису й запишіть новий зразок природного мовлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy quay lại mục ghi âm và thu thêm một đoạn nói tự nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请返回录制，再录一段自然说话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請返回錄製，再錄一段自然說話。"
          }
        }
      }
    },
    "analysis.emptyState.noResult.title": {
      "comment": "Heading of the empty state on the analysis screen when no result exists (analysis cancelled or failed). Neutral tone: the user's voice was not judged.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يكتمل هذا التحليل"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analýza se tentokrát nedokončila"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analysen blev ikke gennemført"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Analyse wurde nicht abgeschlossen"
          }
        },
        "el": {
