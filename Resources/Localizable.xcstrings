    "export.report.emptyState.message": {
      "comment": "Instruction under the empty-state title.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عُد إلى شاشة التصدير واختر مخططات أو بيانات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vraťte se na obrazovku exportu a vyberte grafy nebo data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gå tilbage til eksportskærmen, og vælg diagrammer eller data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geh zurück zum Export und wähle Diagramme oder Daten aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Επιστρέψτε στην οθόνη εξαγωγής και επιλέξτε γραφήματα ή δεδομένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the export screen and select charts or data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a la pantalla de exportación y selecciona gráficos o datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palaa vientinäkymään ja valitse kaavioita tai tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Revenez à l’écran d’export et sélectionnez des graphiques ou des données."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חזרו למסך הייצוא ובחרו תרשימים או נתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक्सपोर्ट स्क्रीन पर लौटकर चार्ट या डेटा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vrati se na zaslon za izvoz i odaberi grafikone ili podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Térj vissza az exportálás képernyőre, és válassz grafikonokat vagy adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembali ke layar ekspor dan pilih grafik atau data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Torna alla schermata di esportazione e seleziona grafici o dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "書き出し画面に戻り、グラフまたはデータを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "내보내기 화면으로 돌아가 차트나 데이터를 선택해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kembali ke skrin eksport dan pilih carta atau data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ga terug naar het exportscherm en selecteer grafieken of gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wróć do ekranu eksportu i wybierz wykresy lub dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
