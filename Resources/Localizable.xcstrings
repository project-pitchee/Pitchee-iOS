        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eğrilerdeki boşluklar o zaman aralığında güvenilir sonuç olmadığını gösterir; üç eğri de aynı zaman eksenini paylaşır."
          }
        },
        "uk": {
          "stringUnit": {
