    "scoring.rules.continuous.description": {
      "comment": "Plain-language summary for the default rule. 'Base' is the pre-rule score and stays untranslated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يُفعَّل أي حد خاص هذه المرة، لذا تستخدم النتيجة الإجمالية Base مباشرة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tentokrát se nespustilo žádné zvláštní omezení, a celkové skóre proto použije přímo Base."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denne gang blev der ikke udløst nogen særlig begrænsning, så den samlede score bruger Base direkte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diesmal wurde keine besondere Grenze ausgelöst, daher verwendet die Gesamtbewertung direkt Base."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ενεργοποιήθηκε κάποιος ειδικός περιορισμός αυτή τη φορά, οπότε η συνολική βαθμολογία χρησιμοποιεί απευθείας το Base."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No special limit was triggered this time, so the overall score uses Base directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta vez no se activó ningún límite especial, así que el puntaje general usa Base directamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tällä kertaa erityisrajoituksia ei lauennut, joten kokonaispisteet tulevat suoraan Base-arvosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune limite particulière n’a été déclenchée cette fois : le score global reprend directement Base."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הפעם לא הופעלה הגבלה מיוחדת, ולכן הציון הכולל מבוסס ישירות על Base."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस बार कोई खास सीमा लागू नहीं हुई, इसलिए कुल स्कोर सीधे Base से लिया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ovaj put nije pokrenuto nikakvo posebno ograničenje pa ukupna ocjena izravno koristi Base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezúttal nem lépett érvénybe különleges korlátozás, ezért az összpontszám közvetlenül a Base értékét használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak ada batas khusus yang terpicu kali ini, sehingga skor keseluruhan langsung memakai Base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa volta non è stato attivato alcun limite speciale, quindi il punteggio complessivo usa direttamente Base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今回は特別な制限が適用されなかったため、総合スコアは Base をそのまま使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번에는 특별한 제한이 적용되지 않아 종합 점수가 Base를 그대로 사용해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada had khas dicetuskan kali ini, jadi skor keseluruhan menggunakan Base secara terus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deze keer is er geen speciale beperking toegepast; de totaalscore gebruikt direct Base."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tym razem nie uruchomiono żadnego specjalnego ograniczenia, więc wynik ogólny używa wartości Base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum limite especial foi acionado nesta análise, então a pontuação geral usa Base diretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Особых ограничений в этот раз не возникло, поэтому общая оценка напрямую использует Base."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen särskild begränsning utlöstes den här gången, så totalpoängen använder Base direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ครั้งนี้ไม่มีข้อจำกัดพิเศษใดทำงาน คะแนนรวมจึงใช้ Base โดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kez özel bir sınırlama devreye girmedi; genel puan doğrudan Base değerini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цього разу спеціальних обмежень не спрацювало, тому загальна оцінка бере Base напряму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần này không có giới hạn đặc biệt nào được kích hoạt, nên điểm tổng hợp dùng trực tiếp Base."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没有触发特殊限制，综合分直接使用 Base。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這次沒有觸發特殊限制，綜合分直接使用 Base。"
          }
        }
      }
    },
