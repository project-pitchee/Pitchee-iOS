    "settings.privateStorage.unavailable.description" : {
      "comment" : "Shown when protected local storage cannot be opened. Existing history is retained.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح قفل الجهاز وأعد فتح التطبيق. لم تُعَد تهيئة السجلات الحالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odemkněte zařízení a znovu otevřete aplikaci. Stávající záznamy nebyly resetovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lås enheden op, og åbn appen igen. Eksisterende registreringer er ikke blevet nulstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entsperre das Gerät und öffne die App erneut. Vorhandene Datensätze wurden nicht zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ξεκλειδώστε τη συσκευή και ανοίξτε ξανά την εφαρμογή. Οι υπάρχουσες καταχωρίσεις δεν έχουν μηδενιστεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock the device and reopen the app. Existing records have not been reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desbloquea el dispositivo y vuelve a abrir la app. Los registros existentes no se han restablecido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avaa laitteen lukitus ja avaa sovellus uudelleen. Olemassa olevia tietueita ei ole nollattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déverrouillez l’appareil et rouvrez l’app. Les enregistrements existants n’ont pas été réinitialisés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בטלו את נעילת המכשיר ופתחו מחדש את היישום. הרשומות הקיימות לא אופסו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिवाइस अनलॉक करके ऐप दोबारा खोलें। मौजूदा रिकॉर्ड रीसेट नहीं हुए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otključaj uređaj i ponovno otvori aplikaciju. Postojeći zapisi nisu poništeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oldd fel az eszközt, és nyisd meg újra az appot. A meglévő bejegyzések nem lettek alaphelyzetbe állítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka kunci perangkat dan buka kembali aplikasi. Catatan yang ada belum direset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sblocca il dispositivo e riapri l'app. I record esistenti non sono stati reimpostati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "端末のロックを解除し、アプリを開き直してください。既存の記録はリセットされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기의 잠금을 해제한 다음 앱을 다시 열어 주세요. 기존 기록은 초기화되지 않았어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka kunci peranti dan buka semula aplikasi. Rekod sedia ada tidak ditetapkan semula."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ontgrendel het apparaat en open de app opnieuw. Bestaande registraties zijn niet gereset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odblokuj urządzenie i ponownie otwórz aplikację. Istniejące zapisy nie zostały zresetowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desbloqueie o dispositivo e reabra o app. Os registros existentes não foram redefinidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разблокируйте устройство и снова откройте приложение. Существующие записи не были сброшены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lås upp enheten och öppna appen igen. Befintliga poster har inte återställts."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ปลดล็อกอุปกรณ์แล้วเปิดแอปใหม่ ข้อมูลเดิมยังไม่ถูกรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cihazın kilidini aç ve uygulamayı yeniden aç. Mevcut kayıtlar sıfırlanmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розблокуйте пристрій і знову відкрийте застосунок. Наявні записи не було скинуто."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mở khóa thiết bị rồi mở lại ứng dụng. Các bản ghi hiện có chưa bị đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请解锁设备后重新打开 App。现有记录没有被重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請解鎖裝置後重新開啟 App。現有紀錄並未重設。"
          }
        }
      }
    },
