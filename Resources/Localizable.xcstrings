    "export.chart.loudnessScale.note": {
      "comment": "Caption explaining the dBFS scale when both loudness curves are shown.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُعرض جهارة الصوت والجهارة الخلفية بوحدة dBFS؛ وكلما اقتربت القيمة من 0 كان الصوت أعلى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hlasitost řeči i pozadí se uvádí v dBFS; hodnoty blíž k nule znamenají vyšší hlasitost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tale- og baggrundslydstyrke vises i dBFS; værdier tættere på 0 er kraftigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprach- und Hintergrundlautstärke werden in dBFS angezeigt; je näher der Wert bei 0 liegt, desto lauter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η ένταση φωνής και η ένταση περιβάλλοντος εμφανίζονται σε dBFS· όσο πιο κοντά στο 0, τόσο πιο δυνατά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice and background loudness are shown in dBFS; values closer to 0 are louder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El volumen de la voz y el de fondo se muestran en dBFS; los valores más cercanos a 0 son más fuertes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puheen ja taustan voimakkuus näytetään dBFS-yksikkönä; mitä lähempänä arvo on nollaa, sitä kovempi ääni on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le niveau sonore de la voix et celui de l’arrière-plan sont exprimés en dBFS ; plus la valeur approche de 0, plus le son est fort."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "עוצמת הדיבור והרקע מוצגות ב-dBFS; ככל שהערך קרוב יותר ל-0, הקול חזק יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ और परिवेशी तीव्रता dBFS में दिखाई जाती है; 0 के करीब के मान ज़्यादा तेज़ होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Glasnoća govora i pozadine prikazuje se u dBFS; vrijednosti bliže nuli znače veću glasnoću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A beszéd és a háttér hangereje dBFS-ben jelenik meg; a 0-hoz közelebbi értékek hangosabbak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenyaringan suara dan latar ditampilkan dalam dBFS; nilai yang lebih dekat ke 0 berarti lebih keras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il volume della voce e quello di fondo sono in dBFS; i valori più vicini a 0 sono più alti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声と背景の音量は dBFS で示し、0 に近いほど大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 음량과 배경 음량은 dBFS로 표시하며 0에 가까울수록 커요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenyaringan suara dan latar ditunjukkan dalam dBFS; nilai yang lebih hampir kepada 0 lebih kuat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stem- en achtergrondluidheid worden weergegeven in dBFS; waarden dichter bij 0 zijn luider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Głośność mowy i tła podawana jest w dBFS; wartości bliższe 0 oznaczają większą głośność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O volume da voz e o volume de fundo aparecem em dBFS; valores mais próximos de 0 são mais altos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Громкость речи и фона показана в dBFS: чем ближе значение к 0, тем громче."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Röstens och bakgrundens ljudnivå visas i dBFS; ju närmare 0 värdet ligger, desto starkare är ljudet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความดังของเสียงพูดและความดังพื้นหลังแสดงเป็น dBFS ค่ายิ่งใกล้ 0 ยิ่งดัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konuşma ve arka plan ses düzeyi dBFS ile gösterilir; değer 0'a yaklaştıkça ses yükselir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Гучність голосу та фону подано в dBFS; що ближче значення до 0, то гучніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Âm lượng giọng nói và âm lượng nền được hiển thị bằng dBFS; giá trị càng gần 0 càng to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音响度与背景响度以 dBFS 表示，数值越接近 0 越响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "語音響度與背景響度以 dBFS 表示，數值越接近 0 越響。"
          }
        }
      }
    },
    "export.chart.multiCurveGap.note": {
      "comment": "Explains gaps in the plotted lines when pitch and loudness curves are shown together.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الفراغات في المنحنيات تعني عدم وجود نتيجة موثوقة في تلك الفترة الزمنية؛ وتشترك المنحنيات الثلاثة في المحور الزمني نفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prázdná místa v křivkách znamenají, že v daném úseku není spolehlivý výsledek; všechny křivky sdílejí stejnou časovou osu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Huller i kurverne betyder, at der ikke er et pålideligt resultat for det tidsrum; alle tre kurver bruger samme tidsakse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lücken in den Kurven bedeuten, dass für diesen Zeitraum kein verlässliches Ergebnis vorliegt; alle Kurven nutzen dieselbe Zeitachse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Τα κενά στις καμπύλες σημαίνουν ότι δεν υπάρχει αξιόπιστο αποτέλεσμα για αυτό το διάστημα· όλες οι καμπύλες μοιράζονται τον ίδιο άξονα χρόνου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
