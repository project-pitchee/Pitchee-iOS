    "insights.activity.description" : {
      "comment" : "Clarifies how local activity dates differ from saved recording dates.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحسب أيام الفتح حسب تواريخ زيارة الشاشة الرئيسية، مرة واحدة في اليوم. وتُحسب أيام التسجيل حسب التواريخ التي تتضمن تحليلات محفوظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dny používání počítají data návštěvy hlavní obrazovky, nejvýše jednou za den. Dny nahrávání počítají data s uloženými analýzami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brugsdage tæller datoer, hvor startskærmen blev besøgt, én gang pr. dag. Optagedage tæller datoer med gemte analyser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnungstage zählen jeden Tag mit einem Besuch der Startseite einmal. Aufnahmetage zählen Tage mit gespeicherten Analysen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι ημέρες χρήσης μετρούν τις ημερομηνίες επίσκεψης στην αρχική οθόνη, μία φορά ανά ημέρα. Οι ημέρες εγγραφής μετρούν τις ημερομηνίες με αποθηκευμένες αναλύσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opened days count dates when the home screen was visited, once per day. Recording days count dates with saved analyses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los días de uso cuentan las fechas en que se visitó la pantalla de inicio, una vez al día. Los días de grabación cuentan las fechas con análisis guardados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käyttöpäivät lasketaan päivämääristä, jolloin aloitusnäytössä on käyty, kerran päivässä. Tallennuspäivät lasketaan päivämääristä, joille on tallennettu analyysejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les jours d’ouverture comptent une seule fois chaque date où l’accueil a été consulté. Les jours d’enregistrement comptent les dates avec une analyse sauvegardée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ימי פתיחה נספרים לפי תאריכים שבהם ביקרתם במסך הבית, פעם אחת ביום. ימי הקלטה נספרים לפי תאריכים שבהם נשמרו ניתוחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐप खोलने के दिन उन तारीखों से गिने जाते हैं जब होम स्क्रीन देखी गई हो, दिन में एक बार। रिकॉर्डिंग के दिन उन तारीखों से गिने जाते हैं जिनके विश्लेषण सेव हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dani korištenja broje datume otvaranja početnog zaslona, jednom dnevno. Dani snimanja broje datume sa spremljenim analizama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A használati napok azok a dátumok, amikor megnyitottad a kezdőképernyőt, naponta egyszer számolva. A felvételi napok a mentett elemzéssel rendelkező dátumokat számolják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hari dibuka dihitung dari tanggal saat halaman utama dikunjungi, satu kali per hari. Hari merekam dihitung dari tanggal dengan analisis tersimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I giorni di utilizzo contano le date in cui è stata visitata la schermata iniziale, una sola volta al giorno. I giorni di registrazione contano le date con analisi salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "利用日数はホーム画面を開いた日を1日1回として数えます。録音日数は分析を保存した日を数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이용 일수는 홈 화면을 연 날짜를 하루에 한 번씩 세어요. 녹음 일수는 분석 결과가 저장된 날짜를 세어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hari dibuka dikira mengikut tarikh skrin utama dilawati, sekali sehari. Hari rakaman dikira mengikut tarikh yang mempunyai analisis tersimpan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruiksdagen tellen de datums waarop het beginscherm is bezocht, eenmaal per dag. Opnamedagen tellen de datums met opgeslagen analyses."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dni używania to daty otwarcia ekranu głównego, liczone raz dziennie. Dni nagrywania to daty z zapisanymi analizami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os dias de uso contam as datas em que a tela inicial foi visitada, uma vez por dia. Os dias de gravação contam as datas com análises salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дни использования — это даты посещения главного экрана, не более одного раза в день. Дни записи — даты, за которые сохранены анализы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Användningsdagar räknar datum då hemskärmen besöktes, en gång per dag. Inspelningsdagar räknar datum med sparade analyser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "จำนวนวันที่เปิดแอปนับจากวันที่เข้าหน้าหลัก โดยนับวันละหนึ่งครั้ง จำนวนวันที่บันทึกเสียงนับจากวันที่มีผลวิเคราะห์ที่บันทึกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Açılan günler, ana ekranın ziyaret edildiği tarihlerden günde bir kez sayılır. Kayıt günleri, kaydedilmiş analizlerin bulunduğu tarihlerden sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дні використання — це дати відкриття головного екрана, не більше одного разу на день. Дні запису — дати зі збереженими аналізами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Số ngày mở ứng dụng tính theo ngày truy cập màn hình chính, mỗi ngày một lần. Số ngày ghi âm tính theo ngày có bản phân tích đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开天数按进入首页的日期计数，同一天只记一次；录音天数按已保存的分析记录计数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開天數按進入首頁的日期計數，同一天只記一次；錄音天數按已儲存的分析記錄計數。"
          }
        }
      }
    },
