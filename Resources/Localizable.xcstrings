        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A naturalidade foi boa desta vez; continue relaxado e com uma fala fluida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "С естественностью в этот раз всё хорошо — сохраняйте расслабленную и связную речь."
