    "analysis.resources.voiceResearch.description": {
      "comment": "Body text in the resource detail sheet; educational framing, no medical claims.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرّف على العلاقة بين طبقة الصوت والطبيعية وظروف التسجيل، وتعامل مع النتائج كمرجع للتدريب على المدى الطويل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zjistěte, jak spolu souvisí výška hlasu, přirozenost a podmínky nahrávání, a berte výsledky jako referenci pro dlouhodobé cvičení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lær, hvordan tonehøjde, naturlighed og optagelsesforhold hænger sammen, og brug resultaterne som reference for din træning over tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erfahre, wie Tonhöhe, Natürlichkeit und Aufnahmebedingungen zusammenhängen, und nutze die Ergebnisse als langfristige Orientierung für deine Übungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μάθετε πώς συνδέονται το ύψος, η φυσικότητα και οι συνθήκες ηχογράφησης, και δείτε τα αποτελέσματα ως αναφορά μακροπρόθεσμης εξάσκησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn how pitch, naturalness, and recording conditions relate to each other, and treat the results as a long-term practice reference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descubre cómo se relacionan el tono, la naturalidad y las condiciones de grabación, y usa los resultados como referencia para practicar a largo plazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opi, miten sävelkorkeus, luonnollisuus ja tallennusolosuhteet liittyvät toisiinsa, ja käytä tuloksia pitkän aikavälin harjoittelun tukena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Découvrez les liens entre hauteur, naturel et conditions d’enregistrement, et voyez vos résultats comme une référence pour progresser dans la durée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "למדו כיצד טון, טבעיות ותנאי הקלטה משפיעים זה על זה, והתייחסו לתוצאות כאל ייחוס לתרגול ארוך טווח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जानें कि पिच, स्वाभाविकता और रिकॉर्डिंग की परिस्थितियाँ एक-दूसरे से कैसे जुड़ी हैं, और नतीजों को लंबे समय के अभ्यास के संदर्भ की तरह देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saznaj kako su visina glasa, prirodnost i uvjeti snimanja povezani te rezultate koristi kao dugoročnu referencu za vježbanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ismerd meg, hogyan függ össze a hangmagasság, a természetesség és a felvételi körülmények, és tekintsd az eredményeket hosszú távú gyakorlási viszonyítási alapnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelajari hubungan antara nada, kealamian, dan kondisi perekaman, lalu jadikan hasilnya sebagai acuan latihan jangka panjang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scopri come tono, naturalezza e condizioni di registrazione sono collegati e usa i risultati come riferimento per la pratica nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音高・自然度・録音条件の関係を知り、結果を長期的な練習の参考にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음높이와 자연스러움, 녹음 조건이 어떻게 연결되는지 알아보고 결과는 꾸준한 연습의 참고로 활용해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pelajari bagaimana pic, kewajaran dan keadaan rakaman saling berkaitan, dan anggap hasilnya sebagai rujukan latihan jangka panjang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lees hoe toonhoogte, natuurlijkheid en opnameomstandigheden samenhangen, en gebruik de resultaten als referentie voor je oefening op de lange termijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poznaj zależności między wysokością głosu, naturalnością i warunkami nagrania, a wyniki traktuj jako odniesienie w długofalowej praktyce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entenda como altura, naturalidade e condições de gravação se relacionam, e use os resultados como referência para o treino ao longo do tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Узнайте, как связаны высота тона, естественность и условия записи, и относитесь к результатам как к ориентиру для регулярной практики."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lär dig hur tonhöjd, naturlighet och inspelningsförhållanden hänger ihop, och se resultaten som en referens för långsiktig träning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ทำความเข้าใจว่าละดับเสียง ความเป็นธรรมชาติ และสภาพการบันทึกเสียงสัมพันธ์กันอย่างไร แล้วใช้ผลลัพธ์เป็นข้อมูลอ้างอิงสำหรับการฝึกในระยะยาว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perde, doğallık ve kayıt koşullarının birbiriyle ilişkisini öğren; sonuçları uzun vadeli alıştırma referansı olarak gör."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дізнайтеся, як пов’язані висота тону, природність і умови запису, і ставтеся до результатів як до орієнтиру для тривалої практики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tìm hiểu mối liên hệ giữa cao độ, độ tự nhiên và điều kiện ghi âm, rồi xem kết quả là thông tin tham khảo cho quá trình luyện tập lâu dài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解音高、自然度与录音条件之间的关系，把结果当成长期练习的参考。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "了解音高、自然度與錄音條件之間的關係，把結果當成長期練習的參考。"
          }
        }
      }
    },
