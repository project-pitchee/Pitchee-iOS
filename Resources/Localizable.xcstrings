    "settings.voicePreference.autosaveNote": {
      "comment": "Trust-building note: state clearly that the preference has no effect on scoring. Keep both sentences.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يُحفظ اختيارك تلقائيًا ويسجّل الاتجاه الذي تتدرّب عليه. وهو لا يغيّر نتائج تحليل صوتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Volba se ukládá automaticky a zaznamenává směr, kterým cvičíte. Skóre analýzy to nijak nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valget gemmes automatisk og registrerer den retning, du øver i. Det påvirker ikke scorerne i din analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Auswahl wird automatisch gespeichert und hält deine Übungsrichtung fest. Sie verändert deine Analysebewertungen nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η επιλογή σας αποθηκεύεται αυτόματα και καταγράφει την κατεύθυνση της εξάσκησής σας. Δεν επηρεάζει τη βαθμολογία της ανάλυσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choice is saved automatically and records the direction you are practicing. It does not change your analysis scores."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu elección se guarda automáticamente y registra la dirección que practicas. No cambia los puntajes de tus análisis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valinta tallennetaan automaattisesti, ja se kertoo harjoittelusi suunnasta. Nykyinen valinta ei vaikuta analyysin pisteisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre choix est enregistré automatiquement et retient la direction dans laquelle vous travaillez. Il ne change rien aux scores de l’analyse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הבחירה נשמרת אוטומטית ומתעדת את כיוון התרגול שלכם. היא לא משנה את ציוני הניתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी पसंद अपने आप सेव हो जाती है और आपकी अभ्यास की दिशा दर्ज करती है। इससे विश्लेषण के स्कोर नहीं बदलते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odabir se sprema automatski i pamti smjer u kojem vježbaš. Ne mijenja ocjene analize."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A választásod automatikusan mentődik, és rögzíti a gyakorlási irányodat. Az elemzések pontszámait nem befolyásolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan Anda disimpan otomatis dan mencatat arah latihan Anda. Preferensi ini tidak mengubah skor analisis Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La scelta viene salvata automaticamente e ricorda la direzione su cui ti stai allenando. Non modifica i punteggi dell'analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択は自動的に保存され、練習している方向性の記録として使われます。分析スコアには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택은 자동으로 저장되며 연습 방향을 기록해요. 현재 설정은 분석 점수에 영향을 주지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilihan anda disimpan secara automatik dan merekodkan arah latihan anda. Ia tidak mengubah skor analisis anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je keuze wordt automatisch opgeslagen en legt vast op welke richting je oefent. De keuze verandert niets aan je analysescores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybór zapisuje się automatycznie i określa kierunek ćwiczeń. Nie wpływa na wyniki analizy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua escolha é salva automaticamente e registra a direção que você está treinando. Ela não altera as pontuações da análise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выбор сохраняется автоматически и отмечает направление ваших тренировок. На оценки анализа он не влияет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt val sparas automatiskt och visar vilken riktning du tränar mot. Det påverkar inte dina analysresultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตัวเลือกจะถูกบันทึกอัตโนมัติ เพื่อใช้เป็นแนวทางในการฝึก ไม่มีผลต่อคะแนนการวิเคราะห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçimin otomatik kaydedilir ve çalıştığın yönü kaydeder. Tercihin analiz puanlarını değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш вибір зберігається автоматично й позначає напрям, який ви тренуєте. Він не впливає на оцінки аналізу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lựa chọn của bạn được lưu tự động và ghi lại hướng bạn đang luyện tập. Tùy chọn này không làm thay đổi điểm phân tích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择会自动保存，用于记录你的练习方向。当前偏好不会改变分析评分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇會自動儲存，用於記錄你的練習方向。目前偏好不會改變分析評分。"
          }
        }
      }
    },
    "settings.voicePreference.headline.subtitle": {
      "comment": "Reassures that either choice is valid and that the setting is reversible.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حدّد هدفًا واضحًا أو اكتشف فقط — يمكنك العودة والتعديل في أي وقت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zvolte si jasný cíl, nebo jen objevujte — kdykoli se můžete vrátit a změnit to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt et klart mål, eller udforsk først — du kan altid komme tilbage og justere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setz dir ein klares Ziel oder probier dich einfach aus – du kannst jederzeit zurückkommen und es anpassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Θέστε έναν σαφή στόχο ή απλώς εξερευνήστε — μπορείτε να επιστρέψετε και να το αλλάξετε όποτε θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a clear goal or just explore — you can come back and adjust anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Define un objetivo claro o simplemente explora; puedes volver y ajustarlo cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voit asettaa selkeän tavoitteen tai lähteä liikkeelle uteliaana. Voit palata muuttamaan valintaa milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fixez-vous un objectif précis ou explorez librement — vous pourrez revenir ajuster ce choix à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אפשר להציב מטרה ברורה או רק לחקור — תמיד אפשר לחזור ולשנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साफ़ लक्ष्य तय करें या सिर्फ़ खोजें — आप कभी भी लौटकर इसे बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Postavi jasan cilj ili samo istražuj — uvijek se možeš vratiti i promijeniti odabir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kitűzhetsz egy konkrét célt, vagy csak felfedezhetsz — bármikor visszatérhetsz és módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tetapkan tujuan yang jelas atau sekadar menjelajah — Anda bisa kembali dan menyesuaikannya kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poni un obiettivo chiaro o esplora liberamente: puoi tornare e modificare quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "明確な目標を決めても、まず探索するだけでもかまいません。いつでも戻って調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "목표를 분명히 세워도, 우선 탐색해도 괜찮아요. 언제든 돌아와 조정할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tetapkan sasaran yang jelas atau terus meneroka — anda boleh kembali dan mengubahnya bila-bila masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies een duidelijk doel of verken gewoon — je kunt altijd terugkomen om het aan te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Możesz mieć konkretny cel albo po prostu poznawać swój głos. Zawsze możesz wrócić i zmienić wybór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Defina um objetivo claro ou apenas explore — você pode voltar e ajustar quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Можно выбрать конкретную цель или просто исследовать — вернуться и всё изменить можно в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sätt ett tydligt mål eller utforska fritt – du kan komma tillbaka och ändra när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้งเป้าหมายให้ชัดเจน หรือแค่ลองสำรวจก็ได้ กลับมาปรับเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Net bir hedefin olabilir ya da yalnızca keşfedebilirsin. İstediğin zaman dönüp değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Поставте чітку мету або просто досліджуйте — сюди можна повернутися й змінити вибір будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt mục tiêu rõ ràng hoặc chỉ để khám phá — bạn luôn có thể quay lại điều chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以有明确的目标，也可以先探索。你随时都能回来调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可以有明確的目標，也可以先探索。你隨時都能回來調整。"
          }
        }
      }
    },
    "settings.voicePreference.headline.title": {
      "comment": "Same wording family as the onboarding preferences page; keep the two screens consistent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعثر على اتجاه صوتك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Najděte směr svého hlasu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Find din stemmeretning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finde deine Stimmrichtung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Βρείτε την κατεύθυνση της φωνής σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find your voice direction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encuentra tu dirección vocal"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Löydä äänesi suunta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trouvez votre direction vocale"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מצאו את כיוון הקול שלכם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी आवाज़ की दिशा खोजें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pronađi smjer svog glasa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Találd meg a hangod irányát"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temukan arah suara Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trova la direzione della tua voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "声の方向性を見つける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "나의 음성 방향 찾기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cari arah suara anda"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vind je stemrichting"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Znajdź kierunek dla swojego głosu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encontre sua direção vocal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Найдите направление для голоса"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitta din röstriktning"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ค้นหาแนวเสียงของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
