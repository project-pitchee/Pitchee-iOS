        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallennustaso on matala. Siirry hieman lähemmäs mikrofonia ja tallenna uudelleen mukavalla äänenvoimakkuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le niveau d’enregistrement est faible. Rapprochez-vous un peu du microphone et réenregistrez à un volume confortable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "רמת ההקלטה נמוכה. התקרבו מעט למיקרופון והקליטו שוב בעוצמה נוחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग का स्तर कम है। माइक्रोफ़ोन के थोड़ा करीब जाएँ और आरामदायक आवाज़ में फिर रिकॉर्ड करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Razina snimke je niska. Približi se malo mikrofonu i ponovno snimi ugodnom glasnoćom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
