          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apakah jenis suara yang anda inginkan?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wat voor stem wil je?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jaki kierunek głosu wybierasz?"
          }
        },
        "pt-BR": {
          "stringUnit": {
