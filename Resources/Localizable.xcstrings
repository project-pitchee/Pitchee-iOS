    "insights.metric.naturalness.caption" : {
      "comment" : "One-line explanation under the Naturalness metric row.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مدى اتساق الصوت وطبيعيته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak vyrovnaně a přirozeně hlas zní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvor sammenhængende og naturlig stemmen lyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie zusammenhängend und natürlich die Stimme klingt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πόσο σταθερή και φυσική ακούγεται η φωνή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How consistent and natural the voice sounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qué tan fluida y natural suena la voz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuinka sujuvalta ja luonnolliselta ääni kuulostaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À quel point la voix paraît fluide et naturelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עד כמה הקול נשמע רציף וטבעי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आवाज़ कितनी एकरूप और स्वाभाविक लगती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koliko glas zvuči ujednačeno i prirodno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mennyire folyamatos és természetes a hangzás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seberapa konsisten dan alami suara terdengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto la voce suona scorrevole e naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "声がどれだけ自然で滑らかに聞こえるか"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "목소리가 얼마나 이어지고 자연스럽게 들리는지"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sejauh mana suara kedengaran konsisten dan semula jadi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoe consistent en natuurlijk je stem klinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jak spójnie i naturalnie brzmi głos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O quanto a voz soa fluida e natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Насколько связно и естественно звучит голос."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hur jämn och naturlig rösten låter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับความต่อเนื่องและความเป็นธรรมชาติของเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
