    "export.chart.backgroundLoudness.note": {
      "comment": "Fallback caption for the background-loudness-only chart.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض المنحنى مستوى الضجيج المحيط عند عدم اكتشاف كلام، بوحدة dBFS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Křivka znázorňuje úroveň okolního hluku v době, kdy nebyla rozpoznána řeč, v dBFS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurven viser baggrundsstøjen, mens der ikke registreres tale, i dBFS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kurve zeigt das Umgebungsgeräusch, wenn keine Sprache erkannt wurde, in dBFS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η καμπύλη δείχνει τον θόρυβο περιβάλλοντος όταν δεν ανιχνεύεται ομιλία, σε dBFS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The curve shows the ambient noise floor while no speech was detected, in dBFS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La curva muestra el ruido de fondo mientras no se detecta voz, en dBFS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyrä näyttää ympäristön kohinatason ajalta, jolloin puhetta ei havaittu, yksikkönä dBFS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La courbe montre le bruit de fond lorsqu’aucune parole n’est détectée, en dBFS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העקומה מציגה את רצפת הרעש הסביבתי כשלא זוהה דיבור, ב-dBFS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह वक्र उस समय का परिवेशी शोर स्तर दिखाता है जब आवाज़ नहीं मिली, dBFS में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krivulja prikazuje razinu šuma okoline dok nije otkriven govor, u dBFS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A görbe a beszéd nélküli szakaszokban mért környezeti zajszintet mutatja dBFS-ben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurva ini menunjukkan dasar kebisingan lingkungan saat tidak ada suara yang terdeteksi, dalam dBFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La curva mostra il rumore di fondo mentre non viene rilevata voce, in dBFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この曲線は、音声が検出されていないときの周囲のノイズレベルを dBFS で示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 곡선은 음성이 감지되지 않은 구간의 주변 소음을 dBFS로 보여줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lengkung ini menunjukkan aras hingar persekitaran semasa tiada pertuturan dikesan, dalam dBFS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De curve toont de omgevingsruisvloer terwijl er geen spraak is gedetecteerd, in dBFS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krzywa pokazuje poziom szumu otoczenia, gdy nie wykryto mowy, w dBFS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A curva mostra o ruído de fundo enquanto nenhuma fala é detectada, em dBFS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кривая показывает уровень фонового шума, когда речь не обнаружена, в dBFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurvan visar bakgrundsbullret när inget tal upptäcktes, i dBFS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เส้นกราฟแสดงระดับเสียงรบกวนพื้นหลังในช่วงที่ตรวจไม่พบเสียงพูด หน่วยเป็น dBFS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eğri, konuşma algılanmadığında ortam gürültü tabanını dBFS cinsinden gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Крива показує рівень фонового шуму, коли мовлення не виявлено, у dBFS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đường cong thể hiện mức ồn nền khi chưa nhận diện được giọng nói, tính bằng dBFS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线显示未检测到语音时的环境底噪，单位为 dBFS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "曲線顯示未偵測到語音時的環境底噪，單位為 dBFS。"
          }
        }
      }
    },
