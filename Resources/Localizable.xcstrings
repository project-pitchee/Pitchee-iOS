    "practice.captions.failed" : {
      "comment" : "On-device practice captions. Audio and captions remain private and temporary; recognition must not fall back to a server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذر إنشاء التسميات التوضيحية. تأكد من توفر التعرف على الكلام على الجهاز لهذه اللغة، ثم حاول مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titulky se nepodařilo vytvořit. Ověřte, že je pro tento jazyk dostupné rozpoznávání v zařízení, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Underteksterne kunne ikke genereres. Kontrollér, at genkendelse på enheden er tilgængelig for dette sprog, og prøv igen."
