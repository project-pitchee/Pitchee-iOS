    "scoring.rules.highF0StylizedCap.title": {
      "comment": "Title of the rule that caps the score when pitch is high but naturalness is low. Compact, two-clause style.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سقف الطبقة المرتفعة مع الطبيعية المنخفضة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omezení při vysoké výšce a nízké přirozenosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Høj tonehøjde, lav naturlighed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obergrenze: hohe Tonhöhe, niedrige Natürlichkeit"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Όριο σε υψηλό ύψος με χαμηλή φυσικότητα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High pitch with low naturalness cap"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Límite por tono alto y baja naturalidad"
          }
        },
        "fi": {
          "stringUnit": {
