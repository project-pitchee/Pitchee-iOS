    "scoring.rules.highF0MaleCap.description" : {
      "comment" : "Guidance for the timbre cap; 'timbre' refers to the model's voice-quality score.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "طبقة الصوت والطبيعية في المستوى المطلوب؛ ركّز الآن على طابع الصوت ليصبح صوتك أكثر إشراقًا وارتخاءً."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výška hlasu i přirozenost už odpovídají cíli; teď se zaměřte na barvu hlasu, aby byl hlas jasnější a uvolněnější."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonehøjden og naturligheden er allerede på plads; fokusér nu på klangen for at gøre stemmen lysere og mere afslappet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonhöhe und Natürlichkeit passen schon; konzentrier dich jetzt auf die Klangfarbe, damit deine Stimme heller und entspannter klingt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το ύψος και η φυσικότητα είναι ήδη σε καλό επίπεδο· τώρα δώστε βάση στη χροιά, ώστε η φωνή να γίνει πιο φωτεινή και πιο χαλαρή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitch and naturalness are already on target; now focus on timbre to make your voice brighter and more relaxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tono y la naturalidad ya están en el nivel esperado; ahora enfócate en el timbre para que tu voz suene más brillante y relajada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeus ja luonnollisuus ovat jo tavoitteessa; keskity seuraavaksi äänenlaatuun, jotta äänestä tulee kirkkaampi ja rennompi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La hauteur et le naturel sont déjà au niveau ; travaillez maintenant le timbre pour rendre votre voix plus claire et plus détendue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הטון והטבעיות כבר בערכים טובים; עכשיו התמקדו בגוון כדי שהקול יישמע בהיר ורגוע יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिच और स्वाभाविकता तो ठीक है; अब आवाज़ की गुणवत्ता पर ध्यान दें, ताकि आवाज़ ज़्यादा चमकदार और हल्की लगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Visina i prirodnost već su na razini; sada se usredotoči na boju glasa kako bi glas zvučao svjetlije i opuštenije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangmagasság és a természetesség már megfelelő; most a hangszínre figyelj, hogy a hangod világosabb és könnyedebb legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada dan kealamian sudah sesuai target; sekarang fokus pada timbre agar suara Anda lebih cerah dan santai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tono e naturalezza sono già a buon punto: ora concentrati sul timbro per rendere la voce più brillante e rilassata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音高と自然度はすでに目標に達しています。次は音色に注目して、声をより明るく、より楽な印象にしていきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음높이와 자연스러움은 이미 기준을 넘었어요. 이제 음색을 집중적으로 연습해 목소리를 더 밝고 편안하게 만들어 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pic dan kewajaran sudah mencapai sasaran; kini fokus pada warna nada untuk menjadikan suara anda lebih cerah dan lebih santai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toonhoogte en natuurlijkheid zijn al op orde; richt je nu op timbre om je stem helderder en ontspannener te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysokość głosu i naturalność są już na dobrym poziomie; teraz skup się na barwie głosu, aby brzmiał jaśniej i swobodniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altura e naturalidade já estão no ponto; agora foque no timbre para deixar sua voz mais brilhante e leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Высота тона и естественность уже в норме — теперь поработайте над тембром, чтобы голос звучал ярче и свободнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonhöjd och naturlighet är redan bra – fokusera nu på klangen för att göra rösten ljusare och mer avslappnad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับเสียงและความเป็นธรรมชาติได้ตามเป้าแล้ว ต่อไปโฟกัสที่น้ำเสียงเพื่อให้เสียงใสและผ่อนคลายมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perde ve doğallık hedefe ulaştı; şimdi tınıya odaklanıp sesini daha parlak ve daha rahat hale getirmeye çalış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Висота тону й природність уже на рівні; тепер попрацюйте над тембром, щоб голос звучав яскравіше й розкутіше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cao độ và độ tự nhiên đã đạt yêu cầu; giờ hãy tập trung vào âm sắc để giọng nói sáng hơn và thư thái hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高和自然度已经达标，接下来重点练习音色，让声音更明亮、更轻松。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高和自然度已經達標，接下來重點練習音色，讓聲音更明亮、更輕鬆。"
          }
        }
      }
    },
