    "recording.error.microphonePermissionDenied": {
      "comment": "Recording phase: microphone permission was denied. 系统设置 is the iOS Settings app; keep the app name Pitchee literal.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "امنح Pitchee إذن استخدام الميكروفون من الإعدادات، ثم حاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Povolte aplikaci Pitchee přístup k mikrofonu v Nastavení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillad Pitchee at bruge mikrofonen i Indstillinger, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube Pitchee in den Einstellungen den Zugriff auf das Mikrofon und versuch es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Επιτρέψτε στο Pitchee να χρησιμοποιεί το μικρόφωνο στις Ρυθμίσεις και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Pitchee to use the microphone in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que Pitchee use el micrófono en Ajustes y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salli Pitcheen käyttää mikrofonia asetuksissa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez Pitchee à utiliser le micro dans Réglages, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אשרו ל-Pitchee להשתמש במיקרופון בהגדרות המערכת, ואז נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सेटिंग्स में Pitchee को माइक्रोफ़ोन इस्तेमाल करने की अनुमति दें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dopusti aplikaciji Pitchee pristup mikrofonu u Postavkama pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Engedélyezd a Pitchee számára a mikrofon használatát a Beállításokban, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izinkan Pitchee memakai mikrofon di Pengaturan, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenti a Pitchee di usare il microfono in Impostazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定で Pitchee にマイクの使用を許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정에서 Pitchee의 마이크 사용을 허용한 뒤 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Benarkan Pitchee menggunakan mikrofon dalam Tetapan, kemudian cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sta Pitchee in Instellingen toegang tot de microfoon toe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zezwól aplikacji Pitchee na dostęp do mikrofonu w Ustawieniach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permita que o Pitchee use o microfone nos Ajustes e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите Pitchee использовать микрофон в настройках и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tillåt Pitchee att använda mikrofonen i Inställningar och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โปรดอนุญาตให้ Pitchee ใช้ไมโครโฟนในการตั้งค่า แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayarlar'dan Pitchee'nin mikrofona erişmesine izin verip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дозвольте Pitchee доступ до мікрофона в «Налаштуваннях» і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy cho phép Pitchee dùng micrô trong Cài đặt, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Pitchee 使用麦克风，然后再试一次。"
