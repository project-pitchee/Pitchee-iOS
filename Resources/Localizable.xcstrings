    "practice.quality.lowLevel" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مستوى التسجيل منخفض. اقترب قليلًا من الميكروفون وسجّل مجددًا بمستوى صوت مريح."
          }
