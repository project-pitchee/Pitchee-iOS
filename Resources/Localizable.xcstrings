    "scoring.rules.lowF0NaturalCap.description": {
      "comment": "Guidance for the low-pitch rule; points the user to the next skill to work on.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الطبيعية جيدة بالفعل — يمكنك الآن التركيز على طبقة الصوت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přirozenost je už dobrá — teď se můžete zaměřit na výšku hlasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturligheden er allerede god — nu kan du fokusere på tonehøjden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Natürlichkeit ist schon gut – jetzt kannst du dich auf die Tonhöhe konzentrieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η φυσικότητα είναι ήδη καλή — τώρα μπορείτε να δώσετε βάση στο ύψος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturalness is already good — now you can focus on pitch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La naturalidad ya es buena; ahora puedes enfocarte en el tono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luonnollisuus on jo hyvä – seuraavaksi voit keskittyä sävelkorkeuteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le naturel est déjà bon — vous pouvez maintenant vous concentrer sur la hauteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטבעיות כבר טובה — עכשיו אפשר להתמקד בטון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वाभाविकता पहले से अच्छी है — अब ध्यान पिच पर दे सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prirodnost je već dobra — sada se možeš usredotočiti na visinu glasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A természetesség már jó — most a hangmagasságra figyelhetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kealamian sudah bagus — sekarang Anda bisa fokus pada nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La naturalezza è già buona: ora puoi concentrarti sul tono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自然度はすでに良好です。次は音高に意識を向けてみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자연스러움은 이미 좋아요. 이제 음높이에 집중해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kewajaran sudah baik — kini anda boleh fokus pada pic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De natuurlijkheid is al goed — nu kun je je op de toonhoogte richten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturalność jest już dobra — teraz możesz skupić się na wysokości głosu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A naturalidade já está boa — agora você pode focar na altura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Естественность уже в порядке — теперь можно сосредоточиться на высоте тона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturligheten är redan bra – nu kan du lägga fokus på tonhöjden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความเป็นธรรมชาติอยู่ในเกณฑ์ดีแล้ว ต่อไปโฟกัสที่ระดับเสียงได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doğallık zaten iyi; şimdi dikkatini perdeye verebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Природність уже добра — тепер можна зосередитися на висоті тону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Độ tự nhiên đã khá tốt — giờ bạn có thể tập trung vào cao độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然度已经不错，接下来可以把注意力放在音高上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自然度已經不錯，接下來可以把注意力放在音高上。"
          }
        }
      }
    },
