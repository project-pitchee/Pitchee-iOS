    "onboarding.preferences.subtitle": {
      "comment": "Must reassure that skipping is acceptable and that the choice is reversible.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر اتجاهًا لاستكشافه — أو ابقَ بلا اختيار. يمكنك تغيير ذلك في أي وقت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyberte si směr, který chcete prozkoumat — nebo se zatím nerozhodujte. Kdykoli to můžete změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg en retning, du vil udforske — eller vent med at beslutte. Du kan ændre det når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle eine Richtung zum Ausprobieren – oder lass es offen. Du kannst das jederzeit ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Διαλέξτε μια κατεύθυνση για να εξερευνήσετε — ή αφήστε το ανοιχτό. Μπορείτε να το αλλάξετε όποτε θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a direction to explore — or stay undecided. You can change this anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una dirección para explorar, o no elijas todavía. Puedes cambiarla cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valitse suunta, jota haluat tutkia – tai jätä valinta myöhemmäksi. Voit muuttaa sitä milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez une direction à explorer — ou laissez la question ouverte. Vous pourrez changer quand vous voulez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בחרו כיוון לחקור — או הישארו בלי החלטה. אפשר לשנות בכל רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जिस दिशा में जाना चाहें चुनें — या अभी तय न करें। इसे कभी भी बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberi smjer za istraživanje — ili preskoči za sada. Sve možeš promijeniti bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Válassz egy irányt, amit felfedeznél — vagy hagyd nyitva a kérdést. Ezt bármikor módosíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih satu arah untuk dijelajahi — atau tetap belum menentukan. Anda bisa mengubahnya kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli una direzione da esplorare o rimanda la scelta. Puoi cambiare quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "探索したい方向を選ぶか、決めずにいてもかまいません。あとからいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탐색하고 싶은 방향을 고르거나 아직 정하지 않아도 괜찮아요. 언제든 바꿀 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih arah untuk diterokai — atau kekal belum pasti. Anda boleh mengubahnya bila-bila masa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies een richting om te verkennen — of blijf voorlopig onbeslist. Je kunt dit altijd aanpassen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz kierunek, który chcesz poznawać — możesz też wstrzymać się z wyborem. Zmienisz to w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma direção para explorar — ou fique sem decidir. Você pode mudar isso quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выберите направление или оставьте выбор на потом. Изменить его можно в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj en riktning att utforska – eller vänta med att bestämma dig. Du kan ändra det när som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เลือกแนวทางที่อยากลอง หรือจะยังไม่ตัดสินใจก็ได้ ปรับเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keşfetmek istediğin bir yön seç ya da karar verme. Bunu istediğin zaman değiştirebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Виберіть напрям для дослідження — або поки не визначайтеся. Це можна змінити будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một hướng để khám phá — hoặc cứ để ngỏ. Bạn có thể thay đổi bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个想探索的方向，也可以暂不确定。之后随时都能调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇一個想探索的方向，也可以暫不確定。之後隨時都能調整。"
          }
        }
      }
    },
    "onboarding.preferences.title": {
      "comment": "Invitation tone; the user is about to answer a question on this page.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لنتعرّف عليك أكثر"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomozte nám vás lépe poznat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lad os lære dig bedre at kende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit wir dich besser kennenlernen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ας γνωριστούμε καλύτερα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us get to know you better"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ayúdanos a conocerte mejor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutustutaan sinuun paremmin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faisons connaissance"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בואו נכיר אתכם טוב יותר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपने बारे में और बताएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomogni nam da te bolje upoznamo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segíts, hogy jobban megismerhessünk"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bantu kami mengenal Anda lebih baik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conosciamoci meglio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "あなたのことを教えてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "조금 더 알아가 볼까요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mari berkenalan dengan lebih dekat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vertel iets over jezelf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poznajmy się lepiej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conte mais sobre você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Расскажите немного о себе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berätta vad du siktar på"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "มาทำความรู้จักคุณมากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seni biraz daha tanıyalım"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розкажіть трохи про себе"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để Pitchee hiểu bạn hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让我们更加了解你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "讓我們更加了解你"
          }
        }
      }
