    "voiceProfile.option.feminine.description": {
      "comment": "Parallel to the masculine option; keep the adjective pair and the 'explore' verb identical across both.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتشف صوتًا أكثر إشراقًا ونعومة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Objevte světlejší a jemnější hlas"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Udforsk en lysere og blødere klang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erkunde einen helleren, weicheren Klang"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εξερευνήστε έναν πιο φωτεινό, πιο απαλό ήχο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a brighter, softer sound"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Explora un sonido más brillante y suave"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutki kirkkaampaa ja pehmeämpää ääntä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Explorez un son plus clair et plus doux"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "חקרו קול בהיר ורך יותר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ज़्यादा चमकदार और कोमल आवाज़ खोजें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Istraži svjetliji i mekši glas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fedezz fel egy világosabb, lágyabb hangzást"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jelajahi suara yang lebih cerah dan lembut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esplora un suono più brillante e morbido"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "より明るく、やわらかい声を探る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "더 밝고 부드러운 소리 탐색하기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terokai suara yang lebih cerah dan lembut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ontdek een helderder, zachter geluid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odkryj jaśniejsze, miękkie brzmienie"
