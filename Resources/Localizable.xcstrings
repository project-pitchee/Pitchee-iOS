    "insights.metric.meanPitch.description" : {
      "comment" : "Explains pitch units and missing values without treating a higher pitch as inherently better.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "متوسط طبقة الصوت هو متوسط التردد الأساسي للكلام المجهور، بوحدة Hz. تعني القيمة الأعلى طبقة صوت أعلى، وليس صوتًا أفضل. تعرض التسجيلات التي لم تُكتشف فيها طبقة صوت الرمز «—»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Průměrná výška hlasu je průměrná základní frekvence znělých úseků řeči v Hz. Vyšší hodnota znamená vyšší hlas, nikoli lepší hlas. U nahrávek bez zjištěné výšky se zobrazuje „—“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gennemsnitlig tonehøjde er den gennemsnitlige grundfrekvens for stemt tale, målt i Hz. En højere værdi betyder en højere tonehøjde, ikke en bedre stemme. Optagelser uden registreret tonehøjde viser »—«."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die mittlere Tonhöhe ist die durchschnittliche Grundfrequenz stimmhafter Sprache in Hz. Ein höherer Wert bedeutet eine höhere Tonhöhe, nicht eine bessere Stimme. Ohne erkannte Tonhöhe wird „—“ angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το μέσο ύψος είναι η μέση θεμελιώδης συχνότητα των έμφωνων τμημάτων της ομιλίας, σε Hz. Υψηλότερη τιμή σημαίνει υψηλότερο ύψος, όχι καλύτερη φωνή. Οι εγγραφές χωρίς ανιχνεύσιμο ύψος εμφανίζουν «—»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mean pitch is the average fundamental frequency of voiced speech, in Hz. A higher value means a higher pitch, not a better voice. Recordings without a detected pitch show “—”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El promedio de tono es la frecuencia fundamental media del habla sonora, en Hz. Un valor mayor indica un tono más agudo, no una voz mejor. Las grabaciones sin tono detectado muestran «—»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keskimääräinen sävelkorkeus on soinnillisen puheen keskimääräinen perustaajuus hertseinä (Hz). Suurempi arvo tarkoittaa korkeampaa ääntä, ei parempaa ääntä. Jos sävelkorkeutta ei havaita, tallenteen kohdalla näkyy ”—”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La hauteur moyenne est la fréquence fondamentale moyenne de la parole voisée, en Hz. Une valeur plus élevée indique une voix plus aiguë, pas une meilleure voix. Sans hauteur détectée, « — » s’affiche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "טון ממוצע הוא תדר היסוד הממוצע של מקטעי דיבור קוליים, ב-Hz. ערך גבוה יותר מציין טון גבוה יותר, ולא קול טוב יותר. בהקלטות שבהן לא זוהה טון מוצג ״—״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "औसत पिच, सघोष बोलचाल की औसत मूल आवृत्ति है, जिसे Hz में मापा जाता है। अधिक मान का अर्थ ऊँची पिच है, बेहतर आवाज़ नहीं। जिन रिकॉर्डिंग में पिच का पता नहीं चलता, उनमें “—” दिखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prosjek visine prosječna je osnovna frekvencija zvučnih dijelova govora, u Hz. Viša vrijednost znači viši glas, a ne bolji glas. Za snimke bez prepoznate visine prikazuje se „—”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az átlagos hangmagasság a zöngés beszéd átlagos alapfrekvenciája Hz-ben. A nagyobb érték magasabb hangot jelent, nem jobb hangot. Ha nem észlelhető hangmagasság, a felvételnél „—” látható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada rata-rata adalah rata-rata frekuensi dasar ucapan bersuara, dalam Hz. Nilai yang lebih tinggi berarti nada lebih tinggi, bukan suara yang lebih baik. Rekaman tanpa nada yang terdeteksi menampilkan “—”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tono medio è la frequenza fondamentale media del parlato sonoro, in Hz. Un valore più alto indica un tono più acuto, non una voce migliore. Le registrazioni senza un tono rilevato mostrano «—»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "平均音高は有声音の基本周波数の平均で、単位はHzです。数値が高いほど音高が高いことを示しますが、声の良し悪しを表すものではありません。音高を検出できなかった録音は「—」と表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "평균 음높이는 유성 발화의 평균 기본 주파수이며 단위는 Hz예요. 값이 높다는 것은 음높이가 높다는 뜻이며, 더 좋은 목소리라는 뜻은 아니에요. 음높이를 감지하지 못한 녹음에는 '—'가 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Purata pic ialah purata frekuensi asas pertuturan bersuara, dalam Hz. Nilai lebih tinggi bermakna pic lebih tinggi, bukan suara lebih baik. Rakaman tanpa pic yang dikesan memaparkan “—”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De gemiddelde toonhoogte is de gemiddelde grondfrequentie van stemhebbende spraak, in Hz. Een hogere waarde betekent een hogere toonhoogte, niet een betere stem. Opnamen zonder gedetecteerde toonhoogte tonen ‘—’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Średnia wysokość to średnia częstotliwość podstawowa dźwięcznych fragmentów mowy, w Hz. Wyższa wartość oznacza wyższy głos, a nie lepszy głos. Nagrania bez wykrytej wysokości pokazują „—”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A altura média é a frequência fundamental média da fala vozeada, em Hz. Um valor maior indica uma voz mais aguda, não uma voz melhor. Gravações sem altura detectada exibem “—”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Средняя высота тона — это средняя основная частота озвученной речи в Hz. Большее значение означает более высокий тон, а не лучшее качество голоса. Для записей без определённой высоты тона отображается «—»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Medeltonhöjd är den genomsnittliga grundfrekvensen för tonande tal, i Hz. Ett högre värde innebär en högre tonhöjd, inte en bättre röst. Inspelningar utan upptäckt tonhöjd visar ”—”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับเสียงเฉลี่ยคือค่าเฉลี่ยความถี่มูลฐานของช่วงคำพูดที่มีเสียงก้อง หน่วยเป็น Hz ค่าที่สูงกว่าหมายถึงเสียงสูงกว่า ไม่ได้หมายถึงเสียงดีกว่า บันทึกที่ตรวจไม่พบระดับเสียงจะแสดง “—”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ortalama perde, sesli konuşmanın Hz cinsinden ortalama temel frekansıdır. Daha yüksek değer, daha yüksek perde demektir; daha iyi ses demek değildir. Perde algılanamayan kayıtlarda “—” gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Середня висота тону — це середня основна частота вокалізованих ділянок мовлення в Hz. Більше значення означає вищий тон, а не кращий голос. Для записів без виявленої висоти тону відображається «—»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cao độ trung bình là tần số cơ bản trung bình của các đoạn lời nói hữu thanh, tính bằng Hz. Giá trị cao hơn nghĩa là cao độ cao hơn, không phải giọng nói tốt hơn. Bản ghi âm không phát hiện được cao độ sẽ hiển thị “—”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均音高是有效语音片段的平均基频，单位为 Hz。数值较高表示音高较高，并不等同于声音更好；未检测到有效音高的记录显示为「—」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均音高是有效語音片段的平均基頻，單位為 Hz。數值較高表示音高較高，並不等同於聲音更好；未偵測到有效音高的記錄顯示為「—」。"
          }
        }
      }
    },
