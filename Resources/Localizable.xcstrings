    "export.selection.backgroundLoudnessCurve.subtitle": {
      "comment": "One-line explanation under the background loudness curve option.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض مستوى الضجيج المحيط عند عدم اكتشاف كلام، بوحدة dBFS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukazuje úroveň okolního hluku, když není rozpoznána řeč, v dBFS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viser baggrundsstøjen, når der ikke registreres tale, i dBFS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeigt das Umgebungsgeräusch, wenn keine Sprache erkannt wird, in dBFS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δείχνει τον θόρυβο περιβάλλοντος όταν δεν ανιχνεύεται ομιλία, σε dBFS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the ambient noise floor when no speech is detected, in dBFS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Muestra el ruido de fondo cuando no se detecta voz, en dBFS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Näyttää ympäristön kohinatason ajalta, jolloin puhetta ei havaita, yksikkönä dBFS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Montre le bruit de fond lorsqu’aucune parole n’est détectée, en dBFS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מציג את רצפת הרעש הסביבתי כשלא זוהה דיבור, ב-dBFS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ न मिलने पर परिवेशी शोर स्तर दिखाता है, dBFS में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikazuje razinu šuma okoline kada nije otkriven govor, u dBFS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A beszéd nélküli szakaszokban a környezeti zajszintet mutatja dBFS-ben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menampilkan dasar kebisingan lingkungan saat tidak ada suara yang terdeteksi, dalam dBFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra il rumore di fondo quando non viene rilevata voce, in dBFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声が検出されていないときの周囲のノイズレベルを dBFS で示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성이 감지되지 않은 구간의 주변 소음을 dBFS로 표시해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menunjukkan aras hingar persekitaran apabila tiada pertuturan dikesan, dalam dBFS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toont de omgevingsruisvloer wanneer er geen spraak is gedetecteerd, in dBFS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokazuje poziom szumu otoczenia, gdy nie wykryto mowy, w dBFS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mostra o ruído de fundo quando nenhuma fala é detectada, em dBFS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показывает уровень фонового шума, когда речь не обнаружена, в dBFS"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visar bakgrundsbullret när inget tal upptäcks, i dBFS"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แสดงระดับเสียงรบกวนพื้นหลังในช่วงที่ตรวจไม่พบเสียงพูด หน่วยเป็น dBFS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konuşma algılanmadığında ortam gürültü tabanını dBFS cinsinden gösterir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Показує рівень фонового шуму, коли мовлення не виявлено, у dBFS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiển thị mức ồn nền khi chưa nhận diện được giọng nói, tính bằng dBFS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示未检测到语音时的环境底噪，单位 dBFS"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顯示未偵測到語音時的環境底噪，單位 dBFS"
          }
        }
      }
    },
