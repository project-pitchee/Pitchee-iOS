          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось начать запись. Попробуйте позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan inte starta inspelningen. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เริ่มบันทึกเสียงไม่ได้ โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
