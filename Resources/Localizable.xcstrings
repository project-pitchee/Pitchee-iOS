    "scoring.feminine.explanation.description" : {
      "comment" : "Direction-aware scoring copy.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتبع هذه النتيجة هدفك لصوت يميل إلى الأنوثة وتستخدم المرجع نفسه المراعي للطبيعية الذي يستخدمه محرك التحليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toto skóre odpovídá cíli femininního hlasu a používá stejnou referenci zohledňující přirozenost jako analytický modul."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne score følger dit mål om en stemme med feminin tendens og bruger samme reference, der tager højde for naturlighed, som analysemotoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Bewertung folgt deinem femininen Stimmziel und verwendet dieselbe Natürlichkeitsreferenz wie das Analysemodul."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή η βαθμολογία ακολουθεί τον στόχο θηλυκής φωνής και χρησιμοποιεί την ίδια αναφορά με συνεκτίμηση της φυσικότητας όπως η μηχανή ανάλυσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This score follows your feminine-leaning goal and uses the same naturalness-aware reference as the analysis engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este puntaje sigue tu objetivo de voz de tendencia femenina y usa la misma referencia que considera la naturalidad del motor de análisis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä pistemäärä noudattaa feminiiniseen suuntaan painottuvan äänen tavoitettasi ja käyttää samaa luonnollisuuden huomioivaa viitearvoa kuin analyysijärjestelmä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce score suit votre objectif de voix plutôt féminine et utilise la même référence tenant compte du naturel que le moteur d’analyse."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ציון זה תואם ליעד הקול הנוטה לנשיות שלכם ומשתמש באותו מדד ייחוס המתחשב בטבעיות שבו משתמש מנוע הניתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह स्कोर आपके स्त्री जैसी आवाज़ के लक्ष्य के अनुसार है और विश्लेषण इंजन के समान स्वाभाविकता को ध्यान में रखने वाला संदर्भ इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ova ocjena prati cilj ženskog zvuka glasa i koristi istu referencu koja uzima u obzir prirodnost kao i mehanizam analize."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez a pontszám a nőies jellegű hangra irányuló célodat követi, és az elemzőmotorral azonos, természetességet figyelembe vevő viszonyítási alapot használ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor ini mengikuti tujuan suara Anda yang cenderung feminin dan menggunakan acuan yang mempertimbangkan kealamian, sama dengan mesin analisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questo punteggio segue il tuo obiettivo di voce tendenzialmente femminile e usa lo stesso riferimento, basato anche sulla naturalezza, del motore di analisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このスコアは女性的な声という目標に沿って、分析エンジンと同じ自然度を考慮した基準を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 점수는 여성적인 목소리라는 목표를 따르며, 분석 엔진과 동일하게 자연스러움을 고려하는 기준을 사용해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skor ini mengikut sasaran suara anda yang cenderung feminin dan menggunakan rujukan yang mengambil kira kewajaran, sama seperti enjin analisis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deze score volgt je doel van een overwegend vrouwelijke stem en gebruikt dezelfde referentie die rekening houdt met natuurlijkheid als de analyse-engine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten wynik odpowiada celowi żeńskiego brzmienia głosu i używa tego samego odniesienia uwzględniającego naturalność co mechanizm analizy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta pontuação segue seu objetivo de voz com tendência feminina e usa a mesma referência que considera a naturalidade no mecanismo de análise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эта оценка соответствует цели женственного звучания и использует тот же ориентир с учётом естественности, что и механизм анализа."
