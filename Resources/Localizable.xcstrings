    "analysis.suggestions.subtitle" : {
      "comment" : "Explains that the list below is derived from the current recording and is meant as a next step.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
