    "scoring.currentRule.badge" : {
      "comment" : "Tiny accent-colored capsule badge marking that this is the rule in effect for the current result.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الحالية"
