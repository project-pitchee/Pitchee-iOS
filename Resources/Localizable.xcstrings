    "analysis.voiceProfile.reference.a11y %@ %@ %@ %@": {
      "comment": "VoiceOver summary of the voice-tendency chart, read in order: average pitch, sample pitch range, then the female and male percentages.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مرجع الميل الصوتي: متوسط طبقة الصوت %1$@، ونطاق طبقة الصوت في العينة %2$@، مقابل %3$@ و%4$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reference hlasových pásem: průměrná výška %1$@, rozsah výšky ukázky %2$@, žena %3$@, muž %4$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmetendens-reference: gennemsnitlig tonehøjde %1$@, tonehøjdeområde for prøven %2$@, kvinder %3$@, mænd %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referenz zur Stimmtendenz: durchschnittliche Tonhöhe %1$@, Tonhöhenbereich der Aufnahme %2$@, weiblich %3$@, männlich %4$@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αναφορά τάσης φωνής: μέσο ύψος %1$@, εύρος ύψους δείγματος %2$@, Γυναικεία %3$@, Ανδρική %4$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice tendency reference: average pitch %1$@, sample pitch range %2$@, Female %3$@, Male %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referencia de tendencia vocal: tono promedio %1$@, rango tonal de la muestra %2$@, femenino %3$@, masculino %4$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänen suuntauksen viite: keskimääräinen sävelkorkeus %1$@, näytteen sävelkorkeusalue %2$@, Nainen %3$@, Mies %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Référence de tendance vocale : hauteur moyenne %1$@, plage de hauteur de l’échantillon %2$@, Féminin %3$@, Masculin %4$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ייחוס נטיית הקול: טון ממוצע %1$@, טווח הטון במדגם %2$@, נשי %3$@, גברי %4$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ की प्रवृत्ति का संदर्भ: औसत पिच %1$@, नमूने का पिच दायरा %2$@, स्त्री %3$@, पुरुष %4$@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referenca sklonosti glasa: prosjek visine %1$@, raspon visine uzorka %2$@, ženski %3$@, muški %4$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hangtendencia-referencia: átlagos hangmagasság %1$@, a minta hangmagasság-tartománya %2$@, női %3$@, férfi %4$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acuan kecenderungan suara: nada rata-rata %1$@, rentang nada sampel %2$@, Perempuan %3$@, Laki-laki %4$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Riferimento di tendenza vocale: tono medio %1$@, intervallo di tono del campione %2$@, femminile %3$@, maschile %4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "声の傾向の目安：平均音高 %1$@、サンプルの音高範囲 %2$@、女性 %3$@、男性 %4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 성향 참고: 평균 음높이 %1$@, 샘플 음높이 범위 %2$@, 여성 %3$@, 남성 %4$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rujukan kecenderungan suara: purata pic %1$@, julat pic sampel %2$@, Wanita %3$@, Lelaki %4$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemneigingsreferentie: gemiddelde toonhoogte %1$@, toonhoogtebereik van deze opname %2$@, vrouwelijk %3$@, mannelijk %4$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odniesienie dla tendencji głosu: średnia wysokość %1$@, zakres wysokości próbki %2$@, żeński %3$@, męski %4$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referência de tendência vocal: altura média %1$@, faixa de altura da amostra %2$@, Feminina %3$@, Masculina %4$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ориентир по направленности голоса: средняя высота тона %1$@, диапазон высоты тона в записи %2$@, женский %3$@, мужской %4$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Referens för rösttendens: medeltonhöjd %1$@, inspelningens tonhöjdsintervall %2$@, kvinnlig %3$@, manlig %4$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ข้อมูลอ้างอิงแนวโน้มเสียง ระดับเสียงเฉลี่ย %1$@ ช่วงระดับเสียงของตัวอย่าง %2$@ หญิง %3$@ ชาย %4$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses eğilimi referansı: ortalama perde %1$@, örnek perde aralığı %2$@, Kadın %3$@, Erkek %4$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Орієнтир схильності голосу: середня висота тону %1$@, діапазон висоти зразка %2$@, жіночий %3$@, чоловічий %4$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tham chiếu xu hướng giọng nói: cao độ trung bình %1$@, dải cao độ mẫu %2$@, Nữ %3$@, Nam %4$@"
          }
        },
        "zh-Hans": {
