          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khoảng trống trên đường cong nghĩa là không có kết quả tin cậy trong khoảng thời gian đó; cả ba đường cong dùng chung một trục thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
