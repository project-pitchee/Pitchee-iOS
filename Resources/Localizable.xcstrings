    "analysis.suggestions.unnaturalSpeech.description": {
      "comment": "Longer coaching text in the suggestion detail sheet. Advises against deliberately manipulating pitch.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرخِ فكك وكتفيك أولًا وتدرّب على جمل مألوفة. لا ترفع طبقة صوتك أو تخفضها قسرًا — ركّز على إبقاء إلقائك متواصلًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nejdřív uvolněte čelist a ramena a cvičte s větami, které znáte. Netlačte výšku hlasu nahoru ani dolů — soustřeďte se na plynulý projev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slap af i kæbe og skuldre først, og øv dig med sætninger, du kender. Tving ikke tonehøjden op eller ned — fokusér på at holde fremføringen sammenhængende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entspann zuerst Kiefer und Schultern und übe mit vertrauten Sätzen. Erzwing keine höhere oder tiefere Tonlage – wichtig ist, dass du flüssig sprichst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Χαλαρώστε πρώτα το σαγόνι και τους ώμους και εξασκηθείτε με προτάσεις που ξέρετε. Μην πιέζετε το ύψος προς τα πάνω ή προς τα κάτω — δώστε βάση στη ροή της ομιλίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relax your jaw and shoulders first and practise with familiar sentences. Don't force your pitch up or down — focus on keeping your delivery connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primero relaja la mandíbula y los hombros y practica con frases conocidas. No fuerces el tono hacia arriba ni hacia abajo; concéntrate en mantener la fluidez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rentouta ensin leukaa ja hartioita ja harjoittele tuttujen lauseiden kanssa. Älä paina sävelkorkeutta väkisin alas tai ylös – keskity pitämään ilmaisu sujuvana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relâchez d’abord la mâchoire et les épaules, puis entraînez-vous avec des phrases que vous connaissez. Ne forcez pas votre voix vers le haut ou vers le bas — cherchez avant tout un débit fluide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הרפו קודם את הלסת והכתפיים ותרגלו עם משפטים מוכרים. אל תכריחו את הטון לעלות או לרדת — התמקדו בשמירה על דיבור רציף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पहले जबड़े और कंधे ढीले करें और परिचित वाक्यों से अभ्यास करें। पिच को जान-बूझकर ऊँचा या नीचा न करें — बोलने की गति लगातार बनी रहे, इस पर ध्यान दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opusti najprije čeljust i ramena pa vježbaj s poznatim rečenicama. Ne forsiraj visinu glasa ni gore ni dolje — usredotoči se na povezan govor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Először lazítsd el az állkapcsodat és a válladat, és gyakorolj ismerős mondatokkal. Ne erőltesd fel vagy le a hangmagasságot — inkább arra figyelj, hogy folyamatos legyen a beszéded."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rilekskan rahang dan bahu lebih dulu, lalu berlatih dengan kalimat yang familier. Jangan memaksa nada naik atau turun — fokus menjaga penyampaian tetap mengalir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rilassa prima mascella e spalle e allenati con frasi che conosci. Non forzare il tono verso l'alto o il basso: concentrati su un parlato scorrevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まずあごと肩をゆるめて、慣れた文章で練習しましょう。音高を無理に上げ下げせず、滑らかにつながる話し方を意識してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "먼저 턱과 어깨의 힘을 빼고 익숙한 문장으로 연습해 보세요. 음높이를 억지로 낮추거나 높이지 말고 말이 이어지게 해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rilekskan rahang dan bahu anda dahulu, dan berlatih dengan ayat yang biasa. Jangan paksa pic naik atau turun — fokus untuk memastikan penyampaian kekal bersambung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ontspan eerst je kaak en schouders en oefen met zinnen die je goed kent. Forceer je toonhoogte niet omhoog of omlaag — houd je spraak vooral vloeiend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rozluźnij najpierw żuchwę i barki, a potem poćwicz na znanych zdaniach. Nie wymuszaj niższej ani wyższej wysokości głosu — zadbaj najpierw o płynność wypowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Relaxe primeiro a mandíbula e os ombros e treine com frases conhecidas. Não force a altura da voz para cima ou para baixo — concentre-se em manter a fala fluida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сначала расслабьте челюсть и плечи и потренируйтесь на знакомых фразах. Не старайтесь специально понижать или повышать тон — сначала просто говорите связно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slappna av i käkar och axlar först och öva med meningar du kan. Tvinga inte tonhöjden uppåt eller nedåt – fokusera på att hålla talet sammanhängande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คลายกรามและไหล่ก่อน แล้วฝึกด้วยประโยคที่คุ้นเคย ไม่ต้องฝืนทำเสียงให้สูงหรือต่ำลง เน้นให้พูดต่อเนื่องเป็นธรรมชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Önce çeneni ve omuzlarını gevşet, tanıdık cümlelerle çalış. Perdeni bilinçli olarak düşürme ya da yükseltme; anlatımını akıcı tutmaya odaklan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу розслабте щелепу й плечі та потренуйтеся на знайомих реченнях. Не намагайтеся штучно підвищувати чи знижувати тон — просто зберігайте зв’язну вимову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy thư giãn hàm và vai trước, rồi luyện với những câu quen thuộc. Đừng cố nâng hay hạ cao độ — hãy tập trung giữ lời nói liền mạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先放松下颌和肩膀，用熟悉的句子练习。不要刻意压低或抬高音高，先让表达保持连贯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先放鬆下顎和肩膀，用熟悉的句子練習。不要刻意壓低或抬高音高，先讓表達保持連貫。"
          }
        }
      }
    },
    "analysis.suggestions.unnaturalSpeech.subtitle": {
      "comment": "Concrete speaking tip shown under the title when naturalness needs work.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خفّف السرعة، وحافظ على تنفّس منتظم، وجرّب مقطعًا مألوفًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zpomalte, dýchejte plynule a zkuste známý text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sæt tempoet ned, træk vejret jævnt, og prøv en tekst, du kender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprich langsamer, atme gleichmäßig und probier es mit einem vertrauten Text."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μιλάτε πιο αργά, αναπνέετε σταθερά και δοκιμάστε ένα οικείο κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow down, keep breathing steadily, and try a familiar passage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Habla más despacio, respira de forma continua y prueba con un texto conocido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hidasta tahtia, hengitä tasaisesti ja kokeile tuttua tekstiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ralentissez, respirez régulièrement et essayez un passage que vous connaissez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "האטו את הקצב, נשמו באופן יציב ונסו קטע מוכר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "गति धीमी करें, साँस स्थिर रखें और कोई परिचित पाठ पढ़कर देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uspori, diši ravnomjerno i izgovori neki poznati tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beszélj lassabban, lélegezz egyenletesen, és mondj el egy ismerős szöveget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perlambat tempo, jaga napas tetap stabil, lalu coba ucapkan kalimat yang familier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rallenta, respira con regolarità e prova un testo che conosci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ゆっくり話し、呼吸を整えて、慣れた文章を読んでみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "말 속도를 늦추고 호흡을 고르게 하면서 익숙한 문장을 다시 말해 보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perlahankan rentak, bernafas dengan tenang, dan cuba petikan yang biasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doe rustig aan, blijf gelijkmatig ademen en lees een tekst die je kent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zwolnij tempo, oddychaj równo i powiedz znany fragment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fale mais devagar, respire de forma constante e tente um trecho conhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Говорите медленнее, дышите ровно и попробуйте прочитать знакомый текст."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sänk tempot, andas jämnt och prova en text du känner igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "พูดช้าลง หายใจให้สม่ำเสมอ แล้วลองอ่านบทอ่านที่คุ้นเคย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yavaşla, nefesini düzenli tut ve tanıdık bir metni okumayı dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Говоріть повільніше, дихайте рівно й спробуйте знайомий уривок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nói chậm lại, giữ hơi thở đều và thử một đoạn quen thuộc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放慢语速，保持连续呼吸，再试着说一段熟悉的话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "放慢語速，保持連續呼吸，再試著說一段熟悉的話。"
          }
        }
      }
    },
    "analysis.suggestions.unnaturalSpeech.title": {
      "comment": "Title of the second suggestion row when the naturalness score is below 70.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اجعل نبرتك أكثر طبيعية"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zlepšete přirozenost projevu"
          }
