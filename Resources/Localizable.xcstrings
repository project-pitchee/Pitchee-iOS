          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toonhoogte en stemkenmerken worden op je apparaat geanalyseerd.\nDe eerste analyse kan even duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analiza wysokości głosu i jego cech odbywa się na urządzeniu.\nPierwsza analiza może potrwać chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analisando altura e características da voz no seu dispositivo.\nA primeira análise pode levar um pouco mais de tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Анализируем высоту тона и особенности голоса на устройстве.\nПервый анализ может занять немного времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
