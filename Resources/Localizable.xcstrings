    "analysis.suggestions.adequateRecording.description" : {
      "comment" : "Longer body text in the suggestion sheet; reassures the user and asks for consistent length.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لقد قدّمت بيانات صوتية كافية. حافظ على مدة مشابهة في المرة القادمة ليصبح الاتجاه أوضح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hlasových dat už máte dost. Příště zachovejte podobnou délku a trend se bude číst snáz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du har allerede givet nok stemmedata. Hold en lignende længde næste gang, så bliver tendensen lettere at læse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du hast bereits genug Stimmdaten geliefert. Wenn die Aufnahme beim nächsten Mal ähnlich lang ist, lässt sich der Trend leichter erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δώσατε ήδη αρκετά δεδομένα φωνής. Κρατήστε παρόμοια διάρκεια την επόμενη φορά και η τάση θα διαβάζεται πιο εύκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You already gave enough voice data. Keep a similar length next time and the trend will be easier to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ya aportaste suficientes datos de voz. La próxima vez mantén una duración similar y la tendencia será más fácil de leer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Annoit jo riittävästi puhenäytettä. Pidä vastaava pituus myös ensi kerralla, niin trendiä on helpompi seurata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre enregistrement contient déjà assez de voix. Gardez une durée similaire la prochaine fois et la tendance sera plus facile à lire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש כבר מספיק נתוני קול. שמרו על אורך דומה בהקלטה הבאה והמגמה תהיה קלה יותר לקריאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपने पर्याप्त आवाज़ डेटा दे दिया है। अगली बार भी इतनी ही अवधि रखें, तो रुझान समझना आसान होगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podataka o glasu već je dovoljno. Zadrži sličnu duljinu snimke i trend će se lakše čitati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Már elegendő hanganyagot adtál. A következő alkalommal tarts hasonló hosszúságot, és könnyebb lesz leolvasni a trendet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data suara Anda sudah cukup. Pertahankan durasi yang mirip pada rekaman berikutnya agar tren lebih mudah dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hai già fornito dati vocali sufficienti. La prossima volta mantieni una durata simile: l'andamento sarà più facile da leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "十分な声のデータが集まっています。次回も同じくらいの長さで録ると、変化を追いやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이미 충분한 음성 정보가 담겼어요. 다음에도 비슷한 길이로 녹음하면 추이를 더 쉽게 볼 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anda sudah memberikan data suara yang cukup. Kekalkan tempoh yang serupa pada masa akan datang supaya trend lebih mudah dibaca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je hebt al genoeg steminformatie gegeven. Houd de volgende keer een vergelijkbare lengte aan, dan is de trend makkelijker te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masz już wystarczająco dużo danych o głosie. Następnym razem zachowaj podobną długość nagrania, a trend będzie łatwiejszy do odczytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você já forneceu dados de voz suficientes. Mantenha uma duração parecida na próxima vez e a tendência ficará mais fácil de acompanhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы уже дали достаточно голосовых данных. В следующий раз запишите фрагмент примерно такой же длины — так динамику будет легче отслеживать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du har redan gett tillräckligt med röstdata. Håll en liknande längd nästa gång så blir trenden lättare att läsa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คุณมีข้อมูลเสียงเพียงพอแล้ว ครั้งต่อไปให้ความยาวใกล้เคียงเดิม จะช่วยให้อ่านแนวโน้มได้ง่ายขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yeterince ses verisi topladın. Bir sonraki kaydı da benzer uzunlukta tutarsan eğilimi okumak kolaylaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ви вже надали достатньо даних про голос. Наступного разу збережіть схожу тривалість — і тенденцію буде легше читати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn đã cung cấp đủ dữ liệu giọng nói. Lần sau hãy giữ độ dài tương tự để dễ theo dõi xu hướng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已经提供了足够的语音信息。下次保持相近时长，趋势会更容易看懂。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已經提供了足夠的語音資訊。下次保持相近時長，趨勢會更容易看懂。"
          }
        }
      }
    },
    "analysis.suggestions.adequateRecording.subtitle" : {
      "comment" : "Encourages consistent recording length so the user can compare results over time.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "احرص على مدة تسجيل مشابهة لتسهيل مقارنة كل تغيّر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nahrávejte podobně dlouho, ať se změny snadno porovnávají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fortsæt med at optage i en lignende længde, så hver ændring er nem at sammenligne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimm wieder ähnlich lang auf, damit sich jede Veränderung gut vergleichen lässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ηχογραφείτε για παρόμοια διάρκεια, ώστε κάθε αλλαγή να συγκρίνεται εύκολα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep recording for a similar length so each change is easy to compare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sigue grabando una duración similar para comparar mejor cada cambio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tallenna jatkossakin samanpituisesti, niin muutoksia on helppo verrata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gardez une durée d’enregistrement similaire pour comparer facilement chaque évolution."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "המשיכו להקליט באורך דומה כדי שקל יהיה להשוות כל שינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "लगभग इतनी ही अवधि तक रिकॉर्ड करें, ताकि हर बदलाव की तुलना आसान हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Snimaj sličnu duljinu kako bi svaku promjenu bilo lako usporediti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tarts hasonló hosszúságot a felvételeknél, hogy könnyen össze tudd hasonlítani a változásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
