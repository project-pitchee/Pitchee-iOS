    "analysis.error.resultSaveFailed": {
      "comment": "Analysis phase: analysis succeeded but persisting RecordingAssessment failed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتمل التحليل، لكن تعذّر حفظ النتيجة. تحقق من مساحة التخزين في جهازك وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analýza proběhla, ale výsledek se nepodařilo uložit. Zkontrolujte úložiště zařízení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analysen blev gennemført, men resultatet kunne ikke gemmes. Tjek enhedens lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Analyse ist fertig, aber das Ergebnis konnte nicht gespeichert werden. Prüfe den Speicherplatz deines Geräts und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η αξιολόγηση ολοκληρώθηκε, αλλά το αποτέλεσμα δεν ήταν δυνατό να αποθηκευτεί. Ελέγξτε τον χώρο αποθήκευσης της συσκευής και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assessment finished, but the result couldn't be saved. Check your device's storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El análisis terminó, pero no se pudo guardar el resultado. Revisa el almacenamiento del dispositivo y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arviointi valmistui, mutta tulosta ei voitu tallentaa. Tarkista laitteen tallennustila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’évaluation est terminée, mais le résultat n’a pas pu être enregistré. Vérifiez l’espace de stockage de l’appareil et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניתוח הסתיים, אך התוצאה לא נשמרה. בדקו את שטח האחסון במכשיר ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "विश्लेषण पूरा हुआ, पर नतीजा सेव नहीं हो सका। डिवाइस की स्टोरेज जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Procjena je dovršena, ali rezultat nije bilo moguće spremiti. Provjeri prostor na uređaju i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az elemzés elkészült, de az eredményt nem sikerült elmenteni. Ellenőrizd a készülék tárhelyét, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analisis selesai, tetapi hasilnya tidak dapat disimpan. Periksa ruang penyimpanan perangkat, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La valutazione è terminata, ma il risultato non è stato salvato. Controlla lo spazio sul dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分析は完了しましたが、結果を保存できませんでした。端末の空き容量を確認してお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "측정은 끝났지만 결과를 저장하지 못했어요. 기기 저장 공간을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Penilaian selesai, tetapi hasilnya tidak dapat disimpan. Semak storan peranti anda dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De analyse is afgerond, maar het resultaat kon niet worden opgeslagen. Controleer de opslagruimte op je apparaat en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiza została ukończona, ale nie udało się zapisać wyniku. Sprawdź pamięć urządzenia i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A avaliação terminou, mas não foi possível salvar o resultado. Verifique o espaço de armazenamento do dispositivo e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Анализ завершён, но результат не удалось сохранить. Проверьте свободное место на устройстве и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analysen blev klar, men resultatet kunde inte sparas. Kontrollera enhetens lagringsutrymme och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การประเมินเสร็จแล้ว แต่บันทึกผลลัพธ์ไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บของอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Değerlendirme tamamlandı ama sonuç kaydedilemedi. Cihazındaki depolama alanını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оцінювання завершено, але результат не вдалося зберегти. Перевірте вільне місце на пристрої та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quá trình đánh giá đã xong nhưng không lưu được kết quả. Hãy kiểm tra dung lượng thiết bị rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测评已完成，但结果未能保存。请检查设备存储空间后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "測評已完成，但結果未能儲存。請檢查裝置儲存空間後再試。"
          }
        }
      }
    },
