        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η καμπύλη δείχνει την ένταση όταν ανιχνεύεται ομιλία, σε dBFS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The curve shows loudness while speech was detected, in dBFS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La curva muestra el volumen mientras se detectó voz, en dBFS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyrä näyttää voimakkuuden siltä ajalta, jolloin puhetta havaittiin, yksikkönä dBFS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La courbe montre le niveau sonore pendant la détection de la parole, en dBFS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "העקומה מציגה את העוצמה כשזוהה דיבור, ב-dBFS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह वक्र उस समय की तीव्रता दिखाता है जब आवाज़ मिली, dBFS में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krivulja prikazuje glasnoću dok je govor otkriven, u dBFS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A görbe a beszéd közben mért hangerőt mutatja dBFS-ben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurva ini menunjukkan kenyaringan saat suara terdeteksi, dalam dBFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La curva mostra il volume mentre viene rilevata la voce, in dBFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この曲線は、音声が検出されているときの音量を dBFS で示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
