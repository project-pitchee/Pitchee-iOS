        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το μέσο ύψος είναι κάτω από 145 Hz, η φυσικότητα πάνω από 80 και η αντιστοιχία σε αρρενωπή φωνή πάνω από 50."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average pitch is below 145 Hz, naturalness is above 80, and masculine alignment is above 50."
