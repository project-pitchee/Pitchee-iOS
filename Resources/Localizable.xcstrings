    "practice.captions.permission" : {
      "comment" : "On-device practice captions. Audio and captions remain private and temporary; recognition must not fall back to a server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يلزم إذن التعرف على الكلام لإنشاء التسميات التوضيحية. يمكنك تغييره في الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro tvorbu titulků je potřeba oprávnění k rozpoznávání řeči. Můžete jej změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der kræves tilladelse til talegenkendelse for at generere undertekster. Du kan ændre den i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zum Erstellen von Untertiteln wird die Erlaubnis zur Spracherkennung benötigt. Du kannst sie in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Χρειάζεται άδεια αναγνώρισης ομιλίας για τη δημιουργία υποτίτλων. Μπορείτε να την αλλάξετε στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition permission is needed to generate captions. You can change it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se necesita permiso de reconocimiento de voz para generar subtítulos. Puedes cambiarlo en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekstityksen luomiseen tarvitaan puheentunnistuslupa. Voit muuttaa sitä Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’autorisation de reconnaissance vocale est nécessaire pour générer les sous-titres. Vous pouvez la modifier dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "נדרשת הרשאה לזיהוי דיבור כדי ליצור כתוביות. אפשר לשנות אותה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैप्शन बनाने के लिए बोली पहचान की अनुमति चाहिए। आप इसे सेटिंग्स में बदल सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za izradu titlova potrebna je dozvola za prepoznavanje govora. Možeš je promijeniti u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A feliratok generálásához beszédfelismerési engedély szükséges. Ezt a Beállításokban módosíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izin pengenalan ucapan diperlukan untuk membuat takarir. Anda dapat mengubahnya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per generare i sottotitoli è necessaria l’autorizzazione al riconoscimento vocale. Puoi modificarla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "字幕の生成には音声認識の許可が必要です。システムの「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자막을 생성하려면 음성 인식 권한이 필요해요. 시스템 설정에서 변경할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kebenaran pengecaman pertuturan diperlukan untuk menjana sari kata. Anda boleh mengubahnya dalam Tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toestemming voor spraakherkenning is nodig om ondertiteling te genereren. Je kunt dit wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Do generowania napisów potrzebna jest zgoda na rozpoznawanie mowy. Możesz ją zmienić w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "É necessária permissão de reconhecimento de fala para gerar legendas. Você pode alterá-la nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для создания субтитров нужно разрешение на распознавание речи. Его можно изменить в системных настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Behörighet för taligenkänning krävs för att generera undertexter. Du kan ändra den i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ต้องอนุญาตการรู้จำเสียงเพื่อสร้างคำบรรยาย คุณเปลี่ยนสิทธิ์ได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altyazı oluşturmak için konuşma tanıma izni gerekir. Bunu Ayarlar'dan değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для створення субтитрів потрібен дозвіл на розпізнавання мовлення. Його можна змінити в системних параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cần quyền nhận dạng giọng nói để tạo phụ đề. Bạn có thể thay đổi quyền trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要允许语音识别才能生成字幕。可在系统设置中更改权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要允許語音辨識才能產生字幕。你可以在系統設定中更改權限。"
          }
        }
      }
    },
    "practice.captions.privacy" : {
      "comment" : "On-device practice captions. Audio and captions remain private and temporary; recognition must not fall back to a server.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُنشأ التسميات التوضيحية على هذا الجهاز دون رفع الصوت، وتُمسح عند مغادرة التدريب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titulky vznikají v tomto zařízení bez odesílání zvuku a po opuštění cvičení se vymažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Undertekster genereres på denne enhed uden at uploade lyd og ryddes, når du forlader øvelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Untertitel werden auf diesem Gerät erstellt, ohne Audio hochzuladen, und beim Verlassen der Übung gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι υπότιτλοι δημιουργούνται σε αυτή τη συσκευή χωρίς μεταφόρτωση ήχου και διαγράφονται όταν βγαίνετε από την εξάσκηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captions are generated on this device without uploading audio and cleared when you leave the practice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los subtítulos se generan en este dispositivo sin subir audio y se borran al salir de la práctica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekstitys luodaan tällä laitteella lähettämättä ääntä, ja se tyhjennetään, kun poistut harjoituksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les sous-titres sont générés sur cet appareil sans envoyer l’audio et sont effacés lorsque vous quittez l’exercice."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הכתוביות נוצרות במכשיר זה ללא העלאת שמע ונמחקות כשיוצאים מהתרגול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कैप्शन ऑडियो अपलोड किए बिना इसी डिवाइस पर बनते हैं और अभ्यास से बाहर जाने पर मिट जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Titlovi se izrađuju na ovom uređaju bez prijenosa zvuka i brišu se kada napustiš vježbu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A feliratok ezen az eszközön készülnek, hang feltöltése nélkül, és a gyakorlás elhagyásakor törlődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Takarir dibuat di perangkat ini tanpa mengunggah audio dan dihapus saat Anda meninggalkan latihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I sottotitoli vengono generati su questo dispositivo senza caricare l’audio e cancellati quando esci dalla pratica."
          }
        },
        "ja" : {
          "stringUnit" : {
