    "analysis.score.headlineLow": {
      "comment": "One-liner for the lowest band (< 70). Non-judgemental; asks for one improvement next time.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طبّق اقتراحًا واحدًا من الأسفل في تسجيلك القادم لتحصل على نتائج أكثر فائدة."
