    "practice.kind.pitchStability.instruction" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اقرأ بوتيرة مريحة وراقب تغير طبقة الصوت. يتضمن التنغيم الطبيعي تغيرًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čtěte pohodlným tempem a sledujte kolísání výšky hlasu. Přirozená intonace také obsahuje změny výšky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Læs i et behageligt tempo, og se på variationen i tonehøjden. Naturlig intonation indeholder variation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lies in einem angenehmen Tempo und beobachte die Tonhöhenschwankungen. Natürliche Intonation enthält Schwankungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Διαβάστε με άνετο ρυθμό και παρατηρήστε τη διακύμανση ύψους. Ο φυσικός επιτονισμός περιλαμβάνει διακυμάνσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read at a comfortable pace and observe pitch variation. Natural intonation includes variation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lee a un ritmo cómodo y observa la variación del tono. La entonación natural incluye variaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lue mukavaan tahtiin ja tarkkaile sävelkorkeuden vaihtelua. Luonnolliseen intonaatioon kuuluu vaihtelua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisez à un rythme confortable et observez les variations de hauteur. Une intonation naturelle comporte des variations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "קראו בקצב נוח והתבוננו בשונות הטון. הנגנה טבעית כוללת שונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आरामदायक गति से पढ़ें और पिच का उतार-चढ़ाव देखें। प्राकृतिक बोलचाल के स्वर में उतार-चढ़ाव होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Čitaj ugodnim tempom i promatraj varijacije visine. Prirodna intonacija uključuje varijacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olvass kényelmes tempóban, és figyeld a hangmagasság ingadozását. A természetes hanglejtés változatosságot is tartalmaz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca dengan kecepatan yang nyaman dan amati variasi nada. Intonasi alami mencakup variasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leggi a un ritmo confortevole e osserva la variazione del tono. L'intonazione naturale comprende variazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "楽なペースで読み、音高の変動を確認しましょう。自然なイントネーションにも変動があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "편안한 속도로 읽고 음높이 변동을 살펴보세요. 자연스러운 억양에도 높낮이 변화가 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baca pada kadar yang selesa dan perhatikan variasi pic. Intonasi semula jadi merangkumi variasi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lees in een comfortabel tempo en bekijk de toonhoogtevariatie. Natuurlijke intonatie bevat variatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Czytaj w wygodnym tempie i obserwuj zmienność wysokości głosu. Naturalna intonacja także zawiera wahania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leia em um ritmo confortável e observe a variação de altura. A entonação natural inclui variações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Читайте в удобном темпе и наблюдайте за колебаниями высоты тона. Естественная интонация тоже включает колебания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Läs i ett bekvämt tempo och observera tonhöjdsvariationen. Naturlig intonation innehåller variation."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อ่านด้วยจังหวะสบาย ๆ และสังเกตความแปรผันของระดับเสียง ทำนองเสียงธรรมชาติมีการเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rahat bir hızda oku ve perde değişkenliğini gözlemle. Doğal tonlama değişkenlik içerir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Читайте у зручному темпі й спостерігайте за коливаннями висоти тону. Природна інтонація також має коливання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đọc với tốc độ thoải mái và quan sát độ biến thiên cao độ. Ngữ điệu tự nhiên có sự biến thiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持舒适的节奏读完短句，观察音高波动。自然语调本来就有起伏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以舒適的速度朗讀，觀察音高起伏。自然的語調本來就包含變化。"
          }
        }
      }
    },
