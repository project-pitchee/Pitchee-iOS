    "practice.feedback.scope" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذا حكمك الشخصي بعد الاستماع، ويمكنك تغييره. يُحفظ فقط في السجل المحلي لهذا التسجيل المعاد ولا يؤثر في نتائج النموذج."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jde o váš vlastní poslechový úsudek. Můžete jej změnit. Ukládá se pouze do místní historie této opakované nahrávky a neovlivňuje skóre modelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette er din egen vurdering, når du lytter. Du kan ændre den. Den gemmes kun i denne gentagne optagelses lokale historik og påvirker ikke modellens scorer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies ist deine eigene Einschätzung beim Anhören. Du kannst sie ändern. Sie wird nur im lokalen Verlauf dieser Wiederholungsaufnahme gespeichert und beeinflusst die Modellbewertungen nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή είναι η δική σας κρίση από την ακρόαση. Μπορείτε να την αλλάξετε. Αποθηκεύεται μόνο στο τοπικό ιστορικό αυτής της επαναληπτικής λήψης και δεν επηρεάζει τις βαθμολογίες του μοντέλου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your own listening judgement. You can change it. It is saved only in this repeat take’s local history and does not affect model scores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta es tu propia valoración al escuchar. Puedes cambiarla. Solo se guarda en el historial local de esta toma repetida y no afecta los puntajes del modelo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä on oma arviosi kuulemastasi. Voit muuttaa sitä. Se tallennetaan vain tämän uusintaoton paikalliseen historiaan eikä vaikuta mallin pisteisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il s’agit de votre propre appréciation à l’écoute, que vous pouvez modifier. Elle est enregistrée uniquement dans l’historique local de cette seconde prise et n’influence pas les scores du modèle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "זהו שיפוט ההאזנה האישי שלכם. אפשר לשנות אותו. הוא נשמר רק בהיסטוריה המקומית של הקלטה חוזרת זו ואינו משפיע על ציוני המודל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह सुनने के बाद आपका अपना निर्णय है। आप इसे बदल सकते हैं। यह केवल इस दोहराई गई रिकॉर्डिंग के स्थानीय इतिहास में सेव होता है और मॉडल के स्कोर पर असर नहीं डालता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo je tvoja vlastita procjena na temelju slušanja. Možeš je promijeniti. Sprema se samo u lokalnu povijest ove ponovljene snimke i ne utječe na ocjene modela."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez a saját hallgatási ítéleted. Módosíthatod. Csak ennek az ismételt felvételnek a helyi előzményeibe mentjük, és nem befolyásolja a modell pontszámait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini adalah penilaian Anda sendiri setelah mendengarkan. Anda dapat mengubahnya. Penilaian hanya disimpan di riwayat lokal rekaman ulang ini dan tidak memengaruhi skor model."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa è la tua valutazione personale all'ascolto. Puoi modificarla. Viene salvata solo nella cronologia locale di questa seconda registrazione e non influisce sui punteggi del modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これは自分で聞いて判断した評価で、変更できます。この再練習の端末内履歴にのみ保存され、モデルのスコアには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "직접 듣고 판단한 평가이며 바꿀 수 있어요. 이 재연습의 기기 내 기록에만 저장되고 모델 점수에는 영향을 주지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini ialah penilaian pendengaran anda sendiri. Anda boleh mengubahnya. Ia hanya disimpan dalam sejarah setempat rakaman ulangan ini dan tidak mempengaruhi skor model."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit is je eigen oordeel bij het luisteren. Je kunt het wijzigen. Het wordt alleen opgeslagen in de lokale geschiedenis van deze herhaalde opname en heeft geen invloed op modelscores."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To twoja własna ocena na podstawie odsłuchu. Możesz ją zmienić. Jest zapisywana tylko w lokalnej historii tego powtórnego nagrania i nie wpływa na wyniki modelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta é sua própria avaliação ao ouvir. Você pode alterá-la. Ela é salva apenas no histórico local desta tomada repetida e não afeta as pontuações do modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это ваша субъективная оценка на слух. Её можно изменить. Она сохраняется только в локальной истории этой повторной записи и не влияет на оценки модели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det här är din egen bedömning vid lyssning. Du kan ändra den. Den sparas bara i den upprepade inspelningens lokala historik och påverkar inte modellens poäng."
          }
        },
        "th" : {
          "stringUnit" : {
