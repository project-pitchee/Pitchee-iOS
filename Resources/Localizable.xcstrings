    "piano.note.playbackHint.a11y": {
      "comment": "Describes the tap vs. press-and-hold interaction; keep both gestures explicit for VoiceOver users.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر للتشغيل. اضغط مع الاستمرار لإطالة الصوت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Klepnutím přehrajete tón. Podržením prodloužíte zvuk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryk for at afspille. Hold fingeren nede for at holde tonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Abspielen tippen. Für einen gehaltenen Ton gedrückt lassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Πατήστε για αναπαραγωγή. Κρατήστε πατημένο για συνεχή ήχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to play. Touch and hold to sustain the sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca para reproducir. Mantén presionado para sostener el sonido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soita napauttamalla. Pidä painettuna, niin ääni soi pidempään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez pour jouer. Maintenez le doigt appuyé pour prolonger le son."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו לניגון, והחזיקו לחיצה להשמעת צליל מתמשך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चलाने के लिए टैप करें। आवाज़ बनाए रखने के लिए दबाए रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodirni za reprodukciju. Pritisni i drži za neprekinut ton."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koppints a megszólaltatáshoz. Tartsd nyomva a hang fenntartásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ketuk untuk memainkan. Sentuh dan tahan agar nada bertahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca per suonare. Tieni premuto per prolungare il suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タップで再生します。長押しすると音が持続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭하면 재생되고, 길게 누르면 소리가 이어져요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ketik untuk memainkan bunyi. Sentuh dan tahan untuk mengekalkan bunyi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tik om te spelen. Houd vast om de klank aan te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dotknij, aby zagrać. Dotknij i przytrzymaj, aby podtrzymać dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque para ouvir. Mantenha pressionado para o som continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Коснитесь, чтобы воспроизвести. Нажмите и удерживайте для непрерывного звука."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck för att spela. Håll in för att hålla ut tonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แตะเพื่อเล่น แตะค้างเพื่อให้เสียงต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çalmak için dokun. Sesi sürdürmek için basılı tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Торкніться, щоб відтворити. Утримуйте, щоб звук тривав."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chạm để phát. Chạm và giữ để ngân dài âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点播放，按住可持续发声"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點播放，按住可持續發聲"
          }
        }
      }
    },
