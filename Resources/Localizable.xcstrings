    "scoring.rules.f0Unavailable.title": {
      "comment": "Title of the fallback rule used when no stable fundamental frequency could be detected.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التردد الأساسي غير متاح"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedostupná výška hlasu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tonehøjde utilgængelig"
          }
        },
