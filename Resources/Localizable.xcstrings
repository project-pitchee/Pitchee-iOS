    "voiceProfile.option.undecided.description" : {
      "comment" : "Supports the 'undecided is a valid choice' framing; no pressure, gradual tone.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ابدأ بالتعرّف على صوتك واعثر على اتجاهك مع الوقت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Začněte poznávat svůj hlas a směr najdete postupně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Begynd med at lære din stemme at kende, og find retningen over tid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lern zuerst deine Stimme kennen und finde mit der Zeit deine Richtung"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ξεκινήστε γνωρίζοντας τη φωνή σας και βρείτε την κατεύθυνση με τον χρόνο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start by getting to know your voice and find your direction over time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empieza por conocer tu voz y encuentra tu dirección poco a poco"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutustu ensin ääneesi ja löydä suunta vähitellen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Commencez par apprendre à connaître votre voix, puis trouvez votre direction au fil du temps"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "התחילו מהכרת הקול שלכם ומצאו את הכיוון עם הזמן"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पहले अपनी आवाज़ को समझें, दिशा धीरे-धीरे तय होगी"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najprije upoznaj svoj glas i s vremenom pronađi smjer"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Először ismerd meg a hangodat, és idővel megtalálod az irányt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai dengan mengenal suara Anda dan temukan arahnya seiring waktu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inizia a conoscere la tua voce e trova la direzione con il tempo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "まずは自分の声を知ることから始め、少しずつ方向性を見つけましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "먼저 내 목소리를 알아가며 천천히 방향 찾기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulakan dengan mengenali suara anda dan temui arah anda lama-kelamaan"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Begin met het leren kennen van je stem en vind stap voor stap je richting"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najpierw poznaj swój głos, a kierunek znajdziesz z czasem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primeiro conheça sua voz e encontre sua direção aos poucos"
