    "scoring.rules.f0Unavailable.description" : {
      "comment" : "Guidance giving the user a concrete way to improve the next recording.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُكتشف تردد أساسي مستقر — جرّب في المرة القادمة مكانًا أهدأ وأمسك الهاتف أقرب إلى فمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nebyla rozpoznána stabilní základní frekvence — příště zkuste klidnější místo a držte telefon blíž k ústům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der blev ikke fundet en stabil grundfrekvens. Prøv næste gang et roligere sted, og hold telefonen tættere på munden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wurde keine stabile Grundfrequenz erkannt – versuch es beim nächsten Mal an einem ruhigeren Ort und halte das Telefon näher am Mund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν ανιχνεύθηκε σταθερή θεμελιώδης συχνότητα — την επόμενη φορά δοκιμάστε σε πιο ήσυχο χώρο και κρατήστε το τηλέφωνο πιο κοντά στο στόμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No stable fundamental frequency was detected — next time try a quieter place and hold the phone closer to your mouth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se detectó una frecuencia fundamental estable. La próxima vez, busca un lugar más silencioso y acerca el teléfono a la boca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vakaata perustaajuutta ei tunnistettu – seuraavalla kerralla kannattaa valita rauhallisempi paikka ja pitää puhelin lähempänä suuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucune fréquence fondamentale stable n’a été détectée — la prochaine fois, choisissez un endroit plus calme et rapprochez le téléphone de votre bouche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא זוהתה תדירות יסוד יציבה — בפעם הבאה נסו מקום שקט יותר והחזיקו את הטלפון קרוב יותר לפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोई स्थिर मूल आवृत्ति नहीं मिली — अगली बार शांत जगह चुनें और फ़ोन को मुँह के करीब रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije otkrivena stabilna osnovna frekvencija — sljedeći put odaberi tiše mjesto i drži telefon bliže ustima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nem sikerült stabil alapfrekvenciát észlelni — legközelebb próbálj csendesebb helyen, és tartsd közelebb a telefont a szádhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frekuensi dasar yang stabil tidak terdeteksi — lain kali coba di tempat yang lebih tenang dan lebih dekat ke mikrofon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stata rilevata una frequenza fondamentale stabile: la prossima volta scegli un posto più silenzioso e tieni il telefono più vicino alla bocca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "安定した基本周波数が検出されませんでした。次回は静かな場所で、マイクを口元に近づけて試してみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "안정적인 기본 주파수를 찾지 못했어요. 다음에는 조용한 곳에서 마이크에 조금 더 가까이 대고 녹음해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiada frekuensi asas yang stabil dikesan — lain kali cuba tempat yang lebih senyap dan dekatkan telefon kepada mulut anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er is geen stabiele grondfrequentie gedetecteerd — probeer het de volgende keer op een rustigere plek en houd de telefoon dichter bij je mond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie wykryto stabilnej częstotliwości podstawowej — następnym razem nagraj w cichszym miejscu i bliżej mikrofonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma frequência fundamental estável foi detectada — na próxima vez, procure um lugar mais silencioso e aproxime o telefone da boca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Устойчивая основная частота не обнаружена — в следующий раз выберите место потише и держите телефон ближе ко рту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen stabil grundfrekvens upptäcktes – prova nästa gång en tystare plats och håll telefonen närmare munnen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตรวจไม่พบความถี่มูลฐานที่มั่นคง ครั้งต่อไปลองหาที่เงียบกว่าและถือโทรศัพท์ให้ใกล้ปากมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kararlı bir temel frekans algılanamadı; bir dahaki sefere daha sessiz bir ortamda mikrofona biraz daha yakın konuşmayı dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стабільної основної частоти не виявлено. Наступного разу спробуйте записатися в тихішому місці й тримайте телефон ближче до рота."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không nhận diện được tần số cơ bản ổn định — lần sau hãy thử ở nơi yên tĩnh hơn và để điện thoại gần miệng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有识别到稳定基频，下次可以在安静环境中离麦克风近一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有辨識到穩定基頻，下次可以在安靜環境中離麥克風近一點。"
          }
        }
      }
    },
    "scoring.rules.f0Unavailable.result" : {
