    "practice.audio.cleanupError" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some practice audio could not be cleared. Try finishing again before starting another take."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分练习音频未能清理，请再次结束练习后再开始新录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分练习音频未能清理，请再次结束练习后再开始新录音。"
          }
        }
      }
    },
    "practice.audio.lifetime" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبقى ما يصل إلى تسجيلين صوتيين على هذا الجهاز أثناء التدريب. يؤدي إنهاؤه إلى حذفهما؛ وبعد الإغلاق القسري، يُمسحان عند التشغيل التالي. يحتفظ السجل بالمؤشرات وتفاصيل التدريب وملاحظات الاستماع التي تختارها، دون الصوت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Během tohoto cvičení zůstávají v zařízení nejvýše dvě zvukové nahrávky. Dokončení je odstraní; po vynuceném ukončení se vymažou při dalším spuštění. Historie uchovává ukazatele, podrobnosti cvičení a zvolené hodnocení poslechu, bez zvuku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Op til to lydoptagelser bliver på denne enhed under øvelsen. De slettes, når du afslutter; efter en tvungen lukning ryddes de ved næste start. Historikken gemmer målinger, øvelsesoplysninger og din valgte lyttevurdering uden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Während dieser Übung bleiben bis zu zwei Audioaufnahmen auf diesem Gerät. Beim Beenden werden sie gelöscht; nach erzwungenem Schließen beim nächsten Start. Der Verlauf speichert Kennzahlen, Übungsdetails und dein gewähltes Hörfeedback, ohne Audio."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Έως δύο ηχητικές λήψεις παραμένουν σε αυτή τη συσκευή κατά την εξάσκηση. Η ολοκλήρωση τις διαγράφει· μετά από αναγκαστικό κλείσιμο, διαγράφονται στην επόμενη εκκίνηση. Το ιστορικό κρατά δείκτες, στοιχεία εξάσκησης και την αξιολόγηση ακρόασης που επιλέξατε, χωρίς ήχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to two audio takes stay on this device during this practice. Finishing deletes them; after a force quit, they are cleared at the next launch. History keeps metrics, practice details, and your chosen listening feedback, without audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durante esta práctica, se conservan hasta dos tomas de audio en este dispositivo. Al finalizar, se eliminan; tras un cierre forzado, se borran al volver a abrir la app. El historial conserva las métricas, los detalles de la práctica y la valoración de escucha que elijas, sin audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämän harjoituksen aikana laitteella säilytetään enintään kaksi äänitallennetta. Harjoituksen päättäminen poistaa ne. Pakotetun sulkemisen jälkeen ne tyhjennetään seuraavan käynnistyksen yhteydessä. Historia säilyttää mittarit, harjoituksen tiedot ja valitsemasi kuuntelupalautteen ilman ääntä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jusqu’à deux prises audio restent sur cet appareil pendant cet exercice. Terminer les supprime ; après une fermeture forcée, elles sont effacées au prochain lancement. L’historique conserve les indicateurs, les détails de l’exercice et votre avis d’écoute, sans audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עד שתי הקלטות שמע נשארות במכשיר זה במהלך התרגול. סיום התרגול מוחק אותן; לאחר סגירה כפויה, הן מנוקות בהפעלה הבאה. ההיסטוריה שומרת מדדים, פרטי תרגול ומשוב האזנה שבחרתם, ללא שמע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस अभ्यास के दौरान अधिकतम दो ऑडियो रिकॉर्डिंग इसी डिवाइस पर रहती हैं। अभ्यास पूरा करने पर वे मिट जाती हैं; ऐप को ज़बरदस्ती बंद करने के बाद अगली बार खोलने पर वे मिटाई जाती हैं। इतिहास में मेट्रिक, अभ्यास के विवरण और आपकी चुनी सुनने की प्रतिक्रिया रहती है, ऑडियो नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijekom ove vježbe na uređaju ostaju najviše dvije zvučne snimke. Završetak ih briše; nakon prisilnog zatvaranja brišu se pri sljedećem pokretanju. Povijest zadržava pokazatelje, pojedinosti vježbe i odabranu procjenu slušanja, bez zvuka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A gyakorlás során legfeljebb két hangfelvétel marad ezen az eszközön. A befejezés törli őket; kényszerített bezárás után a következő indításkor törlődnek. Az előzmények megőrzik a mutatókat, a gyakorlás részleteit és a kiválasztott hallgatási visszajelzésedet, hang nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hingga dua rekaman suara tetap berada di perangkat ini selama latihan. Menyelesaikan latihan akan menghapusnya; setelah aplikasi ditutup paksa, rekaman dihapus saat aplikasi dibuka kembali. Riwayat menyimpan metrik, detail latihan, dan masukan hasil mendengarkan yang Anda pilih, tanpa audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durante questa pratica, sul dispositivo rimangono fino a due registrazioni audio. Al termine vengono eliminate; dopo una chiusura forzata vengono cancellate al successivo avvio. La cronologia conserva metriche, dettagli della pratica e la valutazione d'ascolto scelta, senza audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この練習中は最大2回分の音声がこの端末内に留まります。練習を終了すると削除され、強制終了した場合は次回の起動時に消去されます。履歴には指標、練習内容、選択した聞こえ方の評価が保存され、音声は保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번 연습 중에는 최대 두 개의 오디오 녹음이 이 기기에만 남아요. 연습을 마치면 삭제되며, 강제 종료한 경우 다음 실행 시 지워져요. 기록에는 지표, 연습 정보, 선택한 청취 평가만 남고 오디오는 저장되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sehingga dua rakaman audio kekal pada peranti ini semasa latihan. Menamatkan latihan memadamkannya; selepas aplikasi ditutup paksa, rakaman dipadam pada pelancaran seterusnya. Sejarah menyimpan metrik, butiran latihan, dan maklum balas pendengaran yang anda pilih, tanpa audio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijdens deze oefening blijven maximaal twee audio-opnamen op dit apparaat. Afronden verwijdert ze; na geforceerd afsluiten worden ze bij de volgende start gewist. De geschiedenis bewaart meetwaarden, oefendetails en je gekozen luisterbeoordeling, zonder audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podczas tego ćwiczenia na urządzeniu pozostają najwyżej dwa nagrania dźwiękowe. Zakończenie ćwiczenia je usuwa; po wymuszonym zamknięciu są usuwane przy następnym uruchomieniu. Historia zachowuje wskaźniki, szczegóły ćwiczenia i wybraną ocenę odsłuchu, bez dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Até duas tomadas de áudio ficam neste dispositivo durante esta prática. Ao finalizar, elas são excluídas; após um encerramento forçado, são limpas na próxima abertura. O histórico mantém métricas, detalhes da prática e sua avaliação de escuta escolhida, sem áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Во время тренировки на этом устройстве хранятся не более двух аудиозаписей. Завершение тренировки удаляет их; после принудительного закрытия они очищаются при следующем запуске. История хранит показатели, сведения о тренировке и выбранную вами оценку прослушивания, без аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Upp till två ljudinspelningar finns kvar på den här enheten under övningen. När du avslutar raderas de; efter en tvångsavslutning rensas de vid nästa start. Historiken sparar mätvärden, övningsdetaljer och din valda lyssningsbedömning, utan ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระหว่างฝึกจะเก็บเสียงไว้บนอุปกรณ์นี้ไม่เกินสองครั้ง เมื่อจบการฝึกจะลบเสียงเหล่านั้น หากบังคับปิดแอปจะล้างเสียงเมื่อเปิดครั้งถัดไป ประวัติเก็บตัวชี้วัด รายละเอียดการฝึก และความคิดเห็นจากการฟังที่คุณเลือก โดยไม่เก็บเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu çalışma sırasında cihazda en fazla iki ses kaydı tutulur. Çalışmayı bitirmek bunları siler; uygulama zorla kapatılırsa sonraki açılışta temizlenirler. Geçmiş; ölçümleri, çalışma ayrıntılarını ve seçtiğin dinleme geri bildirimini saklar, sesi saklamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Під час цієї вправи на пристрої зберігається щонайбільше два аудіозаписи. Завершення вправи видаляє їх; після примусового закриття вони очищаються під час наступного запуску. Історія зберігає показники, відомості про вправу й вибрану оцінку прослуховування, без аудіо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tối đa hai bản ghi âm được giữ trên thiết bị này trong buổi luyện tập. Kết thúc sẽ xóa chúng; nếu buộc đóng ứng dụng, chúng được xóa ở lần mở tiếp theo. Lịch sử giữ lại chỉ số, chi tiết luyện tập và phản hồi nghe bạn chọn, không giữ âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频只在本次练习内保留，最多两段。结束练习后删除；强制退出后会在下次启动时清理。历史保留指标、练习信息和你选择的听感，不保留音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次練習期間，最多兩段音訊會保留在這台裝置上。結束練習時會刪除；若強制關閉 App，則於下次啟動時清除。歷史紀錄保留指標、練習詳情及你選擇的聆聽回饋，不保留音訊。"
          }
        }
      }
    },
