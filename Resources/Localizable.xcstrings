    "export.pitchImage.chart.gapNote": {
      "comment": "Footnote under the exported chart explaining blank segments.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الفراغات في المنحنى تعني عدم اكتشاف طبقة صوت موثوقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prázdná místa v křivce znamenají, že nebyla rozpoznána spolehlivá výška hlasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Huller i kurven betyder, at der ikke blev registreret en pålidelig tonehøjde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lücken in der Kurve bedeuten, dass keine verlässliche Tonhöhe erkannt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Τα κενά στην καμπύλη σημαίνουν ότι δεν ανιχνεύθηκε αξιόπιστο ύψος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaps in the curve mean no reliable pitch was detected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los espacios en blanco de la curva indican que no se detectó un tono confiable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyrän aukot tarkoittavat, ettei luotettavaa sävelkorkeutta havaittu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les blancs dans la courbe signalent qu’aucune hauteur fiable n’a été détectée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פערים בעקומה מציינים שלא זוהה טון מהימן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वक्र में खाली जगह का मतलब है कि कोई भरोसेमंद पिच नहीं मिली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praznine u krivulji znače da nije otkrivena pouzdana visina glasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A görbe hiányzó szakaszai azt jelentik, hogy nem sikerült megbízható hangmagasságot észlelni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bagian kosong pada kurva berarti tidak ada nada andal yang terdeteksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli spazi vuoti nella curva indicano che non è stato rilevato un tono affidabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "曲線が途切れている部分は、信頼できる音高が検出されなかったことを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "곡선이 끊긴 구간은 신뢰할 수 있는 음높이가 감지되지 않은 곳이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruang kosong pada lengkung bermaksud tiada pic yang boleh dipercayai dikesan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lege stukken in de curve betekenen dat er geen betrouwbare toonhoogte is gedetecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przerwy w krzywej oznaczają, że nie wykryto wiarygodnej wysokości głosu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trechos vazios na curva indicam que nenhuma altura confiável foi detectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрывы кривой означают, что надёжная высота тона не обнаружена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luckor i kurvan betyder att ingen tillförlitlig tonhöjd upptäcktes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ช่วงที่เส้นกราฟขาดหายหมายถึงตรวจไม่พบระดับเสียงที่เชื่อถือได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eğrideki boşluklar güvenilir perde algılanmadığını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пропуски на кривій означають, що достовірної висоти тону не виявлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khoảng trống trên đường cong nghĩa là chưa nhận diện được cao độ tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线空白处表示未检测到可靠音高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "曲線空白處表示未偵測到可靠音高。"
          }
        }
      }
    },
