    "export.error.imageSaveFailed.message": {
      "comment": "Shown when an image cannot be saved to Files or Photos, typically because there is not enough storage space.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر حفظ الصورة. تحقق من المساحة المتاحة وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrázek se nepodařilo uložit. Zkontrolujte volné místo v úložišti a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Billedet kunne ikke gemmes. Tjek lagerpladsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bild konnte nicht gespeichert werden. Prüfe den verfügbaren Speicherplatz und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η εικόνα δεν ήταν δυνατό να αποθηκευτεί. Ελέγξτε τον διαθέσιμο χώρο αποθήκευσης και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image couldn't be saved. Check your available storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo guardar la imagen. Revisa el espacio disponible y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvan tallentaminen ei onnistunut. Tarkista tallennustila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’image n’a pas pu être enregistrée. Vérifiez l’espace de stockage disponible et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "התמונה לא נשמרה. בדקו את שטח האחסון הפנוי ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तस्वीर सेव नहीं हो सकी। उपलब्ध स्टोरेज जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sliku nije bilo moguće spremiti. Provjeri dostupni prostor i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A képet nem sikerült elmenteni. Ellenőrizd a szabad tárhelyet, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gambar tidak dapat disimpan. Periksa ruang penyimpanan yang tersedia, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile salvare l'immagine. Controlla lo spazio disponibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "画像を保存できませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이미지를 저장하지 못했어요. 저장 공간을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imej tidak dapat disimpan. Semak ruang storan yang tersedia dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De afbeelding kon niet worden opgeslagen. Controleer de vrije opslagruimte en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się zapisać obrazu. Sprawdź wolne miejsce w pamięci i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível salvar a imagem. Verifique o espaço disponível e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось сохранить изображение. Проверьте свободное место и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilden kunde inte sparas. Kontrollera ledigt lagringsutrymme och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกรูปภาพไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Görsel kaydedilemedi. Boş depolama alanını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зберегти зображення. Перевірте вільне місце на пристрої та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không lưu được hình ảnh. Hãy kiểm tra dung lượng còn trống rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片未能保存，请检查存储空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "圖片未能儲存，請檢查儲存空間後重試。"
          }
        }
      }
    },
