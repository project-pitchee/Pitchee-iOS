    "onboarding.welcome.featurePrivacy.description": {
      "comment": "Keep the two-clause shape: where analysis happens + what never leaves the device.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم التحليل على الجهاز، ولا تُرفع التسجيلات أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analýza probíhá v zařízení; nahrávky se nikdy neodesílají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analysen kører på enheden; optagelser uploades aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Analyse läuft auf dem Gerät; Aufnahmen werden nie hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η ανάλυση γίνεται στη συσκευή· οι ηχογραφήσεις δεν ανεβαίνουν ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis runs on device; recordings are never uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El análisis se hace en el dispositivo; las grabaciones nunca se suben."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analyysi tehdään laitteella; tallennuksia ei koskaan lähetetä palvelimelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’analyse se fait sur l’appareil ; les enregistrements ne sont jamais envoyés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניתוח מתבצע במכשיר; ההקלטות לא מועלות לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "विश्लेषण डिवाइस पर ही होता है; रिकॉर्डिंग कभी अपलोड नहीं होती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiza se izvodi na uređaju; snimke se nikada ne prenose na server."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az elemzés a készülékeden fut; a felvételek soha nem kerülnek fel a szerverre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analisis berjalan di perangkat; rekaman tidak pernah diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'analisi avviene sul dispositivo; le registrazioni non vengono mai caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分析は端末上で行い、録音はアップロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기에서 분석하고, 녹음은 업로드하지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analisis dijalankan pada peranti; rakaman tidak pernah dimuat naik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De analyse gebeurt op je apparaat; opnames worden nooit geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiza odbywa się na urządzeniu; nagrania nie są nigdzie wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A análise acontece no dispositivo; as gravações nunca são enviadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Анализ выполняется на устройстве; записи не загружаются в сеть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analysen sker på enheten; inspelningar laddas aldrig upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "วิเคราะห์บนอุปกรณ์ และการบันทึกเสียงจะไม่ถูกอัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiz cihazda yapılır; kayıtlar hiçbir yere yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аналіз виконується на пристрої; записи ніколи не завантажуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phân tích ngay trên thiết bị; bản ghi âm không bao giờ được tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上分析，录音不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
