    "practice.trend.scope" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قارن التسجيلات المؤهلة التي تستخدم المقطع والمحور والهدف والنموذج وقواعد التقييم نفسها. تظل السجلات القديمة والتسجيلات ذات مشكلات الجودة في السجل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnávejte vhodné nahrávky se stejným textem, zaměřením, cílem, modelem a pravidly výpočtu. Starší záznamy a nahrávky s problémy s kvalitou zůstávají v historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammenlign egnede optagelser med samme tekst, fokus, mål, model og scoreregler. Ældre registreringer og optagelser med kvalitetsproblemer bliver i historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergleiche geeignete Aufnahmen mit gleichem Text, Schwerpunkt, Ziel, Modell und gleichen Bewertungsregeln. Ältere Datensätze und Aufnahmen mit Qualitätsproblemen bleiben im Verlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγκρίνετε κατάλληλες εγγραφές με ίδιο κείμενο, σημείο εστίασης, στόχο, μοντέλο και κανόνες βαθμολόγησης. Παλαιότερες εγγραφές και εγγραφές με προβλήματα ποιότητας παραμένουν στο ιστορικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare eligible recordings with the same passage, focus, goal, model, and scoring rules. Older records and recordings with quality issues remain in history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara grabaciones aptas con el mismo texto, aspecto, objetivo, modelo y reglas de puntuación. Los registros antiguos y las grabaciones con problemas de calidad permanecen en el historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertaa soveltuvia tallenteita, joissa on sama teksti, kohde, tavoite, malli ja pisteytyssäännöt. Vanhat tietueet ja laadultaan puutteelliset tallenteet säilyvät historiassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparez les prises admissibles ayant les mêmes passage, axe de travail, objectif, modèle et règles de notation. Les anciens enregistrements et ceux présentant des problèmes de qualité restent dans l’historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השוו הקלטות מתאימות עם אותו קטע, מוקד, יעד, מודל וכללי ניקוד. רשומות ישנות והקלטות עם בעיות איכות נשארות בהיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समान अंश, केंद्र-बिंदु, लक्ष्य, मॉडल और स्कोरिंग नियमों वाली योग्य रिकॉर्डिंग की तुलना करें। पुराने रिकॉर्ड और गुणवत्ता की समस्या वाली रिकॉर्डिंग इतिहास में बनी रहती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uspoređuj prikladne snimke s istim tekstom, fokusom, ciljem, modelom i pravilima ocjenjivanja. Stariji zapisi i snimke s problemima kvalitete ostaju u povijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Azonos szöveggel, fókusszal, céllal, modellel és pontozási szabályokkal készült megfelelő felvételeket hasonlíts össze. A régebbi bejegyzések és a minőségi problémás felvételek megmaradnak az előzményekben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan rekaman yang memenuhi syarat dengan teks, fokus, tujuan, model, dan aturan penilaian yang sama. Catatan lama dan rekaman bermasalah kualitas tetap ada dalam riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confronta registrazioni idonee con lo stesso brano, aspetto, obiettivo, modello e regole di punteggio. I record più vecchi e le registrazioni con problemi di qualità restano nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文章、注目する項目、目標、モデル、採点ルールが同じで、条件を満たす録音を比較します。古い記録や品質に問題のある録音は履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "글, 집중 항목, 목표, 모델, 점수 규칙이 같은 유효 녹음끼리 비교해요. 이전 기록과 품질 문제가 있는 녹음은 기록에 남아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan rakaman yang layak dengan petikan, fokus, sasaran, model, dan peraturan pemarkahan yang sama. Rekod lama dan rakaman yang bermasalah kualiti kekal dalam sejarah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergelijk geschikte opnamen met dezelfde tekst, hetzelfde aandachtspunt, doel, model en dezelfde scoreregels. Oudere registraties en opnamen met kwaliteitsproblemen blijven in de geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównuj kwalifikujące się nagrania o tym samym tekście, elemencie ćwiczenia, celu, modelu i zasadach obliczania. Starsze zapisy i nagrania z problemami jakości pozostają w historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compare gravações elegíveis com o mesmo texto, foco, objetivo, modelo e regras de pontuação. Registros antigos e gravações com problemas de qualidade permanecem no histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сравнивайте подходящие записи с одинаковыми текстом, аспектом упражнения, целью, моделью и правилами расчёта. Старые записи и записи с проблемами качества остаются в истории."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jämför lämpliga inspelningar med samma text, fokus, mål, modell och poängregler. Äldre poster och inspelningar med kvalitetsproblem finns kvar i historiken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปรียบเทียบบันทึกที่เข้าเกณฑ์และใช้บท จุดฝึก เป้าหมาย โมเดล และกฎการให้คะแนนเดียวกัน ข้อมูลเก่าและบันทึกที่มีปัญหาคุณภาพยังอยู่ในประวัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aynı metin, odak, hedef, model ve puanlama kurallarına sahip uygun kayıtları karşılaştır. Eski kayıtlar ve kalite sorunlu kayıtlar geçmişte kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівнюйте придатні записи з однаковими текстом, аспектом вправи, метою, моделлю й правилами розрахунку. Старі записи й записи з проблемами якості залишаються в історії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sánh các bản ghi đủ điều kiện có cùng đoạn văn, trọng tâm, mục tiêu, mô hình và quy tắc tính điểm. Bản ghi cũ và bản ghi có vấn đề chất lượng vẫn được giữ trong lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只比较相同文本、关注点、目标、模型与评分规则的有效录音。旧记录和质量不足的记录仍在历史中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較使用相同段落、重點、目標、模型和評分規則的有效錄音。舊紀錄及品質有問題的錄音仍會保留在歷史紀錄中。"
          }
        }
      }
    },
