    "insights.metric.naturalness.description" : {
      "comment" : "Explanation of naturalness as a model estimate, including recording variability.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الطبيعية هي تقدير النموذج لمدى استمرارية الصوت وطبيعيته، على مقياس 0–100. قد يؤثر محتوى التسجيل والبيئة المحيطة في النتائج، لذا قارن في ظروف متشابهة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přirozenost je odhad modelu, jak plynule a přirozeně hlas zní, na stupnici 0–100. Obsah nahrávky a okolní prostředí mohou výsledek ovlivnit, proto porovnávejte podobné podmínky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturlighed er modellens vurdering af, hvor sammenhængende og naturlig stemmen lyder, på en skala fra 0 til 100. Optagelsens indhold og omgivelser kan påvirke resultatet, så sammenlign under lignende forhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natürlichkeit ist die Einschätzung des Modells, wie zusammenhängend und natürlich die Stimme klingt, auf einer Skala von 0 bis 100. Inhalt und Umgebung können das Ergebnis beeinflussen; vergleiche ähnliche Bedingungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η φυσικότητα είναι η εκτίμηση του μοντέλου για το πόσο συνεχής και φυσική ακούγεται μια φωνή, σε κλίμακα 0–100. Το περιεχόμενο και το περιβάλλον της εγγραφής επηρεάζουν τα αποτελέσματα, γι’ αυτό συγκρίνετε παρόμοιες συνθήκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturalness is the model’s estimate of how continuous and natural a voice sounds, on a 0–100 scale. Recording content and surroundings can affect results, so compare similar conditions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La naturalidad es la estimación del modelo sobre la continuidad y naturalidad de la voz, en una escala de 0–100. El contenido y el entorno de la grabación pueden afectar los resultados; compara condiciones similares."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Luonnollisuus on mallin arvio äänen yhtenäisyydestä ja luonnollisuudesta asteikolla 0–100. Tallenteen sisältö ja ympäristö voivat vaikuttaa tuloksiin, joten vertaa samankaltaisia olosuhteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le naturel est l’estimation du modèle de la continuité et du caractère naturel de la voix, de 0 à 100. Le contenu et l’environnement influencent les résultats : comparez des conditions similaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "טבעיות היא הערכת המודל למידת הרציפות והטבעיות של הקול, בסולם 0–100. תוכן ההקלטה והסביבה עשויים להשפיע על התוצאות, ולכן כדאי להשוות בתנאים דומים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्वाभाविकता, आवाज़ कितनी निरंतर और प्राकृतिक लगती है इसका मॉडल द्वारा 0–100 के पैमाने पर अनुमान है। रिकॉर्डिंग की सामग्री और परिवेश परिणामों पर असर डाल सकते हैं, इसलिए समान परिस्थितियों में तुलना करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prirodnost je procjena modela o tome koliko glas zvuči povezano i prirodno, na ljestvici 0–100. Sadržaj snimke i okolina mogu utjecati na rezultat, pa uspoređuj slične uvjete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A természetesség a modell becslése arról, mennyire folyamatos és természetes a hangzás, 0–100 közötti skálán. A felvétel tartalma és környezete befolyásolhatja az eredményt, ezért hasonló körülményeket hasonlíts össze."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kealamian adalah perkiraan model tentang kesinambungan dan kealamian suara pada skala 0–100. Isi rekaman dan lingkungan dapat memengaruhi hasil, jadi bandingkan rekaman dalam kondisi serupa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La naturalezza è la stima del modello della continuità e naturalezza della voce, su una scala da 0 a 100. Contenuto e ambiente della registrazione possono influenzare i risultati: confronta condizioni simili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自然度は、声がどれだけ滑らかで自然に聞こえるかをモデルが0～100で推定した値です。録音内容や周囲の環境も結果に影響するため、近い条件で比較してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자연스러움은 목소리가 얼마나 이어지고 자연스럽게 들리는지를 모델이 0~100으로 추정한 값이에요. 녹음 내용과 주변 환경도 결과에 영향을 주므로 비슷한 조건에서 비교해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kewajaran ialah anggaran model tentang kesinambungan dan keaslian bunyi suara, pada skala 0–100. Kandungan rakaman dan persekitaran boleh mempengaruhi hasil, jadi bandingkan dalam keadaan yang serupa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natuurlijkheid is de schatting van het model van hoe vloeiend en natuurlijk een stem klinkt, op een schaal van 0–100. De inhoud en omgeving van de opname kunnen de resultaten beïnvloeden; vergelijk dus onder vergelijkbare omstandigheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturalność to szacowana przez model ocena płynności i naturalności głosu w skali 0–100. Treść nagrania i otoczenie mogą wpływać na wynik, dlatego porównuj podobne warunki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A naturalidade é a estimativa do modelo de quão contínua e natural a voz soa, em uma escala de 0–100. O conteúdo e o ambiente da gravação podem afetar os resultados; compare condições semelhantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Естественность — оценка модели того, насколько связно и естественно звучит голос, по шкале от 0 до 100. Содержание записи и окружение влияют на результат, поэтому сравнивайте записи в похожих условиях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturlighet är modellens uppskattning av hur sammanhängande och naturlig rösten låter, på en skala från 0 till 100. Inspelningens innehåll och omgivning kan påverka resultatet, så jämför under liknande förhållanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ความเป็นธรรมชาติคือค่าที่โมเดลประเมินความต่อเนื่องและความเป็นธรรมชาติของเสียงบนมาตรา 0–100 เนื้อหาและสภาพแวดล้อมในการบันทึกอาจส่งผลต่อผลลัพธ์ จึงควรเปรียบเทียบในสภาวะที่ใกล้เคียงกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doğallık, modelin sesin ne kadar kesintisiz ve doğal duyulduğuna ilişkin 0–100 ölçeğindeki tahminidir. Kayıt içeriği ve ortam sonuçları etkileyebilir; bu nedenle benzer koşulları karşılaştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Природність — це оцінка моделі того, наскільки зв’язно й природно звучить голос, за шкалою від 0 до 100. Зміст запису та оточення впливають на результат, тому порівнюйте схожі умови."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Độ tự nhiên là ước tính của mô hình về mức độ liền mạch và tự nhiên của giọng nói, trên thang 0–100. Nội dung ghi âm và môi trường có thể ảnh hưởng đến kết quả, vì vậy nên so sánh trong điều kiện tương tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然度反映分析模型对声音连贯、自然程度的评估，范围为 0–100。录音内容和环境也会影响结果，适合在相近条件下比较。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然度反映分析模型對聲音連貫、自然程度的評估，範圍為 0–100。錄音內容和環境也會影響結果，適合在相近條件下比較。"
          }
        }
      }
    },
