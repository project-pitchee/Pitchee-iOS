    "practice.trend.empty" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا توجد نتائج تدريب قابلة للمقارنة بعد. أكمل تدريبًا قصيرًا يجتاز فحوص التسجيل لعرض الوسيط والنطاق والأعداد المؤهلة يوميًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zatím nejsou srovnatelné výsledky cvičení. Dokončete krátké cvičení, které projde kontrolami nahrávky, a zobrazí se denní mediány, rozsahy a počty vhodných nahrávek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen sammenlignelige øvelsesresultater endnu. Gennemfør en kort øvelse, der består optagelseskontrollerne, for at se dagsmedianer, intervaller og antal egnede optagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noch keine vergleichbaren Übungsergebnisse. Schließe eine kurze Übung ab, die die Aufnahmeprüfungen besteht, um Tagesmediane, Wertebereiche und Anzahlen geeigneter Aufnahmen zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν υπάρχουν ακόμη συγκρίσιμα αποτελέσματα εξάσκησης. Ολοκληρώστε μια σύντομη εξάσκηση που περνά τους ελέγχους εγγραφής για να δείτε ημερήσιες διαμέσους, εύρη και πλήθος κατάλληλων λήψεων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No comparable practice results yet. Complete a short practice that passes recording checks to see daily medians, ranges, and eligible counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aún no hay resultados de práctica comparables. Completa una práctica breve que supere las comprobaciones de grabación para ver las medianas, los intervalos y los recuentos de tomas aptas de cada día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertailukelpoisia harjoitustuloksia ei vielä ole. Tee lyhyt harjoitus, joka läpäisee tallennustarkistukset, jotta näet päivittäiset mediaanit, vaihteluvälit ja soveltuvien ottojen määrät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun résultat comparable pour le moment. Terminez un court exercice passant les contrôles d’enregistrement pour voir les médianes, les plages et les nombres de prises admissibles par jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עדיין אין תוצאות תרגול שניתן להשוות. השלימו תרגול קצר שעובר את בדיקות ההקלטה כדי לראות חציונים יומיים, טווחים ומספר הקלטות מתאימות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अभी तुलना योग्य अभ्यास परिणाम नहीं हैं। दैनिक माध्यिका, सीमा और योग्य रिकॉर्डिंग की संख्या देखने के लिए रिकॉर्डिंग जाँच में सफल होने वाला छोटा अभ्यास पूरा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Još nema usporedivih rezultata vježbe. Dovrši kratku vježbu koja prolazi provjere snimanja da vidiš dnevne medijane, raspone i broj prikladnih snimki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Még nincsenek összehasonlítható gyakorlási eredmények. Végezz el egy rövid, a felvételi ellenőrzéseken átmenő gyakorlást a napi mediánok, tartományok és megfelelő felvételszámok megtekintéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Belum ada hasil latihan yang dapat dibandingkan. Selesaikan latihan singkat yang lolos pemeriksaan rekaman untuk melihat median harian, rentang, dan jumlah rekaman yang memenuhi syarat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non ci sono ancora risultati di pratica confrontabili. Completa una breve pratica che superi i controlli di registrazione per vedere mediane, intervalli e conteggi idonei giornalieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "比較できる練習結果はまだありません。録音チェックを通過する短い練習を終えると、日別の中央値、範囲、有効な録音数が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아직 비교 가능한 연습 결과가 없어요. 녹음 점검을 통과한 짧은 연습을 완료하면 일별 중앙값, 범위, 유효 녹음 수가 표시돼요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Belum ada hasil latihan yang boleh dibandingkan. Lengkapkan latihan ringkas yang lulus semakan rakaman untuk melihat median harian, julat, dan bilangan yang layak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nog geen vergelijkbare oefenresultaten. Voltooi een korte oefening die aan de opnamecontroles voldoet om dagmedianen, bereiken en aantallen geschikte opnamen te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie ma jeszcze porównywalnych wyników ćwiczeń. Wykonaj krótkie ćwiczenie, które przejdzie kontrole nagrania, aby zobaczyć dzienne mediany, zakresy i liczby kwalifikujących się nagrań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ainda não há resultados de prática comparáveis. Conclua uma prática curta que passe nas verificações de gravação para ver medianas, faixas e contagens elegíveis por dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сопоставимых результатов тренировки пока нет. Выполните короткую тренировку, прошедшую проверки записи, чтобы увидеть дневные медианы, диапазоны и число подходящих записей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inga jämförbara övningsresultat ännu. Genomför en kort övning som klarar inspelningskontrollerna för att se dagsmedianer, intervall och antal lämpliga inspelningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ยังไม่มีผลการฝึกที่เปรียบเทียบได้ ฝึกสั้น ๆ ให้ผ่านการตรวจบันทึกเสียงเพื่อดูมัธยฐาน ช่วงค่า และจำนวนครั้งที่เข้าเกณฑ์รายวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Henüz karşılaştırılabilir çalışma sonucu yok. Günlük medyanları, aralıkları ve uygun kayıt sayılarını görmek için kayıt kontrollerini geçen kısa bir çalışma tamamla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівнюваних результатів вправ ще немає. Виконайте коротку вправу, що пройде перевірки запису, щоб побачити денні медіани, діапазони й кількість придатних записів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chưa có kết quả luyện tập có thể so sánh. Hoàn thành một bài luyện ngắn đạt kiểm tra bản ghi để xem trung vị, khoảng giá trị và số lần đủ điều kiện mỗi ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有可比较的练习结果。完成一次录音检查通过的短练习后，这里会显示中位数、范围和有效次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無可比較的練習結果。完成一次通過錄音檢查的短練習，即可查看每日中位數、範圍和有效錄音數量。"
          }
        }
      }
    },
