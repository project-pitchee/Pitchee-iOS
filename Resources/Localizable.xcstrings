          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tijdelijke opnames worden na de analyse verwijderd; de geschiedenis bewaart alleen de analyseresultaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tymczasowe nagrania są usuwane po analizie; historia przechowuje tylko wyniki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As gravações temporárias são excluídas após a análise; o histórico guarda apenas os resultados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Временные записи удаляются после анализа; в истории сохраняются только результаты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tillfälliga inspelningar raderas efter analysen; historiken sparar bara analysresultaten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "การบันทึกเสียงชั่วคราวจะถูกลบหลังการวิเคราะห์ และประวัติจะเก็บเฉพาะผลการวิเคราะห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geçici kayıtlar analizden sonra silinir; geçmişte yalnızca analiz sonuçları saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тимчасові записи видаляються після аналізу; в історії зберігаються лише результати аналізу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bản ghi tạm được xóa sau khi phân tích; lịch sử chỉ lưu kết quả phân tích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音只在本机分析。本次练习最多保留两段音频用于回听，结束后清理；强制退出后在下次启动时清理。历史保存分析指标与练习信息，不保留音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析結束後清理暫存錄音，歷史記錄僅儲存分析結果。"
          }
        }
      }
    },
