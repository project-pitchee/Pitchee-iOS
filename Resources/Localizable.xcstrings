    "analysis.progress.subtitle" : {
      "comment" : "Two sentences split by a hard line break: (1) what is being analyzed and that it happens on device, (2) an expectation that the first run is slower.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نحلّل طبقة الصوت وخصائصها على جهازك.\nقد يستغرق التحليل الأول بعض الوقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analyzujeme výšku hlasu a hlasové vlastnosti přímo v zařízení.\nPrvní analýza může chvíli trvat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analyserer tonehøjde og stemmetræk på din enhed.\nDen første analyse kan tage lidt tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonhöhe und Stimmmerkmale werden auf deinem Gerät analysiert.\nDie erste Analyse kann etwas dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το ύψος και τα χαρακτηριστικά της φωνής αναλύονται στη συσκευή σας.\nΗ πρώτη ανάλυση μπορεί να διαρκέσει λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyzing pitch and voice features on your device.\nThe first analysis may take a little while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analizando el tono y las características de tu voz en el dispositivo.\nEl primer análisis puede tardar un poco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analysoidaan sävelkorkeutta ja äänen piirteitä laitteellasi.\nEnsimmäinen analyysi voi kestää hetken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analyse de la hauteur et des caractéristiques de la voix sur votre appareil.\nLa première analyse peut prendre un peu de temps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מנתחים טון ומאפיינים קוליים במכשיר שלכם.\nהניתוח הראשון עשוי לקחת קצת זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके डिवाइस पर पिच और आवाज़ की विशेषताओं का विश्लेषण हो रहा है।\nपहली बार विश्लेषण में थोड़ा समय लग सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analiziramo visinu i značajke glasa na tvom uređaju.\nPrva analiza može potrajati nešto dulje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangmagasság és a hang jellemzőinek elemzése a készülékeden történik.\nAz első elemzés eltarthat egy kis ideig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menganalisis nada dan karakteristik suara di perangkat Anda.\nAnalisis pertama mungkin perlu sedikit waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Analisi di tono e caratteristiche della voce sul dispositivo.\nLa prima analisi può richiedere un po' di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "端末上で音高と声の特徴を分析しています。\n初回の分析には少し時間がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기기에서 음높이와 음성 특징을 분석하고 있어요.\n첫 분석은 조금 더 걸릴 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
