    "practice.suggestion.listen.description" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الطبيعية هي ناتج النموذج لهذا التسجيل. لا تثبت النتيجة المنخفضة وجود مشكلة صوتية. استخدم صوتًا مريحًا والمسافة نفسها من الميكروفون، وكرر المقطع نفسه، ثم استمع لتقييم التغيرات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přirozenost je výstup modelu pro tuto nahrávku. Nízké skóre nedokazuje problém s hlasem. Použijte pohodlný hlas a stejnou vzdálenost od mikrofonu, opakujte stejný text a poslechem zhodnoťte změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturlighed er et modelresultat for denne optagelse. En lav score dokumenterer ikke et stemmeproblem. Brug en behagelig stemme og samme mikrofonafstand, gentag den samme tekst, og lyt for at vurdere ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natürlichkeit ist eine Modellausgabe für diese Aufnahme. Eine niedrige Bewertung belegt kein Stimmproblem. Sprich mit angenehmer Stimme bei gleichem Mikrofonabstand, wiederhole denselben Text und höre ihn an, um Veränderungen einzuschätzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η φυσικότητα είναι έξοδος του μοντέλου για αυτή την εγγραφή. Μια χαμηλή βαθμολογία δεν τεκμηριώνει πρόβλημα φωνής. Με άνετη φωνή και την ίδια απόσταση από το μικρόφωνο, επαναλάβετε το κείμενο και ακούστε για να αξιολογήσετε τις αλλαγές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturalness is a model output for this recording. A low score does not establish a voice problem. Use a comfortable voice and the same microphone distance, repeat the same passage, and listen to assess changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La naturalidad es un resultado del modelo para esta grabación. Un puntaje bajo no demuestra un problema de voz. Usa una voz cómoda y la misma distancia al micrófono, repite el mismo texto y escucha para valorar los cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Luonnollisuus on mallin tulos tälle tallenteelle. Matala pistemäärä ei osoita ääniongelmaa. Käytä mukavaa ääntä ja samaa mikrofonietäisyyttä, toista sama teksti ja arvioi muutoksia kuuntelemalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le naturel est une sortie du modèle pour cet enregistrement. Un score faible ne prouve pas un problème vocal. Utilisez une voix confortable, gardez la même distance du microphone, répétez le même passage et écoutez pour évaluer les changements."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "טבעיות היא פלט המודל להקלטה זו. ציון נמוך אינו מבסס בעיה בקול. השתמשו בקול נוח ובאותו מרחק מהמיקרופון, חזרו על אותו קטע והאזינו כדי להעריך שינויים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्वाभाविकता इस रिकॉर्डिंग के लिए मॉडल का आउटपुट है। कम स्कोर आवाज़ में समस्या साबित नहीं करता। सहज आवाज़ और माइक्रोफ़ोन से समान दूरी का इस्तेमाल करें, वही अंश दोहराएँ और बदलाव आँकने के लिए सुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prirodnost je izlaz modela za ovu snimku. Niska ocjena ne dokazuje problem s glasom. Koristi ugodan glas i istu udaljenost od mikrofona, ponovi isti tekst i poslušaj za procjenu promjena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A természetesség a modell eredménye erre a felvételre. Az alacsony pontszám nem igazol hangproblémát. Használj kényelmes hangot és azonos mikrofontávolságot, ismételd meg ugyanazt a szöveget, és visszahallgatással értékeld a változásokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kealamian adalah keluaran model untuk rekaman ini. Skor rendah tidak membuktikan adanya masalah suara. Gunakan suara yang nyaman dan jarak mikrofon yang sama, ulangi teks yang sama, lalu dengarkan untuk menilai perubahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La naturalezza è un risultato del modello per questa registrazione. Un punteggio basso non dimostra un problema vocale. Usa una voce confortevole e la stessa distanza dal microfono, ripeti lo stesso brano e ascolta per valutare i cambiamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自然度は、この録音に対するモデルの出力です。スコアが低いだけでは発声に問題があるとは判断できません。楽な声と同じマイク距離で同じ文章を繰り返し、聞き返して変化を確かめましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자연스러움은 이 녹음에 대한 모델의 출력이에요. 점수가 낮다는 것만으로 발성 문제를 판단할 수는 없어요. 편안한 목소리와 같은 마이크 거리를 유지해 같은 글을 다시 읽고, 들어 보며 변화를 살펴보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kewajaran ialah output model untuk rakaman ini. Skor rendah tidak membuktikan masalah suara. Gunakan suara yang selesa dan jarak mikrofon yang sama, ulang petikan yang sama, dan dengar untuk menilai perubahan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natuurlijkheid is een modeluitvoer voor deze opname. Een lage score toont geen stemprobleem aan. Gebruik een comfortabele stem en dezelfde microfoonafstand, herhaal dezelfde tekst en luister om veranderingen te beoordelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturalność to wynik modelu dla tego nagrania. Niski wynik nie dowodzi problemu z głosem. Mów swobodnie, zachowując tę samą odległość od mikrofonu, powtórz ten sam tekst i posłuchaj, aby ocenić zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A naturalidade é uma saída do modelo para esta gravação. Uma pontuação baixa não comprova um problema vocal. Use uma voz confortável e a mesma distância do microfone, repita o mesmo texto e ouça para avaliar as mudanças."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Естественность — результат модели для этой записи. Низкая оценка не доказывает наличие проблемы с голосом. Говорите комфортным голосом на том же расстоянии от микрофона, повторите текст и прослушайте записи, чтобы оценить изменения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturlighet är ett modellresultat för den här inspelningen. En låg poäng visar inte att det finns ett röstproblem. Använd en bekväm röst och samma mikrofonavstånd, upprepa samma text och lyssna för att bedöma förändringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ความเป็นธรรมชาติเป็นผลจากโมเดลสำหรับเสียงครั้งนี้ คะแนนต่ำไม่ยืนยันว่ามีปัญหาเสียง ใช้เสียงที่สบายและระยะไมโครโฟนเดิม อ่านบทเดิมซ้ำ แล้วฟังเพื่อประเมินการเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doğallık, modelin bu kayıt için ürettiği bir çıktıdır. Düşük puan, ses sorunu olduğunu kanıtlamaz. Rahat bir ses kullan, aynı mikrofon mesafesini koru, aynı metni tekrarla ve değişimleri değerlendirmek için dinle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Природність — це результат моделі для цього запису. Низька оцінка не доводить наявності проблеми з голосом. Говоріть комфортним голосом на тій самій відстані від мікрофона, повторіть текст і прослухайте записи, щоб оцінити зміни."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Độ tự nhiên là đầu ra của mô hình cho bản ghi này. Điểm thấp không xác lập vấn đề về giọng nói. Dùng giọng thoải mái và cùng khoảng cách tới micrô, đọc lại cùng đoạn văn rồi nghe để đánh giá thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然度是模型对这段录音的输出，低分不能确定说明发声有问题。保持舒适的声音与相同录音距离，用同一句复练，再结合回听判断变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然度是模型對這次錄音的輸出，低分並不能證明聲音有問題。請使用舒適的聲音，保持相同麥克風距離，重讀同一段文字，再透過聆聽評估變化。"
          }
        }
      }
    },
    "practice.suggestion.listen.subtitle" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قارن تسجيلين للمقطع نفسه وفكّر في مدى الراحة أثناءهما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porovnejte dvě nahrávky stejného textu a zvažte, jak pohodlné pro vás mluvení bylo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sammenlign to optagelser af samme tekst, og overvej, hvor behagelige de føltes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergleiche zwei Aufnahmen desselben Texts und berücksichtige, wie angenehm sie sich angefühlt haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Συγκρίνετε δύο λήψεις του ίδιου κειμένου και λάβετε υπόψη πόσο άνετα νιώσατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare two takes of the same passage and consider how comfortable they felt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compara dos tomas del mismo texto y ten en cuenta la comodidad que sentiste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertaa saman tekstin kahta ottoa ja huomioi, kuinka mukavalta ne tuntuivat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comparez deux prises du même passage en tenant compte du confort ressenti."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השוו שתי הקלטות של אותו קטע והתחשבו במידת הנוחות שחשתם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक ही अंश की दो रिकॉर्डिंग की तुलना करें और बोलते समय महसूस हुई सहजता पर विचार करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usporedi dvije snimke istog teksta i uzmi u obzir koliko ti je bilo ugodno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasonlítsd össze ugyanannak a szövegnek két felvételét, és vedd figyelembe, mennyire voltak kényelmesek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan dua rekaman dari teks yang sama dan pertimbangkan kenyamanan saat mengucapkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confronta due registrazioni dello stesso brano e considera anche il comfort durante la lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同じ文章の2回の録音を比べ、発声がどのくらい楽だったかも考えてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "같은 글을 두 번 녹음한 결과를 비교하고 얼마나 편안했는지도 생각해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bandingkan dua rakaman petikan yang sama dan pertimbangkan keselesaan semasa membacanya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vergelijk twee opnamen van dezelfde tekst en bedenk hoe comfortabel ze voelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porównaj dwa nagrania tego samego tekstu i uwzględnij odczuwany komfort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compare duas tomadas do mesmo texto e considere o conforto que sentiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сравните две записи одного текста и учтите, насколько комфортно было говорить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jämför två inspelningar av samma text och fundera på hur bekväma de kändes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "เปรียบเทียบการอ่านบทเดียวกันสองครั้งและพิจารณาว่ารู้สึกสบายเพียงใด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aynı metnin iki kaydını karşılaştır ve okurken ne kadar rahat hissettiğini değerlendir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Порівняйте два записи того самого тексту й врахуйте, наскільки комфортно було говорити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So sánh hai lần đọc cùng đoạn văn và cân nhắc cảm giác thoải mái khi đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对照同一句的两次录音，结合自己的舒适感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較同一段文字的兩次錄音，也考慮當時是否感到舒適。"
          }
        }
      }
    },
