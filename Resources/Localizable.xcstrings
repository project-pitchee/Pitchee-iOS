    "scoring.rules.passBoost.description" : {
      "comment" : "Guidance for the boost rule; celebrates consistent, natural delivery.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تجاوزت المقاييس الثلاثة حدودها، لذا يرفع النظام الأداء الثابت والطبيعي إلى أعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Všechny tři metriky překročily prahy, a systém proto stabilní a přirozený projev posune výš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle tre målinger er over grænseværdierne, så systemet løfter en stabil og naturlig indsats opad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle drei Werte lagen über ihren Schwellen, daher wird eine gleichmäßige, natürliche Leistung aufgewertet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Και οι τρεις μετρήσεις πέρασαν τα όρια, οπότε το σύστημα αυξάνει μια σταθερή και φυσική απόδοση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All three metrics passed their thresholds, so the system pushes a steady, natural performance upward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las tres métricas superaron sus umbrales, así que el sistema impulsa hacia arriba un desempeño estable y natural."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaikki kolme mittaria ylittivät raja-arvonsa, joten järjestelmä nostaa tasaista ja luonnollista suoritusta ylöspäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les trois indicateurs dépassent leur seuil : le système valorise une performance régulière et naturelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "כל שלושת המדדים עברו את הסף, ולכן המערכת מעלה ביצוע יציב וטבעי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तीनों मान अपनी सीमा पार कर गए हैं, इसलिए स्थिर और स्वाभाविक प्रदर्शन को ऊपर उठाया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sva tri pokazatelja prešla su zadane granice pa sustav dodatno podiže ujednačenu i prirodnu izvedbu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindhárom mutató átlépte a küszöbértéket, ezért a rendszer felfelé módosítja a stabil, természetes teljesítményt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketiga metrik melewati ambangnya, sehingga sistem mendorong performa yang stabil dan alami ke atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutte e tre le metriche hanno superato la soglia: il sistema valorizza una prestazione stabile e naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "3つの指標がすべて基準を超えているため、安定した自然な結果をさらに引き上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "세 지표 모두 기준을 넘어서, 안정적이고 자연스러운 발화를 시스템이 더 높게 평가해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketiga-tiga metrik melepasi had masing-masing, jadi sistem menaikkan pencapaian yang stabil dan semula jadi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle drie de waarden halen hun drempel; daarom wordt een stabiele, natuurlijke prestatie omhooggetrokken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wszystkie trzy wskaźniki przekroczyły progi, więc stabilna i naturalna wypowiedź dostaje podbicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As três métricas passaram dos limites, então o sistema eleva um desempenho firme e natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все три показателя прошли порог, поэтому система повышает оценку за ровную и естественную подачу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alla tre måtten klarar tröskelvärdena, så ett stabilt och naturligt resultat lyfts uppåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ตัวชี้วัดทั้งสามผ่านเกณฑ์ ระบบจึงเพิ่มคะแนนให้กับการพูดที่สม่ำเสมอและเป็นธรรมชาติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Üç ölçüm de eşiği geçti; uygulama istikrarlı ve doğal bir performansı yukarı taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Усі три показники перевищили пороги, тож система підвищує оцінку за стабільну й природну подачу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cả ba chỉ số đều đạt ngưỡng, nên hệ thống sẽ nâng điểm cho phần thể hiện ổn định và tự nhiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三项指标都已经过线，系统会把稳定、自然的表现向上提升。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
