    "practice.home.description" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر محورًا واحدًا وكرر المقطع النصي نفسه لاستكشاف ما يتغير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte jedno zaměření a opakujte stejný text, abyste prozkoumali změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vælg ét fokus, og gentag samme tekst for at undersøge, hvad der ændrer sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen Schwerpunkt und wiederhole denselben Text, um Veränderungen zu erkunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Επιλέξτε ένα σημείο εστίασης και επαναλάβετε το ίδιο κείμενο για να εξερευνήσετε τις αλλαγές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose one focus and repeat the same passage to explore what changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige un aspecto y repite el mismo texto para explorar qué cambia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
