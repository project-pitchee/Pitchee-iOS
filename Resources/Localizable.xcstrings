        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Praznine u krivuljama znače da za to razdoblje nema pouzdanog rezultata; sve krivulje dijele istu vremensku os."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A görbék hiányzó szakaszai azt jelentik, hogy arra az időtartamra nincs megbízható eredmény; mindhárom görbe ugyanazt az időtengelyt használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
