          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "분석이 끝나면 임시 녹음은 삭제하고, 기록에는 분석 결과만 저장해요."
          }
        },
        "ms" : {
          "stringUnit" : {
