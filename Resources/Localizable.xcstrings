        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Käyrien aukot tarkoittavat, ettei kyseiseltä ajanjaksolta saatu luotettavaa tulosta; kaikki käyrät käyttävät samaa aika-akselia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les blancs dans les courbes signalent l’absence de résultat fiable sur cette période ; toutes les courbes partagent le même axe de temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פערים בעקומות מציינים שלא זוהתה תוצאה מהימנה בטווח הזמן הזה; כל העקומות חולקות ציר זמן אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वक्रों में खाली जगह का मतलब है कि उस समय के लिए भरोसेमंद नतीजा नहीं मिला; सभी वक्र एक ही समय अक्ष पर हैं।"
