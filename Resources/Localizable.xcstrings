    "export.error.photoLibraryAccessDenied.message": {
      "comment": "Shown when permission to add report images to Photos is denied or restricted. Directs the user to check photo permissions in system settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّرت إضافة الصور إلى مكتبة الصور. تحقق من أذونات الصور لتطبيق Pitchee في الإعدادات وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Do knihovny fotografií nelze přidat obrázky. Zkontrolujte v Nastavení oprávnění aplikace Pitchee k fotografiím a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Billeder kan ikke føjes til fotobiblioteket. Kontrollér Pitchees fototilladelser i Indstillinger, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilder konnten nicht zur Fotomediathek hinzugefügt werden. Prüfe die Fotoberechtigungen für Pitchee in den Einstellungen und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν ήταν δυνατή η προσθήκη εικόνων στη βιβλιοθήκη φωτογραφιών. Ελέγξτε τα δικαιώματα φωτογραφιών του Pitchee στις Ρυθμίσεις και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't add images to your photo library. Check Pitchee’s photo permissions in Settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pueden añadir imágenes a tu fototeca. Revisa los permisos de fotos de Pitchee en Ajustes e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuvia ei voi lisätä kuvakirjastoon. Tarkista Pitcheen kuvien käyttöoikeudet Asetuksista ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ajouter des images à votre photothèque. Vérifiez les autorisations Photos de Pitchee dans Réglages, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן להוסיף תמונות לספריית התמונות. יש לבדוק את הרשאות התמונות של Pitchee בהגדרות ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोटो लाइब्रेरी में चित्र नहीं जोड़े जा सकते। सेटिंग्ज़ में Pitchee की फ़ोटो अनुमतियाँ जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slike nije moguće dodati u fototeku. Provjeri dozvole za fotografije aplikacije Pitchee u Postavkama i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem lehet képeket hozzáadni a fotókönyvtárhoz. Ellenőrizd a Pitchee fotóengedélyeit a Beállításokban, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gambar tidak dapat ditambahkan ke perpustakaan foto. Periksa izin foto Pitchee di Pengaturan dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile aggiungere immagini alla libreria foto. Controlla i permessi di Pitchee per le foto in Impostazioni e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真ライブラリに画像を追加できません。設定でPitcheeの写真へのアクセス権限を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 보관함에 이미지를 추가할 수 없어요. 설정에서 Pitchee의 사진 접근 권한을 확인한 후 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imej tidak dapat ditambahkan ke pustaka foto. Semak kebenaran foto Pitchee dalam Tetapan dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afbeeldingen kunnen niet aan je fotobibliotheek worden toegevoegd. Controleer de fotomachtigingen voor Pitchee in Instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można dodać obrazów do biblioteki zdjęć. Sprawdź uprawnienia aplikacji Pitchee do zdjęć w Ustawieniach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível adicionar imagens à sua fototeca. Verifique as permissões de fotos do Pitchee nos Ajustes e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удаётся добавить изображения в медиатеку. Проверьте разрешения Pitchee на доступ к фото в Настройках и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det går inte att lägga till bilder i bildbiblioteket. Kontrollera Pitchees bildbehörigheter i Inställningar och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถเพิ่มรูปภาพลงในคลังรูปภาพได้ โปรดตรวจสอบสิทธิ์การเข้าถึงรูปภาพของ Pitchee ในการตั้งค่าแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotoğraf arşivine görsel eklenemiyor. Ayarlar’da Pitchee’nin fotoğraf izinlerini kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося додати зображення до фототеки. Перевірте дозволи Pitchee на доступ до фото в Параметрах і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể thêm hình ảnh vào thư viện ảnh. Kiểm tra quyền truy cập ảnh của Pitchee trong Cài đặt rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法向相册添加图片。请在系统设置中检查 Pitchee 的照片权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將圖片加入相簿。請在系統設定中檢查 Pitchee 的照片權限後再試。"
          }
        }
      }
    },
    "export.error.reportSaveFailed.message": {
      "comment": "Shown when writing the PDF file to disk fails.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر حفظ التقرير. تحقق من المساحة المتاحة وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zprávu se nepodařilo uložit. Zkontrolujte volné místo v úložišti a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rapporten kunne ikke gemmes. Tjek lagerpladsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bericht konnte nicht gespeichert werden. Prüfe den verfügbaren Speicherplatz und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η αναφορά δεν ήταν δυνατό να αποθηκευτεί. Ελέγξτε τον διαθέσιμο χώρο αποθήκευσης και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report couldn't be saved. Check your available storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo guardar el informe. Revisa el espacio disponible y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raportin tallentaminen ei onnistunut. Tarkista tallennustila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le rapport n’a pas pu être enregistré. Vérifiez l’espace de stockage disponible et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הדוח לא נשמר. בדקו את שטח האחסון הפנוי ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिपोर्ट सेव नहीं हो सकी। उपलब्ध स्टोरेज जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvješće nije bilo moguće spremiti. Provjeri dostupni prostor i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A jelentést nem sikerült elmenteni. Ellenőrizd a szabad tárhelyet, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laporan tidak dapat disimpan. Periksa ruang penyimpanan yang tersedia, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile salvare il report. Controlla lo spazio disponibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レポートを保存できませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "리포트를 저장하지 못했어요. 저장 공간을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laporan tidak dapat disimpan. Semak ruang storan yang tersedia dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het rapport kon niet worden opgeslagen. Controleer de vrije opslagruimte en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się zapisać raportu. Sprawdź wolne miejsce w pamięci i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível salvar o relatório. Verifique o espaço disponível e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось сохранить отчёт. Проверьте свободное место и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rapporten kunde inte sparas. Kontrollera ledigt lagringsutrymme och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกรายงานไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rapor kaydedilemedi. Boş depolama alanını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зберегти звіт. Перевірте вільне місце на пристрої та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không lưu được báo cáo. Hãy kiểm tra dung lượng còn trống rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告未能保存，请检查存储空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "報告未能儲存，請檢查儲存空間後重試。"
          }
        }
      }
    },
