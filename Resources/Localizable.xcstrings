    "voiceProfile.privacyPromise.userControl.description" : {
      "comment" : "Points users to the real system settings for permission; keep 'system settings' generic to the OS.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكنك تغيير تفضيل الصوت في أي وقت، وإيقاف الوصول إلى الميكروفون من إعدادات النظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preferenci hlasu můžete kdykoli změnit a přístup k mikrofonu vypnout v nastavení systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan ændre stemmepræferencen når som helst og slå mikrofonadgang fra i systemindstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst deine Stimmpräferenz jederzeit ändern und den Mikrofonzugriff in den Systemeinstellungen deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μπορείτε να αλλάξετε την προτίμηση φωνής όποτε θέλετε και να απενεργοποιήσετε την πρόσβαση στο μικρόφωνο από τις ρυθμίσεις συστήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change your voice preference at any time, and turn off microphone access in system settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes cambiar tu preferencia de voz en cualquier momento y desactivar el acceso al micrófono en los ajustes del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Äänitoiveen voi vaihtaa milloin tahansa, ja mikrofonin käyttöoikeuden voi poistaa käytöstä järjestelmän asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez changer de préférence vocale à tout moment et désactiver l’accès au micro dans les réglages du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אפשר לשנות את העדפת הקול בכל רגע, ולכבות את הגישה למיקרופון בהגדרות המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप कभी भी अपनी आवाज़ की पसंद बदल सकते हैं, और सिस्टम सेटिंग्स में माइक्रोफ़ोन की अनुमति बंद कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Željeni glas možeš promijeniti u bilo kojem trenutku, a pristup mikrofonu isključiti u sistemskim postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangpreferenciádat bármikor módosíthatod, és a rendszerbeállításokban kikapcsolhatod a mikrofonhoz való hozzáférést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preferensi suara dapat Anda ubah kapan saja, dan akses mikrofon dapat dimatikan di pengaturan sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi modificare la preferenza vocale in qualsiasi momento e disattivare l'accesso al microfono nelle impostazioni di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "声の好みはいつでも変更でき、マイクへのアクセスは端末の設定でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음성 방향은 언제든 바꿀 수 있어요. 마이크 권한은 시스템 설정에서 끌 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anda boleh mengubah keutamaan suara anda pada bila-bila masa, dan mematikan akses mikrofon dalam tetapan sistem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je kunt je stemvoorkeur altijd aanpassen en microfoontoegang uitschakelen in de systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preferencję głosu możesz zmienić w każdej chwili, a dostęp do mikrofonu wyłączyć w ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode mudar sua preferência de voz quando quiser e desativar o acesso ao microfone nos ajustes do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Предпочтения по голосу можно изменить в любой момент. Доступ к микрофону можно отключить в системных настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kan ändra din röstpreferens när som helst och stänga av mikrofonåtkomst i systeminställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "คุณเปลี่ยนแนวเสียงที่ต้องการได้ทุกเมื่อ และปิดการเข้าถึงไมโครโฟนได้ในการตั้งค่าระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ses tercihini istediğin zaman değiştirebilir, mikrofon erişimini sistem ayarlarından kapatabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ви можете будь-коли змінити уподобання голосу й вимкнути доступ до мікрофона в системних налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn có thể thay đổi tùy chọn giọng nói bất cứ lúc nào và tắt quyền truy cập micrô trong cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声音偏好可随时修改。麦克风权限可在系统设置中关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聲音偏好可隨時修改。麥克風權限可在系統設定中關閉。"
          }
        }
      }
    },
    "voiceProfile.privacyPromise.userControl.title" : {
      "comment" : "Control framing; pairs with the settings-slider icon.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
