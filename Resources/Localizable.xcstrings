    "export.chart.voiceLoudness.note": {
      "comment": "Caption for the voice-loudness-only chart.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض المنحنى الجهارة عند اكتشاف كلام، بوحدة dBFS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Křivka znázorňuje hlasitost v době, kdy byla rozpoznána řeč, v dBFS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurven viser lydstyrken, mens der registreres tale, i dBFS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Kurve zeigt die Lautstärke, während Sprache erkannt wurde, in dBFS."
