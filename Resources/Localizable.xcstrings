    "practice.comparison.scope" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذا هو الفرق المقاس بين تسجيلين للمقطع النصي نفسه. لا تثبت القيمة الأكبر أو الأصغر وحدها وجود تقدم. ضع الاستماع والراحة في الحسبان أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jde o naměřený rozdíl mezi dvěma nahrávkami stejného textu. Samotná vyšší nebo nižší hodnota nedokazuje pokrok. Zvažte také poslech a pohodlí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette er den målte forskel mellem to optagelser af samme tekst. En større eller mindre værdi alene dokumenterer ikke fremskridt. Tag også lytning og komfort med i betragtning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies ist der gemessene Unterschied zwischen zwei Aufnahmen desselben Texts. Ein größerer oder kleinerer Wert allein belegt keinen Fortschritt. Berücksichtige auch das Anhören und dein Wohlbefinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή είναι η μετρημένη διαφορά ανάμεσα σε δύο λήψεις του ίδιου κειμένου. Μια μεγαλύτερη ή μικρότερη τιμή από μόνη της δεν τεκμηριώνει πρόοδο. Λάβετε υπόψη την ακρόαση και την άνεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the measured difference between two takes of the same passage. A larger or smaller value alone does not establish progress. Consider playback and comfort too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta es la diferencia medida entre dos tomas del mismo texto. Un valor mayor o menor por sí solo no demuestra progreso. Ten en cuenta también la escucha y la comodidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämä on mitattu ero saman tekstin kahden tallenteen välillä. Suurempi tai pienempi arvo ei yksin osoita edistymistä. Huomioi myös kuuntelu ja mukavuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il s’agit de la différence mesurée entre deux prises du même passage. Une valeur plus grande ou plus petite ne prouve pas à elle seule un progrès. Tenez aussi compte de l’écoute et du confort."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "זהו ההפרש שנמדד בין שתי הקלטות של אותו קטע. ערך גדול או קטן יותר לבדו אינו מעיד על התקדמות. התחשבו גם בהאזנה ובנוחות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह एक ही अंश की दो रिकॉर्डिंग के बीच मापा गया अंतर है। केवल अधिक या कम मान प्रगति साबित नहीं करता। सुनने के अनुभव और सहजता पर भी विचार करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovo je izmjerena razlika između dviju snimki istog teksta. Sama veća ili manja vrijednost ne dokazuje napredak. Uzmi u obzir i preslušavanje te osjećaj ugode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez ugyanannak a szövegnek két felvétele közötti mért különbség. A nagyobb vagy kisebb érték önmagában nem bizonyít fejlődést. Vedd figyelembe a visszahallgatást és a kényelmet is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini adalah selisih terukur antara dua rekaman dari teks yang sama. Nilai yang lebih besar atau kecil saja tidak membuktikan kemajuan. Pertimbangkan juga hasil pemutaran dan kenyamanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa è la differenza misurata tra due registrazioni dello stesso brano. Un valore maggiore o minore da solo non dimostra progressi. Considera anche l'ascolto e il comfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これは同じ文章を2回録音した測定値の差です。数値が大きくなったり小さくなったりしただけでは、上達したとは判断できません。聞き返した印象や発声の楽さも考慮してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "같은 글을 두 번 녹음한 측정값의 차이예요. 값이 커지거나 작아졌다는 것만으로 발전을 판단할 수 없어요. 다시 들은 느낌과 편안함도 함께 고려해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ini ialah perbezaan yang diukur antara dua rakaman petikan yang sama. Nilai yang lebih besar atau kecil sahaja tidak membuktikan kemajuan. Pertimbangkan juga main balik dan keselesaan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit is het gemeten verschil tussen twee opnamen van dezelfde tekst. Een hogere of lagere waarde alleen toont geen vooruitgang aan. Houd ook rekening met het terugluisteren en hoe comfortabel het voelde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To zmierzona różnica między dwoma nagraniami tego samego tekstu. Sama większa lub mniejsza wartość nie dowodzi postępu. Uwzględnij też odsłuch i komfort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta é a diferença medida entre duas tomadas do mesmo texto. Um valor maior ou menor, por si só, não comprova progresso. Considere também a escuta e o conforto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это измеренная разница между двумя записями одного текста. Само по себе увеличение или уменьшение значения не доказывает прогресс. Учитывайте также прослушивание и комфорт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det här är den uppmätta skillnaden mellan två inspelningar av samma text. Ett större eller mindre värde i sig visar inte framsteg. Ta även hänsyn till lyssning och komfort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "นี่คือผลต่างที่วัดได้ระหว่างการอ่านบทเดียวกันสองครั้ง ค่าที่มากขึ้นหรือน้อยลงเพียงอย่างเดียวไม่ยืนยันพัฒนาการ ควรพิจารณาการฟังและความสบายร่วมด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu, aynı metnin iki kaydı arasında ölçülen farktır. Daha büyük veya küçük bir değer tek başına ilerlemeyi göstermez. Dinlemeyi ve rahatlığı da değerlendir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це виміряна різниця між двома записами того самого тексту. Саме лише збільшення чи зменшення значення не доводить прогресу. Враховуйте також прослуховування й комфорт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đây là chênh lệch đo được giữa hai lần đọc cùng một đoạn văn. Chỉ riêng giá trị lớn hơn hay nhỏ hơn không xác lập tiến bộ. Hãy cân nhắc cả khi nghe lại và mức độ thoải mái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是同一句的两次测量差异，不能单凭变大或变小判断进步。请结合回听与舒适感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是同一段文字兩次錄音的測量差異。數值單純變大或變小並不代表進步，也請考慮回放感受與舒適程度。"
          }
        }
      }
    },
    "practice.comparison.unavailable" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يجتز تسجيل واحد على الأقل فحوص التسجيل أو يفتقر إلى مؤشر المحور، لذا لم يُحسب التغير. لا يزال بإمكانك الاستماع؛ ابدأ تدريبًا جديدًا لاستبدال A."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alespoň jedna nahrávka neprošla kontrolami nahrávání nebo nemá vybraný ukazatel, proto se změna nepočítá. Poslech je stále možný; pro nahrazení A začněte nové cvičení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindst én optagelse bestod ikke optagelseskontrollerne eller mangler den valgte måling, så der beregnes ingen ændring. Du kan stadig lytte; start en ny øvelse for at erstatte A."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindestens eine Aufnahme hat die Aufnahmeprüfungen nicht bestanden oder enthält die Schwerpunkt-Kennzahl nicht. Daher wird keine Veränderung berechnet. Anhören ist weiterhin möglich; beginne eine neue Übung, um A zu ersetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τουλάχιστον μία λήψη δεν πέρασε τους ελέγχους εγγραφής ή δεν διαθέτει τον επιλεγμένο δείκτη, οπότε δεν υπολογίζεται αλλαγή. Μπορείτε ακόμη να ακούσετε· ξεκινήστε νέα εξάσκηση για να αντικαταστήσετε την A."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one take did not pass recording checks or lacks the focus metric, so no change is calculated. You can still listen; start a new practice to replace A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al menos una toma no superó las comprobaciones de grabación o carece de la métrica elegida, por lo que no se calcula el cambio. Puedes seguir escuchándolas; inicia una nueva práctica para sustituir A."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vähintään yksi tallenne ei läpäissyt tallennustarkistuksia tai siitä puuttuu valittu mittari, joten muutosta ei lasketa. Voit silti kuunnella. Aloita uusi harjoitus korvataksesi A:n."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au moins une prise n’a pas passé les contrôles d’enregistrement ou ne possède pas l’indicateur choisi ; aucune variation n’est donc calculée. Vous pouvez toujours écouter. Commencez un nouvel exercice pour remplacer A."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לפחות הקלטה אחת לא עברה את בדיקות ההקלטה או שחסר בה מדד המיקוד, ולכן לא מחושב שינוי. עדיין ניתן להאזין; התחילו תרגול חדש כדי להחליף את A."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कम से कम एक रिकॉर्डिंग जाँच में सफल नहीं हुई या उसमें केंद्रित मेट्रिक नहीं है, इसलिए बदलाव नहीं निकाला गया। आप अब भी सुन सकते हैं; A बदलने के लिए नया अभ्यास शुरू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najmanje jedna snimka nije prošla provjere snimanja ili nema odabrani pokazatelj, pa se promjena ne računa. I dalje možeš slušati; započni novu vježbu da zamijeniš A."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Legalább egy felvétel nem ment át a felvételi ellenőrzéseken, vagy hiányzik belőle a választott mutató, ezért nem számítunk változást. Továbbra is meghallgathatod; az A cseréjéhez indíts új gyakorlást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Setidaknya satu rekaman tidak lolos pemeriksaan atau tidak memiliki metrik fokus, sehingga perubahan tidak dihitung. Anda tetap dapat mendengarkan; mulai latihan baru untuk mengganti A."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Almeno una registrazione non ha superato i controlli o non dispone della metrica scelta, quindi la variazione non viene calcolata. Puoi comunque ascoltare; avvia una nuova pratica per sostituire A."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "少なくとも一方の録音が録音チェックを通過していないか、注目する指標がないため、変化は計算しません。音声は引き続き聞けます。Aを変更するには、新しい練習を始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "하나 이상의 녹음이 녹음 점검을 통과하지 못했거나 집중 지표가 없어 변화를 계산하지 않아요. 다시 듣기는 가능해요. A를 바꾸려면 새 연습을 시작해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sekurang-kurangnya satu rakaman tidak lulus semakan atau tiada metrik fokus, jadi tiada perubahan dikira. Anda masih boleh mendengar; mulakan latihan baharu untuk menggantikan A."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minstens één opname voldeed niet aan de opnamecontroles of mist de gekozen meetwaarde, dus er wordt geen verandering berekend. Je kunt nog steeds luisteren; start een nieuwe oefening om A te vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Co najmniej jedno nagranie nie przeszło kontroli warunków nagrania lub nie ma wybranego wskaźnika, więc zmiana nie jest obliczana. Nadal możesz słuchać; rozpocznij nowe ćwiczenie, aby zastąpić A."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pelo menos uma tomada não passou nas verificações de gravação ou não tem a métrica escolhida, então a mudança não é calculada. Você ainda pode ouvir; inicie uma nova prática para substituir A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Хотя бы одна запись не прошла проверку условий записи или не содержит выбранного показателя, поэтому изменение не рассчитывается. Прослушивание доступно; чтобы заменить A, начните новую тренировку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minst en inspelning klarade inte inspelningskontrollerna eller saknar det valda mätvärdet, så ingen förändring beräknas. Du kan fortfarande lyssna; starta en ny övning för att ersätta A."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "อย่างน้อยหนึ่งครั้งไม่ผ่านการตรวจบันทึกเสียงหรือไม่มีตัวชี้วัดที่เน้น จึงไม่คำนวณการเปลี่ยนแปลง คุณยังฟังได้ เริ่มการฝึกใหม่เพื่อแทนที่ A"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En az bir kayıt, kayıt kontrollerini geçmedi veya odak ölçümü eksik; bu nedenle değişim hesaplanmadı. Yine de dinleyebilirsin; A'yı değiştirmek için yeni bir çalışma başlat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Принаймні один запис не пройшов перевірки умов запису або не має вибраного показника, тому зміна не обчислюється. Прослуховування доступне; щоб замінити A, почніть нову вправу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ít nhất một bản ghi không đạt kiểm tra hoặc thiếu chỉ số trọng tâm, nên không tính thay đổi. Bạn vẫn có thể nghe lại; bắt đầu buổi luyện mới để thay A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少一次录音质量不足或主要指标缺失，本次不计算变化结论。你仍可回听；重新开始练习可以更换 A。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少一段錄音未通過錄音檢查，或缺少所選重點的指標，因此不計算變化。仍可聆聽錄音；若要替換 A，請開始新的練習。"
          }
        }
      }
    },
    "practice.direction.explanation" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أثناء استكشاف هدفك، ابدأ بطبقة الصوت وتغيرها والتغيرات الشخصية. يمكنك اختيار نتيجة اتجاهية عندما تكون مفيدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při hledání svého cíle začněte výškou hlasu, kolísáním a vlastními změnami. Podle potřeby si můžete vybrat skóre určitého směru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mens du udforsker dit mål, kan du begynde med tonehøjde, variation og personlige ændringer. Du kan vælge en retningsbestemt score, når det er nyttigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beginne beim Erkunden deines Ziels mit Tonhöhe, Schwankungen und eigenen Veränderungen. Bei Bedarf kannst du eine richtungsbezogene Bewertung wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Όσο εξερευνάτε τον στόχο σας, ξεκινήστε από το ύψος, τη διακύμανση και τις προσωπικές αλλαγές. Μπορείτε να επιλέξετε βαθμολογία κατεύθυνσης όταν σας είναι χρήσιμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While exploring your goal, start with pitch, variation, and personal changes. You can choose a directional score when useful."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mientras exploras tu objetivo, empieza por el tono, la variación y los cambios personales. Puedes elegir un puntaje orientado a tu objetivo cuando te resulte útil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun etsit tavoitettasi, aloita sävelkorkeudesta, vaihtelusta ja omista muutoksistasi. Voit valita äänen suuntaa kuvaavan pistemäärän, kun siitä on hyötyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pendant l’exploration de votre objectif, commencez par la hauteur, ses variations et vos propres changements. Vous pouvez choisir un score directionnel si cela vous est utile."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "במהלך בחינת היעד שלכם, התחילו בטון, בשונות ובשינויים אישיים. אפשר לבחור ציון כיווני כשזה מועיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपना लक्ष्य खोजते समय पिच, उतार-चढ़ाव और व्यक्तिगत बदलाव से शुरू करें। उपयोगी होने पर आप दिशा का स्कोर चुन सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dok istražuješ svoj cilj, počni od visine, varijacije i vlastitih promjena. Po potrebi možeš odabrati ocjenu određenog smjera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A célod feltérképezésekor kezdd a hangmagassággal, az ingadozással és a személyes változásokkal. Ha hasznos, választhatsz irány szerinti pontszámot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saat mengeksplorasi tujuan, mulailah dari nada, variasi, dan perubahan pribadi. Anda dapat memilih skor arah bila berguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mentre esplori il tuo obiettivo, inizia da tono, variazione e cambiamenti personali. Puoi scegliere un punteggio direzionale quando è utile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "目標を探している間は、まず音高、変動、自分自身の変化を見てみましょう。必要に応じて、方向別のスコアを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "목표를 탐색하는 동안에는 음높이, 변동, 자신의 변화를 먼저 살펴보세요. 필요하면 방향별 점수를 선택할 수 있어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Semasa meneroka sasaran, mulakan dengan pic, variasi, dan perubahan peribadi. Anda boleh memilih skor arah apabila berguna."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Begin bij het verkennen van je doel met toonhoogte, variatie en persoonlijke veranderingen. Je kunt een score voor een stemrichting kiezen als dat nuttig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy poznajesz swój cel, zacznij od wysokości, zmienności i własnych zmian. W razie potrzeby możesz wybrać wynik dla danego kierunku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enquanto explora seu objetivo, comece pela altura, variação e mudanças pessoais. Você pode escolher uma pontuação por direção quando for útil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пока вы определяетесь с целью, начните с высоты тона, её колебаний и собственных изменений. При необходимости можно выбрать оценку для определённого направления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "När du utforskar ditt mål kan du börja med tonhöjd, variation och personliga förändringar. Du kan välja riktningsbaserade poäng när det är användbart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระหว่างค้นหาเป้าหมาย ให้เริ่มจากระดับเสียง ความแปรผัน และการเปลี่ยนแปลงของตัวเอง คุณเลือกใช้คะแนนตามแนวเสียงได้เมื่อเห็นว่ามีประโยชน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hedefini keşfederken perde, değişkenlik ve kişisel değişimlerle başla. Yararlı olduğunda yön puanı seçebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поки визначаєтеся з метою, почніть із висоти тону, її коливань і власних змін. За потреби можна вибрати оцінку певного напряму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khi khám phá mục tiêu, hãy bắt đầu với cao độ, độ biến thiên và thay đổi của bản thân. Bạn có thể chọn điểm theo hướng khi thấy hữu ích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不确定目标时，先观察音高、波动和个人变化。需要时可主动选择查看某个方向的评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探索目標時，先觀察音高、起伏與自己的變化。有需要時，也可以選擇方向性評分。"
          }
        }
      }
    },
