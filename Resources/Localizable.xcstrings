    "voiceProfile.privacyPromise.onDevice.description": {
      "comment": "Legal-adjacent claim: do not weaken 'never'. Keep the three guarantees (on-device, no upload, no third-party sharing).",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تحليل الصوت على هذا الجهاز. ولا تُرفع التسجيلات إلى أي خادم ولا تُشارك مع أي طرف ثالث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analýza hlasu probíhá v tomto zařízení. Nahrávky se nikdy neodesílají na server ani nesdílejí s třetími stranami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmeanalysen foregår på denne enhed. Optagelser uploades aldrig til en server og deles ikke med tredjeparter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Stimmanalyse findet auf diesem Gerät statt. Aufnahmen werden nie auf einen Server hochgeladen oder an Dritte weitergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η ανάλυση φωνής γίνεται σε αυτή τη συσκευή. Οι ηχογραφήσεις δεν ανεβαίνουν ποτέ σε διακομιστή ούτε κοινοποιούνται σε τρίτους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice analysis happens on this device. Recordings are never uploaded to a server or shared with third parties."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El análisis de voz se hace en este dispositivo. Las grabaciones nunca se suben a un servidor ni se comparten con terceros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänianalyysi tehdään tällä laitteella. Tallennuksia ei koskaan lähetetä palvelimelle eikä jaeta kolmansille osapuolille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’analyse vocale se fait sur cet appareil. Les enregistrements ne sont jamais envoyés à un serveur ni partagés avec des tiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ניתוח הקול מתבצע במכשיר הזה. ההקלטות לא מועלות לשרת ולא משותפות עם צדדים שלישיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आवाज़ का विश्लेषण इसी डिवाइस पर होता है। रिकॉर्डिंग कभी किसी सर्वर पर अपलोड नहीं होती और न ही किसी तीसरे पक्ष के साथ साझा की जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiza glasa odvija se na ovom uređaju. Snimke se nikada ne prenose na poslužitelj ni ne dijele s trećim stranama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A hangelemzés ezen a készüléken történik. A felvételek soha nem kerülnek fel szerverre, és nem jutnak el harmadik felekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analisis suara dilakukan di perangkat ini. Rekaman tidak pernah diunggah ke server atau dibagikan kepada pihak ketiga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'analisi della voce avviene su questo dispositivo. Le registrazioni non vengono mai caricate su un server né condivise con terzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "音声の分析はこの端末で行います。録音がサーバーにアップロードされたり、第三者と共有されたりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음성 분석은 이 기기에서 이루어져요. 녹음은 서버에 업로드되지 않고 제3자와 공유되지도 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analisis suara berlaku pada peranti ini. Rakaman tidak pernah dimuat naik ke pelayan atau dikongsi dengan pihak ketiga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemanalyse gebeurt op dit apparaat. Opnames worden nooit naar een server geüpload en nooit met derden gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Analiza głosu odbywa się na tym urządzeniu. Nagrania nigdy nie są wysyłane na serwer ani udostępniane podmiotom trzecim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A análise de voz acontece neste dispositivo. As gravações nunca são enviadas a um servidor nem compartilhadas com terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Анализ голоса выполняется на этом устройстве. Записи никогда не загружаются на сервер и не передаются третьим лицам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Röstanalysen görs på den här enheten. Inspelningar laddas aldrig upp till en server och delas aldrig med tredje part."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การวิเคราะห์เสียงทำบนอุปกรณ์เครื่องนี้ การบันทึกเสียงจะไม่ถูกอัปโหลดขึ้นเซิร์ฟเวอร์หรือแชร์ให้บุคคลที่สาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ses analizi bu cihazda yapılır. Kayıtlar hiçbir zaman bir sunucuya yüklenmez ve üçüncü taraflarla paylaşılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аналіз голосу виконується на цьому пристрої. Записи ніколи не завантажуються на сервер і не передаються третім сторонам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phân tích giọng nói diễn ra ngay trên thiết bị này. Bản ghi âm không bao giờ được tải lên máy chủ hay chia sẻ cho bên thứ ba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音分析在本机完成，录音不会上传到服务器，也不会共享给第三方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "聲音分析在本機完成，錄音不會上傳到伺服器，也不會分享給第三方。"
          }
        }
      }
    },
