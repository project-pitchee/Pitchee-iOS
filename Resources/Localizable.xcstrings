    "scoring.rules.masculineHighPitchCap.description" : {
      "comment" : "Masculine scoring rule description in the score explanation screen. Keep score and frequency boundaries exact.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تسهم الطبيعية في النتيجة، بينما تحد طبقة الصوت الأعلى من التوافق مع الهدف الذكوري."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přirozenost přispívá ke skóre, zatímco vyšší výška hlasu omezuje shodu s maskulinním cílem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naturlighed bidrager til scoren, mens højere tonehøjde begrænser overensstemmelsen med det maskuline mål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Natürlichkeit trägt zur Bewertung bei, während eine höhere Tonhöhe die Ausrichtung am maskulinen Ziel begrenzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η φυσικότητα συμβάλλει στη βαθμολογία, ενώ το υψηλότερο ύψος περιορίζει την αντιστοιχία στον στόχο αρρενωπής φωνής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naturalness contributes to the score, while higher pitch limits alignment with the masculine goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La naturalidad contribuye al puntaje, mientras que un tono más agudo limita la afinidad con el objetivo masculino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Luonnollisuus vaikuttaa pisteisiin, kun taas korkeampi sävelkorkeus rajoittaa maskuliinisen tavoitteen vastaavuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le naturel contribue au score, tandis qu’une hauteur plus élevée limite l’alignement avec l’objectif masculin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הטבעיות תורמת לציון, בעוד טון גבוה יותר מגביל את ההתאמה ליעד הגברי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्वाभाविकता स्कोर में योगदान देती है, जबकि ऊँची पिच पुरुष जैसी आवाज़ के लक्ष्य से मेल सीमित करती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prirodnost doprinosi ocjeni, dok viša visina ograničava usklađenost s ciljem muškog zvuka glasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A természetesség hozzájárul a pontszámhoz, míg a magasabb hangmagasság korlátozza a férfias célnak való megfelelést."
          }
        },
        "id" : {
          "stringUnit" : {
