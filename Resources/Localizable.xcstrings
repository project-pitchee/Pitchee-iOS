    },
    "analysis.suggestions.naturalSpeech.description": {
      "comment": "Longer body text; manages expectations and discourages score-chasing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الطبيعية قيمة مرجعية فقط. الإيقاع المريح والتنفّس المنتظم أنفع من ملاحقة نتيجة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přirozenost je jen orientační hodnota. Uvolněné tempo a klidné dýchání pomohou víc než honba za jedním skóre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturlighed er kun en referenceværdi. Et afslappet tempo og jævn vejrtrækning hjælper mere end at jagte en enkelt score."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Natürlichkeit ist nur ein Richtwert. Ein entspanntes Tempo und ruhiges Atmen helfen mehr, als einer einzelnen Bewertung nachzujagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η φυσικότητα είναι μόνο τιμή αναφοράς. Ένας άνετος ρυθμός και σταθερή αναπνοή βοηθούν περισσότερο από το κυνήγι μιας βαθμολογίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturalness is only a reference value. An easy pace and steady breathing help more than chasing a single score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La naturalidad es solo un valor de referencia. Un ritmo cómodo y una respiración constante ayudan más que perseguir un solo puntaje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luonnollisuus on vain viitearvo. Rento puhetahti ja tasainen hengitys auttavat enemmän kuin yksittäisen pistemäärän tavoittelu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le naturel n’est qu’une valeur de référence. Un débit détendu et une respiration régulière vous aideront plus que la course au score."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטבעיות היא ערך ייחוס בלבד. קצב נוח ונשימה יציבה עוזרים יותר מרדיפה אחרי ציון בודד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्वाभाविकता सिर्फ़ एक संदर्भ मान है। सहज गति और स्थिर साँस लेना, एक स्कोर के पीछे भागने से ज़्यादा मदद करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prirodnost je samo referentna vrijednost. Opušten tempo i mirno disanje pomažu više od lovljenja pojedinačne ocjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A természetesség csak viszonyítási érték. Egy könnyed tempó és az egyenletes légzés többet segít, mint egyetlen pontszám hajszolása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kealamian hanya nilai acuan. Tempo yang santai dan napas yang stabil lebih membantu daripada mengejar satu skor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La naturalezza è solo un valore di riferimento. Un ritmo rilassato e una respirazione costante aiutano più che rincorrere un singolo punteggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自然度はあくまで参考値です。1回のスコアを追うより、楽な速さと安定した呼吸を心がけるほうが役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "자연스러움은 참고 지표예요. 편안한 말 속도와 꾸준한 호흡이 한 번의 점수를 쫓는 것보다 도움이 돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kewajaran hanyalah nilai rujukan. Rentak yang santai dan pernafasan yang tenang lebih membantu daripada mengejar satu skor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Natuurlijkheid is een referentiewaarde. Een rustig tempo en gelijkmatige ademhaling helpen meer dan jagen op één score."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturalność to wartość odniesienia. Swobodne tempo i równy oddech pomagają bardziej niż pogoń za pojedynczym wynikiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A naturalidade é apenas uma referência. Um ritmo tranquilo e uma respiração constante ajudam mais do que perseguir uma pontuação isolada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Естественность — ориентировочный показатель. Спокойный темп и ровное дыхание помогают больше, чем погоня за оценкой одной записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturlighet är bara ett referensvärde. Ett bekvämt tempo och jämn andning hjälper mer än att jaga en enskild poäng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ความเป็นธรรมชาติเป็นเพียงค่าอ้างอิง การพูดด้วยจังหวะสบาย ๆ และหายใจสม่ำเสมอช่วยได้มากกว่าการไล่ตามคะแนนครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doğallık yalnızca bir referans değeridir. Rahat bir tempo ve düzenli nefes, tek bir puanın peşinden koşmaktan daha faydalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Природність — лише орієнтир. Спокійний темп і рівне дихання допомагають більше, ніж гонитва за окремою оцінкою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Độ tự nhiên chỉ mang tính tham khảo. Nói với nhịp độ thoải mái và hơi thở đều sẽ hữu ích hơn việc chạy theo điểm số của một lần ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然度是一个参考值。保持轻松的语速和连贯的呼吸，比追求单次分数更有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自然度是一個參考值。保持輕鬆的語速和連貫的呼吸，比追求單次分數更有幫助。"
          }
        }
      }
    },
    "analysis.suggestions.naturalSpeech.subtitle": {
      "comment": "Positive reinforcement shown when the naturalness score is already acceptable.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بدت الطبيعية جيدة هذه المرة؛ حافظ على الاسترخاء واستمر في إلقاء متواصل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přirozenost je tentokrát dobrá; udržte uvolněný a plynulý projev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturligheden var god denne gang; hold dig afslappet og bevar en sammenhængende fremføring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Natürlichkeit war diesmal gut. Bleib entspannt und sprich weiter flüssig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η φυσικότητα ήταν καλή αυτή τη φορά· μείνετε χαλαροί και κρατήστε την ομιλία σας συνεχή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturalness looked good this time; stay relaxed and keep your delivery connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La naturalidad se vio bien esta vez; mantén un habla relajada y fluida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Luonnollisuus oli tällä kertaa hyvällä tasolla – pysy rennona ja pidä ilmaisu sujuvana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le naturel est bon cette fois ; restez détendu et gardez un débit fluide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטבעיות נראית טוב הפעם; הישארו רגועים ושמרו על דיבור רציף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस बार स्वाभाविकता अच्छी रही; आराम से और लगातार बोलते रहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prirodnost je ovaj put dobra; zadrži opušten i povezan govor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A természetesség ezúttal jól sikerült; maradj laza, és tartsd folyamatosan a beszédet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kealamian kali ini bagus; tetap rileks dan jaga penyampaian tetap mengalir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa volta la naturalezza è buona: resta rilassato e mantieni un parlato scorrevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今回は自然度が良好です。リラックスして、滑らかにつながる話し方を続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이번 자연스러움은 좋았어요. 편안하게 이어지는 말투를 유지해 보세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kewajaran kelihatan baik kali ini; kekalkan gaya santai dan penyampaian yang bersambung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De natuurlijkheid was deze keer goed; blijf ontspannen en spreek vloeiend door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tym razem naturalność wypadła dobrze — zadbaj o swobodę i płynność wypowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A naturalidade foi boa desta vez; continue relaxado e com uma fala fluida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "С естественностью в этот раз всё хорошо — сохраняйте расслабленную и связную речь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naturligheten såg bra ut den här gången; håll talet avslappnat och sammanhängande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ครั้งนี้ความเป็นธรรมชาติอยู่ในเกณฑ์ดี รักษาความผ่อนคลายและพูดให้ต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kez doğallık iyiydi; rahat ve akıcı anlatımını koru."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Цього разу природність на рівні — говоріть розслаблено й зв’язно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lần này độ tự nhiên khá tốt; hãy giữ sự thư thái và nói liền mạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次自然度表现不错，保持放松和连贯的表达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這次自然度表現不錯，保持放鬆和連貫的表達。"
          }
        }
      }
    },
