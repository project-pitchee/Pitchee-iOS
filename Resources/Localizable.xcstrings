    "practice.trend.bestScope" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الأفضل يوميًا هو أعلى قيمة لهذا المؤشر. قد ترفع المحاولات الإضافية هذه القيمة دون تغير في القدرة، لذا لا تثبت التقدم وحدها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denní maximum je nejvyšší hodnota tohoto ukazatele. Více pokusů ji může zvýšit bez změny schopností, proto sama o sobě nedokazuje pokrok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dagens højeste er den højeste værdi for denne måling. Flere forsøg kan øge den uden ændring i evne, så den dokumenterer ikke fremskridt alene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Tagesbestwert ist der höchste Wert dieser Kennzahl. Mehr Versuche können ihn ohne Veränderung der Fähigkeit erhöhen. Er allein belegt daher keinen Fortschritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το ημερήσιο μέγιστο είναι η υψηλότερη τιμή αυτού του δείκτη. Περισσότερες προσπάθειες μπορεί να το αυξήσουν χωρίς αλλαγή ικανότητας, οπότε δεν τεκμηριώνει πρόοδο από μόνο του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily best is the highest value for this metric. More attempts can raise it without a change in ability, so it does not establish progress by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El máximo diario es el valor más alto de esta métrica. Hacer más intentos puede aumentarlo sin que cambie tu habilidad, por lo que por sí solo no demuestra progreso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Päivän korkein on tämän mittarin suurin arvo. Useammat yritykset voivat nostaa sitä ilman kyvyn muutosta, joten se ei yksin osoita edistymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le meilleur résultat quotidien est la valeur la plus élevée de cet indicateur. Multiplier les essais peut l’augmenter sans changement de capacité ; il ne prouve donc pas à lui seul un progrès."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הטוב ביותר ביום הוא הערך הגבוה ביותר במדד זה. ניסיונות נוספים יכולים להעלות אותו ללא שינוי ביכולת, ולכן הוא לבדו אינו מעיד על התקדמות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दिन का सर्वश्रेष्ठ इस मेट्रिक का सबसे अधिक मान है। क्षमता बदले बिना अधिक प्रयास इसे बढ़ा सकते हैं, इसलिए यह अकेले प्रगति साबित नहीं करता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dnevni maksimum najviša je vrijednost ovog pokazatelja. Više pokušaja može ga povisiti bez promjene sposobnosti, pa sam po sebi ne dokazuje napredak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A napi maximum ennek a mutatónak a legmagasabb értéke. Több próbálkozás a képesség változása nélkül is növelheti, ezért önmagában nem bizonyít fejlődést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terbaik harian adalah nilai tertinggi untuk metrik ini. Lebih banyak percobaan dapat meningkatkannya tanpa perubahan kemampuan, sehingga nilai ini saja tidak membuktikan kemajuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il massimo giornaliero è il valore più alto per questa metrica. Più tentativi possono alzarlo senza un cambiamento di abilità, quindi da solo non dimostra progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "日別の最高値は、その日のこの指標の最大値です。能力に変化がなくても、試行回数が増えると高くなることがあるため、これだけでは上達したとは判断できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "일별 최고값은 해당 날짜의 이 지표에서 가장 높은 값이에요. 능력이 달라지지 않아도 시도 횟수가 늘면 높아질 수 있으므로 이것만으로 발전을 판단할 수는 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terbaik harian ialah nilai tertinggi bagi metrik ini. Lebih banyak percubaan boleh meningkatkannya tanpa perubahan keupayaan, jadi nilai ini sahaja tidak membuktikan kemajuan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het dagmaximum is de hoogste waarde voor deze meetwaarde. Meer pogingen kunnen die verhogen zonder dat je vaardigheid verandert; op zichzelf toont dit dus geen vooruitgang aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Najlepszy wynik dnia to najwyższa wartość tego wskaźnika. Więcej prób może ją podnieść bez zmiany umiejętności, więc sama nie dowodzi postępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O máximo diário é o maior valor desta métrica. Mais tentativas podem aumentá-lo sem mudança de habilidade, então ele não comprova progresso por si só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Лучшее за день — наибольшее значение этого показателя. Большее число попыток может повысить его без изменения навыка, поэтому само по себе оно не доказывает прогресс."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dagens högsta är det högsta värdet för det här mätvärdet. Fler försök kan höja det utan att förmågan förändras, så det visar inte framsteg i sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ดีที่สุดรายวันคือค่าสูงสุดของตัวชี้วัดนี้ การลองมากขึ้นอาจทำให้ค่าสูงขึ้นโดยความสามารถไม่เปลี่ยน จึงไม่ยืนยันพัฒนาการได้ด้วยตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Günün en iyisi, bu ölçümün en yüksek değeridir. Daha çok deneme, beceri değişmeden bu değeri yükseltebilir; bu yüzden tek başına ilerlemeyi göstermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Найкраще за день — найбільше значення цього показника. Більша кількість спроб може підвищити його без зміни навички, тому саме по собі воно не доводить прогресу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tốt nhất trong ngày là giá trị cao nhất của chỉ số này. Thử nhiều lần hơn có thể làm giá trị tăng dù khả năng không thay đổi, nên riêng giá trị này không xác lập tiến bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳表现是当日该指标的最高值；录音次数增加也可能使它升高，不能单独作为进步依据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日最高值是這個指標當天的最高數值。即使能力沒有改變，增加嘗試次數也可能提高它，因此不能單靠這個數值判定進步。"
          }
        }
      }
    },
