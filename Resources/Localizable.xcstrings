        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu puan, feminen eğilimli ses hedefini izler ve analiz motoruyla aynı, doğallığı dikkate alan referansı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
