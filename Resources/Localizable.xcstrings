    "recording.error.fileMissing": {
      "comment": "Recording phase: capture stopped without producing a file.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم يتم إنشاء ملف التسجيل. حاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
