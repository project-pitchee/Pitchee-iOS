    "scoring.rules.passBoost.description": {
      "comment": "Guidance for the boost rule; celebrates consistent, natural delivery.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تجاوزت المقاييس الثلاثة حدودها، لذا يرفع النظام الأداء الثابت والطبيعي إلى أعلى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všechny tři metriky překročily prahy, a systém proto stabilní a přirozený projev posune výš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle tre målinger er over grænseværdierne, så systemet løfter en stabil og naturlig indsats opad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle drei Werte lagen über ihren Schwellen, daher wird eine gleichmäßige, natürliche Leistung aufgewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Και οι τρεις μετρήσεις πέρασαν τα όρια, οπότε το σύστημα αυξάνει μια σταθερή και φυσική απόδοση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All three metrics passed their thresholds, so the system pushes a steady, natural performance upward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las tres métricas superaron sus umbrales, así que el sistema impulsa hacia arriba un desempeño estable y natural."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaikki kolme mittaria ylittivät raja-arvonsa, joten järjestelmä nostaa tasaista ja luonnollista suoritusta ylöspäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les trois indicateurs dépassent leur seuil : le système valorise une performance régulière et naturelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כל שלושת המדדים עברו את הסף, ולכן המערכת מעלה ביצוע יציב וטבעי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तीनों मान अपनी सीमा पार कर गए हैं, इसलिए स्थिर और स्वाभाविक प्रदर्शन को ऊपर उठाया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sva tri pokazatelja prešla su zadane granice pa sustav dodatno podiže ujednačenu i prirodnu izvedbu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mindhárom mutató átlépte a küszöbértéket, ezért a rendszer felfelé módosítja a stabil, természetes teljesítményt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ketiga metrik melewati ambangnya, sehingga sistem mendorong performa yang stabil dan alami ke atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutte e tre le metriche hanno superato la soglia: il sistema valorizza una prestazione stabile e naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "3つの指標がすべて基準を超えているため、安定した自然な結果をさらに引き上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세 지표 모두 기준을 넘어서, 안정적이고 자연스러운 발화를 시스템이 더 높게 평가해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ketiga-tiga metrik melepasi had masing-masing, jadi sistem menaikkan pencapaian yang stabil dan semula jadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle drie de waarden halen hun drempel; daarom wordt een stabiele, natuurlijke prestatie omhooggetrokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystkie trzy wskaźniki przekroczyły progi, więc stabilna i naturalna wypowiedź dostaje podbicie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As três métricas passaram dos limites, então o sistema eleva um desempenho firme e natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все три показателя прошли порог, поэтому система повышает оценку за ровную и естественную подачу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alla tre måtten klarar tröskelvärdena, så ett stabilt och naturligt resultat lyfts uppåt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตัวชี้วัดทั้งสามผ่านเกณฑ์ ระบบจึงเพิ่มคะแนนให้กับการพูดที่สม่ำเสมอและเป็นธรรมชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Üç ölçüm de eşiği geçti; uygulama istikrarlı ve doğal bir performansı yukarı taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Усі три показники перевищили пороги, тож система підвищує оцінку за стабільну й природну подачу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cả ba chỉ số đều đạt ngưỡng, nên hệ thống sẽ nâng điểm cho phần thể hiện ổn định và tự nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三项指标都已经过线，系统会把稳定、自然的表现向上提升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "三項指標都已達標，系統會把穩定、自然的表現向上提升。"
          }
        }
      }
    },
    "scoring.rules.passBoost.result": {
      "comment": "Result explanation for the boost rule. 'promoted' and 'Base' are formula variable names and stay untranslated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الحد الأقصى للنتيجة الإجمالية 100؛ وإذا كانت promoted أعلى من Base فتُستخدم promoted."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Celkové skóre je omezeno na 100; pokud je promoted vyšší než Base, použije se promoted."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den samlede score er begrænset til 100; hvis promoted er højere end Base, bruges promoted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Gesamtbewertung ist auf maximal 100 begrenzt; ist promoted höher als Base, wird promoted verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η συνολική βαθμολογία περιορίζεται στο 100· αν το promoted είναι υψηλότερο από το Base, χρησιμοποιείται το promoted."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The overall score is capped at 100; if promoted is higher than Base, promoted is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El puntaje general se limita a 100; si promoted es mayor que Base, se usa promoted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kokonaispisteet ovat enintään 100; jos promoted on suurempi kuin Base, käytetään promoted-arvoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le score global est plafonné à 100 ; si promoted est supérieur à Base, c’est promoted qui est retenu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הציון הכולל מוגבל ל-100; אם promoted גבוה מ-Base, משתמשים ב-promoted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कुल स्कोर अधिकतम 100 तक सीमित रहता है; अगर promoted, Base से ज़्यादा है, तो promoted इस्तेमाल होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukupna je ocjena ograničena na 100; ako je promoted viši od Base, koristi se promoted."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Az összpontszám legfeljebb 100 lehet; ha a promoted magasabb, mint a Base, akkor a promoted értékét használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skor keseluruhan dibatasi maksimal 100; jika promoted lebih tinggi daripada Base, nilai promoted yang dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il punteggio complessivo non può superare 100; se promoted è più alto di Base, viene usato promoted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "総合スコアの上限は 100 です。promoted が Base より高い場合は promoted を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "종합 점수는 최대 100점이고, promoted가 Base보다 높으면 promoted를 사용해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skor keseluruhan dihadkan kepada 100; jika promoted lebih tinggi daripada Base, promoted digunakan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De totaalscore is maximaal 100; is promoted hoger dan Base, dan wordt promoted gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wynik ogólny jest ograniczony do 100; jeśli wartość promoted jest wyższa niż Base, przyjmowana jest wartość promoted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A pontuação geral tem teto de 100; se promoted for maior que Base, usa promoted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Общая оценка — не выше 100; если promoted больше Base, используется promoted."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Totalpoängen har ett tak på 100; om promoted är högre än Base används promoted."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คะแนนรวมถูกจำกัดไว้ที่ 100 หาก promoted สูงกว่า Base จะใช้ค่า promoted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Genel puan en fazla 100 olur; promoted Base'den yüksekse promoted kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загальна оцінка обмежена на рівні 100; якщо promoted вище за Base, використовується promoted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Điểm tổng hợp tối đa là 100; nếu promoted cao hơn Base thì dùng promoted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "综合分最高为 100；如果 promoted 高于 Base，就采用 promoted。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "綜合分最高為 100；如果 promoted 高於 Base，就採用 promoted。"
          }
        }
      }
    },
