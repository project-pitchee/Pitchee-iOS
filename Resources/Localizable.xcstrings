    "scoring.rules.lowF0StylizedCap.description" : {
      "comment" : "Guidance for the lowest-scoring rule; gentle, practical advice.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذه المرة تحتاج طبقة الصوت والطبيعية إلى تحسين. تمهّل قليلًا وأكمل جملك بشكل طبيعي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tentokrát je potřeba věnovat pozornost výšce hlasu i přirozenosti. Trochu zpomalte a dokončete věty přirozeně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne gang kræver både tonehøjde og naturlighed opmærksomhed. Sæt tempoet lidt ned, og afslut dine sætninger naturligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diesmal brauchen Tonhöhe und Natürlichkeit beide Aufmerksamkeit. Sprich etwas langsamer und beende deine Sätze natürlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή τη φορά χρειάζονται προσοχή και το ύψος και η φυσικότητα. Μιλήστε λίγο πιο αργά και ολοκληρώστε τις προτάσεις σας φυσικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This time both pitch and naturalness need attention. Slow down a little and finish your sentences naturally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta vez hay que atender tanto el tono como la naturalidad. Habla un poco más despacio y termina las frases con naturalidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tällä kertaa sekä sävelkorkeus että luonnollisuus kaipaavat huomiota. Hidasta hieman ja sano lauseet loppuun luonnollisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette fois, la hauteur et le naturel demandent tous deux votre attention. Ralentissez un peu et terminez vos phrases naturellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הפעם גם הטון וגם הטבעיות צריכים תשומת לב. האטו קצת וסיימו את המשפטים באופן טבעי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस बार पिच और स्वाभाविकता दोनों पर ध्यान देना है। थोड़ा धीरे बोलें और वाक्यों को स्वाभाविक ढंग से पूरा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ovaj put treba poraditi i na visini i na prirodnosti. Uspori malo i dovrši rečenice prirodno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezúttal a hangmagasságra és a természetességre is figyelni kell. Beszélj egy kicsit lassabban, és fejezd be a mondataidat természetesen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kali ini nada dan kealamian sama-sama perlu diperhatikan. Sedikit perlambat tempo dan selesaikan kalimat dengan alami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa volta servono miglioramenti sia sul tono sia sulla naturalezza. Rallenta un po' e completa le frasi con naturalezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今回は音高と自然度の両方に取り組みましょう。少しゆっくり話し、文を自然に言い切ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이번에는 음높이와 자연스러움을 모두 챙겨야 해요. 조금 천천히, 문장을 자연스럽게 끝까지 말해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kali ini pic dan kewajaran kedua-duanya perlu diberi perhatian. Perlahankan sedikit dan habiskan ayat anda dengan semula jadi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deze keer vragen zowel de toonhoogte als de natuurlijkheid aandacht. Doe het iets rustiger aan en maak je zinnen natuurlijk af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tym razem trzeba zadbać i o wysokość głosu, i o naturalność. Zwolnij nieco i dokończ zdania w naturalny sposób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nesta gravação, altura e naturalidade precisam de atenção. Fale um pouco mais devagar e complete as frases com naturalidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В этот раз нужно поработать и над высотой тона, и над естественностью. Замедлитесь немного и договаривайте фразы до конца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den här gången behöver både tonhöjd och naturlighet uppmärksamhet. Sänk tempot lite och avsluta meningarna naturligt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ครั้งนี้ทั้งระดับเสียงและความเป็นธรรมชาติยังต้องฝึกเพิ่ม ลองพูดช้าลงเล็กน้อยและพูดประโยคให้จบอย่างเป็นธรรมชาติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu kez hem perde hem doğallık ilgi istiyor. Biraz yavaşla ve cümleleri doğal bir şekilde tamamla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Цього разу варто попрацювати і над висотою тону, і над природністю. Говоріть трохи повільніше й природно завершуйте речення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lần này cả cao độ và độ tự nhiên đều cần cải thiện. Hãy nói chậm lại một chút và nói trọn câu một cách tự nhiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次音高和自然度都需要照顾。先放慢一点，完整自然地说完句子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這次音高和自然度都需要照顧。先放慢一點，完整自然地說完句子。"
          }
        }
      }
    },
