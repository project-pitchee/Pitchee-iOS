          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Billedet kunne ikke oprettes. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bild konnte nicht erstellt werden. Bitte versuch es später erneut."
