    "practice.repeat.replacesB" : {
      "comment" : "Guided practice and comparison. Keep goals, model outputs, recording checks, and personal listening feedback distinct.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تستبدل إعادة التسجيل صوت B وتُبقي A. تظل المؤشرات المحفوظة في السجل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Další nahrávání nahradí zvuk B a zachová A. Uložené ukazatele zůstanou v historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En ny optagelse erstatter lyden i B og bevarer A. Gemte målinger bliver i historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine erneute Aufnahme ersetzt das Audio von B und behält A. Gespeicherte Kennzahlen bleiben im Verlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η νέα εγγραφή αντικαθιστά τον ήχο της B και διατηρεί την A. Οι αποθηκευμένοι δείκτες παραμένουν στο ιστορικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording again replaces B’s audio and keeps A. Saved metrics remain in history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volver a grabar sustituye el audio de B y conserva A. Las métricas guardadas permanecen en el historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uusi tallennus korvaa B:n äänen ja säilyttää A:n. Tallennetut mittarit säilyvät historiassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Réenregistrer remplace l’audio de B et conserve A. Les indicateurs sauvegardés restent dans l’historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הקלטה חוזרת מחליפה את השמע של B ושומרת על A. המדדים השמורים נשארים בהיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फिर रिकॉर्ड करने से B का ऑडियो बदलता है और A बना रहता है। सेव किए मेट्रिक इतिहास में रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ponovno snimanje zamjenjuje zvuk snimke B i zadržava A. Spremljeni pokazatelji ostaju u povijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az új felvétel lecseréli B hangját, és megtartja A-t. A mentett mutatók megmaradnak az előzményekben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merekam lagi mengganti audio B dan mempertahankan A. Metrik tersimpan tetap ada dalam riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una nuova registrazione sostituisce l'audio di B e mantiene A. Le metriche salvate restano nella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "もう一度録音するとBの音声が置き換わり、Aは残ります。保存済みの指標は履歴に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다시 녹음하면 B의 오디오가 교체되고 A는 유지돼요. 저장된 지표는 기록에 남아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merakam semula menggantikan audio B dan mengekalkan A. Metrik yang disimpan kekal dalam sejarah."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opnieuw opnemen vervangt de audio van B en behoudt A. Opgeslagen meetwaarden blijven in de geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
