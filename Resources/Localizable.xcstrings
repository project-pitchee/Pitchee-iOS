            "value": "Zachovejte podobnou délku nahrávky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hold en lignende optagelseslængde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bleib bei einer ähnlichen Aufnahmelänge"
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Κρατήστε παρόμοια διάρκεια εγγραφής"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a similar recording length"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén una duración similar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pidä tallennus samanpituisena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez une durée d’enregistrement similaire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שמרו על אורך הקלטה דומה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकॉर्डिंग की अवधि एक जैसी रखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zadrži sličnu duljinu snimke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarts hasonló felvételhosszt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
