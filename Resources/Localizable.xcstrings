    "recording.error.microphoneUnavailable": {
      "comment": "Recording phase: the audio capture session failed to start.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر بدء التسجيل. تحقق من توفر الميكروفون."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
