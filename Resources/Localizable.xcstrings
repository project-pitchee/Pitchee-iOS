            "value" : "Úroveň nahrávky je nízká. Přibližte se trochu k mikrofonu a nahrajte znovu s pohodlnou hlasitostí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Optageniveauet er lavt. Flyt dig lidt tættere på mikrofonen, og optag igen med en behagelig lydstyrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Aufnahmepegel ist niedrig. Gehe etwas näher ans Mikrofon und nimm erneut mit angenehmer Lautstärke auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η στάθμη εγγραφής είναι χαμηλή. Πλησιάστε λίγο το μικρόφωνο και καταγράψτε ξανά με άνετη ένταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording level is low. Move a little closer to the microphone and record again at a comfortable volume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El nivel de grabación es bajo. Acércate un poco al micrófono y vuelve a grabar a un volumen cómodo."
