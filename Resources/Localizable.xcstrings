        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הטבעיות נראית טוב הפעם; הישארו רגועים ושמרו על דיבור רציף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस बार स्वाभाविकता अच्छी रही; आराम से और लगातार बोलते रहें।"
