    "scoring.rules.highF0StylizedCap.description" : {
      "comment" : "Coaching guidance for the high-pitch/low-naturalness rule; discourages forced pitch raising.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "طبقة صوتك مرتفعة بالفعل، لكن الطبيعية لم تواكبها. في المرة القادمة أرخِ نبرتك أولًا — لا حاجة إلى رفع طبقة الصوت أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Výška hlasu už je nahoře, ale přirozenost na to zatím nestačí. Příště nejdřív uvolněte tón — není třeba výšku hlasu dál tlačit nahoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonehøjden er allerede oppe, men naturligheden er ikke fulgt med. Slap af i tonen næste gang — du behøver ikke at presse tonehøjden op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Tonhöhe ist schon oben, aber die Natürlichkeit zieht noch nicht mit. Entspann beim nächsten Mal zuerst deinen Ton – du musst die Tonhöhe nicht weiter nach oben treiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το ύψος έχει ήδη ανέβει, αλλά η φυσικότητα δεν το έχει φτάσει. Την επόμενη φορά χαλαρώστε πρώτα τον τόνο — δεν χρειάζεται να ανεβάσετε κι άλλο το ύψος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pitch is already up, but naturalness hasn't caught up. Next time relax your tone first — there's no need to push your pitch higher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu tono ya subió, pero la naturalidad aún no lo acompaña. La próxima vez relájate al hablar; no hace falta forzar un tono más alto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sävelkorkeus on jo koholla, mutta luonnollisuus ei ole pysynyt mukana. Rentouta seuraavalla kerralla sävy ensin – sävelkorkeutta ei tarvitse nostaa väkisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre hauteur est déjà élevée, mais le naturel n’a pas encore suivi. La prochaine fois, détendez d’abord votre ton — inutile de monter la hauteur davantage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הטון כבר גבוה, אבל הטבעיות עוד לא מתאימה לו. בפעם הבאה התחילו מטון רגוע — אין צורך להעלות את הטון בכוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिच तो ऊँची हो गई है, पर स्वाभाविकता अभी पीछे है। अगली बार पहले लहजा ढीला रखें — पिच को ज़ोर से ऊँचा करने की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Visina glasa već je visoka, ali prirodnost još ne prati. Sljedeći put najprije opusti ton — nema potrebe dodatno dizati visinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A hangmagasságod már magas, de a természetesség még nem tartott lépést. Legközelebb először lazítsd el a hangvételt — nem kell feljebb tolni a hangmagasságot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada Anda sudah tinggi, tetapi kealamiannya belum menyusul. Lain kali rilekskan dulu nada bicara Anda — tidak perlu memaksa nada lebih tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tono è già alto, ma la naturalezza non è ancora al livello. La prossima volta rilassa prima il tono: non serve alzarlo ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音高はすでに高めですが、自然度が追いついていません。次はまず語調をゆるめて、音高を無理に上げる必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음높이는 이미 올라갔지만 자연스러움이 따라오지 못했어요. 다음에는 말투부터 편안하게 하고, 음을 억지로 높이지 마세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pic anda sudah tinggi, tetapi kewajaran belum menyusul. Lain kali rilekskan nada anda dahulu — tidak perlu memaksa pic lebih tinggi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je toonhoogte is al hoog, maar de natuurlijkheid blijft achter. Ontspan de volgende keer eerst je toon — je hoeft je toonhoogte niet verder op te drijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysokość głosu jest już podniesiona, ale naturalność jeszcze nie nadąża. Następnym razem najpierw rozluźnij wypowiedź — nie ma potrzeby sztucznie podnosić tonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua altura já está elevada, mas a naturalidade ainda não acompanhou. Na próxima vez, relaxe o tom primeiro — não precisa forçar uma altura maior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Высота тона уже выше, а естественность пока не догнала. В следующий раз сначала расслабьте тон — специально повышать его не нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tonhöjden är redan uppe, men naturligheten har inte hängt med. Slappna av i tonen nästa gång – det finns ingen anledning att pressa upp tonhöjden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ระดับเสียงสูงอยู่แล้ว แต่ความเป็นธรรมชาติยังตามไม่ทัน ครั้งต่อไปลองผ่อนคลายน้ำเสียงก่อน ไม่จำเป็นต้องฝืนเพิ่มระดับเสียงให้สูงขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Perden yükseldi ama doğallık henüz yetişmedi. Bir dahaki sefere önce tonunu gevşet; perdeyi bilinçli olarak yükseltmene gerek yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Висота тону вже зросла, але природність ще не наздогнала. Наступного разу спершу розслабте тон — підвищувати його штучно не потрібно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cao độ đã cao lên nhưng độ tự nhiên chưa theo kịp. Lần sau hãy thư giãn giọng nói trước — không cần cố nâng cao độ thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高已经上去了，但自然度还没跟上。下一次先放松语气，不必刻意抬高音调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音高已經上去了，但自然度還沒跟上。下一次先放鬆語氣，不必刻意抬高音調。"
          }
        }
      }
    },
    "scoring.rules.highF0StylizedCap.result" : {
