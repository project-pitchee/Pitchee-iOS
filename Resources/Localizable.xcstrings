    "analysis.progress.privacyNote": {
      "comment": "Privacy assurance that audio and analysis never leave the device. Very short; shown at footnote size.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صوتك يبقى على جهازك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hlas zůstává ve vašem zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stemmen bliver på din enhed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Stimme bleibt auf deinem Gerät"
          }
