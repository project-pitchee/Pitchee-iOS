    "analysis.resources.naturalnessTraining.description": {
      "comment": "Body text shown in the resource detail sheet; invites the user to record again after practising.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جرّب تمرينًا قصيرًا للوصول إلى نبرة أكثر استرخاءً، ثم عُد إلى شاشة التسجيل وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Krátké cvičení vám pomůže najít uvolněnější tón. Pak se vraťte k nahrávání a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brug en kort øvelse til at finde en mere afslappet tone, og prøv igen på optagelsesskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finde mit einer kurzen Übung einen entspannteren Ton und versuch es dann auf der Aufnahmeseite erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Με μια σύντομη άσκηση θα βρείτε πιο χαλαρό τόνο· μετά επιστρέψτε στην οθόνη εγγραφής και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a short exercise to find a more relaxed tone, then go back to the recording screen and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz un ejercicio corto para encontrar un tono más relajado y vuelve a Grabación para intentarlo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Etsi lyhyen harjoituksen avulla rennompi sävy ja palaa tallennusnäkymään kokeilemaan uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faites un court exercice pour trouver un ton plus détendu, puis revenez à l’écran d’enregistrement et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תרגיל קצר יעזור לכם למצוא טון רגוע יותר; אחר כך חזרו למסך ההקלטה ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "छोटे अभ्यास से ज़्यादा आरामदेह लहजा पाएँ, फिर रिकॉर्डिंग स्क्रीन पर जाकर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kratkom vježbom pronađi opušteniji ton, pa se vrati na snimanje i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Egy rövid gyakorlattal lazább hangvételt találhatsz, aztán térj vissza a felvételi képernyőre, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lakukan latihan singkat untuk menemukan nada yang lebih santai, lalu kembali ke layar Rekam dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con un breve esercizio trova un tono più rilassato, poi torna alla schermata di registrazione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "短い練習でリラックスした語調を見つけてから、録音画面に戻ってもう一度試してみましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "짧은 연습으로 더 편안한 말투를 찾고, 녹음 화면에서 다시 시도해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gunakan latihan pendek untuk mencari nada yang lebih santai, kemudian kembali ke skrin rakaman dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gebruik een korte oefening om een ontspannener toon te vinden en ga daarna terug naar Opnemen om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wykonaj krótkie ćwiczenie, aby znaleźć swobodniejszy ton, i wróć do ekranu nagrywania, aby spróbować jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faça um exercício curto para encontrar um tom mais relaxado e volte à tela de gravação para tentar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Короткое упражнение поможет найти более расслабленный тон. Затем вернитесь на экран записи и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gör en kort övning för att hitta ett mer avslappnat tonläge, och försök sedan igen på inspelningsskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลองทำแบบฝึกหัดสั้น ๆ เพื่อหาน้ำเสียงที่ผ่อนคลายขึ้น แล้วกลับไปที่หน้าบันทึกเสียงเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kısa bir alıştırmayla daha rahat bir ton bul, sonra kayıt ekranına dönüp tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спробуйте коротку вправу, щоб знайти розслабленіший тон, а потім поверніться до екрана запису й спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hãy tập một bài ngắn để tìm giọng thư thái hơn, rồi quay lại màn hình ghi âm và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一段短练习找到更放松的语气，再回到录音页试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用一段短練習找到更放鬆的語氣，再回到錄音頁試一次。"
          }
        }
      }
    },
