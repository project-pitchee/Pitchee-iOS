          "stringUnit": {
            "state": "needs_review",
            "value": "Kayıt başlatılamıyor. Mikrofonun kullanılabilir olduğunu kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося почати запис. Перевірте, чи доступний мікрофон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể bắt đầu ghi âm. Hãy kiểm tra xem micrô có khả dụng không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始录音，请检查麦克风是否可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法開始錄音，請檢查麥克風是否可用。"
          }
        }
      }
    },
    "recording.error.realtimePitchUnavailable": {
      "comment": "Non-fatal recording-phase warning: realtime F0 failed but audio is still captured; delivered through the shared errorMessage channel.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "طبقة الصوت المباشرة غير متاحة مؤقتًا. سيستمر التسجيل وستحصل على تحليل كامل عند الإيقاف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Živá výška hlasu je dočasně nedostupná. Nahrávání pokračuje a po zastavení proběhne kompletní analýza."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live-tonehøjde er midlertidigt utilgængelig. Optagelsen fortsætter, og du får en fuld analyse, når du stopper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Tonhöhe in Echtzeit ist vorübergehend nicht verfügbar. Die Aufnahme läuft weiter; beim Stoppen erhältst du eine vollständige Analyse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το ύψος σε πραγματικό χρόνο δεν είναι προσωρινά διαθέσιμο. Η εγγραφή συνεχίζεται και θα λάβετε πλήρη ανάλυση όταν σταματήσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live pitch is temporarily unavailable. Recording will continue and you'll get a full analysis when you stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El tono en tiempo real no está disponible por ahora. La grabación continuará y obtendrás un análisis completo al detenerla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reaaliaikainen sävelkorkeus ei ole juuri nyt käytettävissä. Tallennus jatkuu, ja saat täyden analyysin, kun lopetat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La hauteur en direct est momentanément indisponible. L’enregistrement se poursuit et une analyse complète sera lancée à l’arrêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הטון בזמן אמת אינו זמין כרגע. ההקלטה תימשך, ובסיומה תקבלו ניתוח מלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लाइव पिच अभी उपलब्ध नहीं है। रिकॉर्डिंग जारी रहेगी और रोकने पर पूरा विश्लेषण मिलेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prikaz visine glasa u stvarnom vremenu trenutačno nije dostupan. Snimanje se nastavlja, a potpunu analizu dobivaš nakon zaustavljanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A valós idejű hangmagasság átmenetileg nem elérhető. A felvétel tovább folytatódik, és leállításkor teljes elemzést kapsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nada waktu nyata sementara tidak tersedia. Perekaman tetap berjalan, dan analisis lengkap akan tersedia saat Anda berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tono in tempo reale non è disponibile al momento. La registrazione continua e al termine otterrai un'analisi completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リアルタイムの音高は一時的に利用できません。録音は続き、停止すると全体の分析結果が得られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "실시간 음높이를 잠시 사용할 수 없어요. 녹음은 계속되고, 중지하면 전체 분석 결과를 받아볼 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pic langsung tidak tersedia buat masa ini. Rakaman akan diteruskan dan analisis penuh akan dibuat apabila anda berhenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live toonhoogte is tijdelijk niet beschikbaar. De opname gaat door en je krijgt een volledige analyse zodra je stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wysokość głosu na żywo jest chwilowo niedostępna. Nagrywanie będzie kontynuowane, a po zatrzymaniu otrzymasz pełną analizę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A altura ao vivo está indisponível no momento. A gravação continua e você recebe a análise completa ao parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Высота тона в реальном времени временно недоступна. Запись продолжится, а после остановки вы получите полный анализ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Live-tonhöjden är tillfälligt otillgänglig. Inspelningen fortsätter och du får en fullständig analys när du stoppar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ระดับเสียงแบบเรียลไทม์ใช้งานไม่ได้ชั่วคราว การบันทึกจะดำเนินต่อไป และคุณจะได้รับการวิเคราะห์เต็มรูปแบบเมื่อหยุดบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Canlı perde şu anda kullanılamıyor. Kayıt devam ediyor; durdurduğunda tam analiz yapılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Висота тону в реальному часі тимчасово недоступна. Запис триватиме, а після зупинки ви отримаєте повний аналіз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cao độ trực tiếp tạm thời không khả dụng. Quá trình ghi âm vẫn tiếp tục và bạn sẽ nhận được phân tích đầy đủ khi dừng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时音高暂时不可用，录音仍在继续，结束后将进行完整分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即時音高暫時無法使用，錄音仍在繼續，結束後將進行完整分析。"
          }
        }
      }
    },
    "recording.error.saveFailed": {
      "comment": "Recording phase: writing the WAV file failed, usually because storage is full.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر حفظ التسجيل. تحقق من مساحة التخزين في جهازك وحاول مجددًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nahrávku se nepodařilo uložit. Zkontrolujte úložiště zařízení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Optagelsen kunne ikke gemmes. Tjek enhedens lagerplads, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Aufnahme konnte nicht gespeichert werden. Prüfe den Speicherplatz deines Geräts und versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η ηχογράφηση δεν ήταν δυνατό να αποθηκευτεί. Ελέγξτε τον χώρο αποθήκευσης της συσκευής και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording couldn't be saved. Check your device's storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo guardar la grabación. Revisa el almacenamiento del dispositivo y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Äänitettä ei voitu tallentaa. Tarkista laitteen tallennustila ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’enregistrement n’a pas pu être sauvegardé. Vérifiez l’espace de stockage de l’appareil et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ההקלטה לא נשמרה. בדקו את שטח האחסון במכשיר ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकॉर्डिंग सेव नहीं हो सकी। डिवाइस की स्टोरेज जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snimku nije bilo moguće spremiti. Provjeri prostor na uređaju i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A felvételt nem sikerült elmenteni. Ellenőrizd a készülék tárhelyét, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rekaman tidak dapat disimpan. Periksa ruang penyimpanan perangkat, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile salvare la registrazione. Controlla lo spazio sul dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "録音を保存できませんでした。端末の空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "녹음을 저장하지 못했어요. 기기 저장 공간을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rakaman tidak dapat disimpan. Semak storan peranti anda dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De opname kon niet worden opgeslagen. Controleer de opslagruimte op je apparaat en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się zapisać nagrania. Sprawdź pamięć urządzenia i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível salvar a gravação. Verifique o espaço de armazenamento do dispositivo e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось сохранить запись. Проверьте свободное место на устройстве и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inspelningen kunde inte sparas. Kontrollera enhetens lagringsutrymme och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "บันทึกไฟล์เสียงไม่สำเร็จ ตรวจสอบพื้นที่จัดเก็บของอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kayıt kaydedilemedi. Cihazındaki depolama alanını kontrol edip tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не вдалося зберегти запис. Перевірте вільне місце на пристрої та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không lưu được bản ghi âm. Hãy kiểm tra dung lượng thiết bị rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音未能保存，请检查设备存储空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "錄音未能儲存，請檢查裝置儲存空間後重試。"
          }
        }
      }
    },
    "recording.error.startFailed": {
      "comment": "Recording phase: generic start failure for errors that are neither core nor capture errors.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر بدء التسجيل. حاول مجددًا لاحقًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nahrávání nelze spustit. Zkuste to prosím znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan ikke starte optagelsen. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Aufnahme kann nicht gestartet werden. Bitte versuch es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δεν είναι δυνατή η έναρξη της εγγραφής. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't start recording. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede comenzar la grabación. Vuelve a intentarlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tallennusta ei voi aloittaa. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de démarrer l’enregistrement. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן להתחיל הקלטה. נסו שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रिकॉर्डिंग शुरू नहीं हो सकी। थोड़ी देर बाद कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snimanje se ne može pokrenuti. Pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nem sikerült elindítani a felvételt. Próbáld újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat mulai merekam. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile avviare la registrazione. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "録音を開始できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "녹음을 시작할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rakaman tidak dapat dimulakan. Sila cuba lagi nanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan de opname niet starten. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można rozpocząć nagrywania. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
